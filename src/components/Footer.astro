---
import Logo from './Logo.astro';
import { translate } from '../i18n/dictionary';
import type { Lang } from '../i18n/utils';

interface Props {
  lang?: Lang;
}
const { lang = 'en' } = Astro.props;
const t = (key: string) => translate(lang, key);
const year = new Date().getFullYear();
const href = (path: string) => (lang === 'en' ? path : `/${lang}${path}`);
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <!-- Brand -->
      <div class="footer-logo-area">
        <a href={href('/')} class="footer-logo-link" aria-label="Panorama Research Institute" data-no-translate>
          <Logo variant="light" size="sm" />
        </a>
        <div class="footer-brand-copy">
          <div class="footer-site-name">PANORAMA RESEARCH INSTITUTE</div>
          <div class="footer-sub-name">{t('A Division of Panorama Scholarly Group')}</div>
          <p class="footer-statement">{t('Panorama Research Institute is an internal research and academic development division of Panorama Scholarly Group and is not a separate legal entity.')}</p>
          <div style="margin-top:16px;">
            <a href="mailto:research@panorama-sg.com" class="footer-link" style="font-size:13px;">research@panorama-sg.com</a>
          </div>
        </div>
      </div>

      <!-- Institute -->
      <div>
        <div class="footer-col-title">{t('Institute')}</div>
        <a href={href('/about')} class="footer-link">{t('Overview')}</a>
        <a href={href('/about/mission-vision')} class="footer-link">{t('Mission & Vision')}</a>
        <a href={href('/framework')} class="footer-link">{t('Institute Framework')}</a>
        <a href={href('/framework/organizational-structure')} class="footer-link">{t('Organizational Structure')}</a>
        <a href={href('/contact')} class="footer-link">{t('Contact')}</a>
      </div>

      <!-- Governance -->
      <div>
        <div class="footer-col-title">{t('Governance')}</div>
        <a href={href('/charter')} class="footer-link">{t('Charter')}</a>
        <a href={href('/governance/research-ethics')} class="footer-link">{t('Research Ethics')}</a>
        <a href={href('/governance/conflict-of-interest')} class="footer-link">{t('Conflict of Interest')}</a>
        <a href={href('/governance/publication-report-policy')} class="footer-link">{t('Publication Policy')}</a>
        <a href={href('/governance/academic-independence')} class="footer-link">{t('Academic Independence')}</a>
      </div>

      <!-- Research -->
      <div>
        <div class="footer-col-title">{t('Research')}</div>
        <a href={href('/research-centers')} class="footer-link">{t('Research Centers')}</a>
        <a href={href('/projects')} class="footer-link">{t('Research Projects')}</a>
        <a href={href('/publications')} class="footer-link">{t('Publications')}</a>
        <a href={href('/events')} class="footer-link">{t('Events & Calls')}</a>
        <a href={href('/people')} class="footer-link">{t('People')}</a>
      </div>

      <!-- Platforms -->
      <div>
        <div class="footer-col-title">{t('Panorama Platforms')}</div>
        <a href="https://www.panorama-sg.com" class="footer-link" target="_blank" rel="noopener">{t('Panorama Scholarly Group')}</a>
        <a href="https://journals.panorama-sg.com" class="footer-link" target="_blank" rel="noopener">{t('Panorama Journals')}</a>
        <a href="https://books.panorama-sg.com" class="footer-link" target="_blank" rel="noopener">{t('Panorama Books')}</a>
        <a href="https://posi.panorama-sg.com" class="footer-link" target="_blank" rel="noopener">{t('POSI Database')}</a>
        <a href="https://profiles.panorama-sg.com" class="footer-link" target="_blank" rel="noopener">{t('Scholar Profiles')}</a>
      </div>
    </div>

    <div class="footer-bottom">
      <span>{t('© {year} Panorama Scholarly Group. All rights reserved.').replace('{year}', String(year))}</span>
      <span>
        <a href={href('/charter')} class="footer-link" style="display:inline;">{t('Charter')}</a>
        &nbsp;&middot;&nbsp;
        <a href={href('/governance/research-ethics')} class="footer-link" style="display:inline;">{t('Research Ethics')}</a>
        &nbsp;&middot;&nbsp;
        <a href={href('/contact')} class="footer-link" style="display:inline;">{t('Contact')}</a>
      </span>
    </div>
  </div>
</footer>
