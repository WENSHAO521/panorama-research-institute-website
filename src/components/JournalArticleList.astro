---
// Lists journal articles sponsored by the Institute, localized by `lang`.
import type { Lang } from '../i18n/utils';
import { journalArticles } from '../data/journalArticles';

interface Props { lang?: Lang; membersOnly?: boolean; }
const { lang = 'en', membersOnly = false } = Astro.props;
const articles = membersOnly ? journalArticles.filter((a) => a.instituteAuthors) : journalArticles;

const copy: Record<Lang, { sponsored: string; members: string; no: string; view: string }> = {
  en: { sponsored: 'Sponsored by the Institute', members: 'Institute members among authors', no: 'Sponsorship No.', view: 'View Article' },
  'zh-cn': { sponsored: '研究院资助', members: '作者含研究院成员', no: '资助编号', view: '查看文章' },
  'zh-tw': { sponsored: '研究院資助', members: '作者含研究院成員', no: '資助編號', view: '查看文章' },
};
const c = copy[lang];
---

{articles.map((a) => (
  <div class="publication-item">
    <div>
      <div class="pub-type">{lang === 'en' ? 'Journal Article' : lang === 'zh-cn' ? '期刊论文' : '期刊論文'}</div>
      <div style="margin-top:8px;display:flex;flex-direction:column;gap:6px;align-items:flex-start;">
        <span class="tag tag-active" style="font-size:11px;">{c.sponsored}</span>
        {a.instituteAuthors && <span class="tag tag-steel" style="font-size:11px;">{c.members}</span>}
      </div>
    </div>
    <div>
      <div class="pub-title">{a.title}</div>
      <div class="pub-meta" style="margin-top:6px;">{a.authors}</div>
      <div class="pub-meta" style="margin-top:4px;font-style:italic;">{a.journal}, {a.volume}, pp. {a.pages}</div>
      <div class="pub-meta" style="margin-top:4px;">DOI: <a href={`https://doi.org/${a.doi}`} target="_blank" rel="noopener noreferrer">{a.doi}</a> · {c.no} {a.sponsorNo}</div>
    </div>
    <div style="text-align:right;">
      <div style="font-family:var(--font-mono);font-size:13px;color:var(--text-muted);margin-bottom:16px;">{a.year}</div>
      <a href={a.url} target="_blank" rel="noopener noreferrer" class="btn btn-secondary" style="font-size:12px;padding:7px 14px;">{c.view} &rarr;</a>
    </div>
  </div>
))}
