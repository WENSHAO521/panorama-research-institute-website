---
import { translate } from '../i18n/dictionary';
import type { Lang } from '../i18n/utils';

interface Props {
  id: string;
  label?: string;
  description?: string;
  name?: string;
  accept?: string;
  maxFiles?: number;
}

const {
  id,
  label = 'Application Attachments',
  description = 'Upload completed forms, CVs, publication lists, or supporting documents as PDF, Word, image, or ZIP files. Up to 5 files, total size not exceeding 10MB.',
  name = 'attachment',
  accept = '.pdf,.doc,.docx,.zip,.png,.jpg,.jpeg',
  maxFiles = 5,
} = Astro.props;

const lang = (Astro.currentLocale as Lang) ?? 'en';
const t = (key: string) => translate(lang, key);
const slotNames = Array.from({ length: maxFiles }, (_, i) => (i === 0 ? name : `${name}${i + 1}`));
---

<div class="multi-attachment" data-multi-attachment data-max-files={maxFiles}>
  <label class="multi-attachment__label" for={id}>{t(label)}</label>
  <div class="multi-attachment__dropzone" data-attachment-dropzone>
    <input id={id} type="file" accept={accept} multiple data-attachment-input />
    {slotNames.map((slotName) => (
      <input type="file" name={slotName} data-attachment-slot hidden />
    ))}
    <div class="multi-attachment__control">
      <label class="multi-attachment__button" for={id}>{t('Choose files')}</label>
      <span class="multi-attachment__status" data-attachment-status>{t('No files selected')}</span>
    </div>
    <p class="multi-attachment__hint">{t('or drag and drop files here')}</p>
  </div>
  <ul class="multi-attachment__list" data-attachment-list aria-live="polite"></ul>
  <p class="multi-attachment__error" data-attachment-error aria-live="assertive" hidden></p>
  <p class="multi-attachment__description">{t(description)}</p>
</div>

<script>
  const MAX_TOTAL_SIZE = 10 * 1024 * 1024;

  const formatFileSize = (size) => {
    if (!size) return '0 KB';
    if (size < 1024 * 1024) return `${Math.ceil(size / 1024)} KB`;
    return `${(size / (1024 * 1024)).toFixed(1)} MB`;
  };

  const getAttachmentText = () => {
    const lang = document.documentElement.lang;
    if (lang === 'zh-cn') {
      return {
        none: '未选择文件',
        selected: (count) => `已选择 ${count} 个文件`,
        remove: '删除',
        tooLarge: (names) => `以下文件未添加，因为全部附件总大小不能超过 10MB：${names.join('、')}`,
        tooMany: (max) => `最多只能上传 ${max} 个附件，超出的文件未添加。`,
      };
    }
    if (lang === 'zh-tw') {
      return {
        none: '未選擇檔案',
        selected: (count) => `已選擇 ${count} 個檔案`,
        remove: '刪除',
        tooLarge: (names) => `以下檔案未加入，因為所有附件總大小不能超過 10MB：${names.join('、')}`,
        tooMany: (max) => `最多只能上傳 ${max} 個附件，超出的檔案未加入。`,
      };
    }
    return {
      none: 'No files selected',
      selected: (count) => `${count} file${count > 1 ? 's' : ''} selected`,
      remove: 'Remove',
      tooLarge: (names) => `Not added — total attachment size cannot exceed 10MB: ${names.join(', ')}`,
      tooMany: (max) => `You can attach up to ${max} files. Additional files were not added.`,
    };
  };

  const syncSlots = (slots, files) => {
    slots.forEach((slot, i) => {
      const transfer = new DataTransfer();
      if (files[i]) transfer.items.add(files[i]);
      slot.files = transfer.files;
    });
  };

  const renderAttachmentList = (root, slots, files) => {
    const list = root.querySelector('[data-attachment-list]');
    const status = root.querySelector('[data-attachment-status]');
    if (!list || !status) return;
    const text = getAttachmentText();

    list.innerHTML = '';
    status.textContent = files.length ? text.selected(files.length) : text.none;

    files.forEach((file, index) => {
      const item = document.createElement('li');
      item.className = 'multi-attachment__item';

      const meta = document.createElement('span');
      meta.className = 'multi-attachment__meta';
      meta.textContent = `${file.name} · ${formatFileSize(file.size)}`;

      const button = document.createElement('button');
      button.type = 'button';
      button.className = 'multi-attachment__remove';
      button.textContent = text.remove;
      button.addEventListener('click', () => {
        files.splice(index, 1);
        syncSlots(slots, files);
        renderAttachmentList(root, slots, files);
      });

      item.append(meta, button);
      list.append(item);
    });
  };

  document.querySelectorAll('[data-multi-attachment]').forEach((root) => {
    const input = root.querySelector('[data-attachment-input]');
    const errorEl = root.querySelector('[data-attachment-error]');
    const dropzone = root.querySelector('[data-attachment-dropzone]');
    const slots = Array.from(root.querySelectorAll('[data-attachment-slot]'));
    const maxFiles = parseInt(root.getAttribute('data-max-files') || String(slots.length), 10) || slots.length;
    if (!(input instanceof HTMLInputElement) || slots.length === 0) return;

    const selectedFiles = [];

    const addFiles = (fileList) => {
      const text = getAttachmentText();
      const rejected = [];
      let tooManyCount = 0;
      let total = selectedFiles.reduce((sum, file) => sum + file.size, 0);

      Array.from(fileList || []).forEach((file) => {
        const duplicate = selectedFiles.some((existing) => (
          existing.name === file.name &&
          existing.size === file.size &&
          existing.lastModified === file.lastModified
        ));
        if (duplicate) return;
        if (selectedFiles.length >= maxFiles) {
          tooManyCount += 1;
          return;
        }
        if (total + file.size > MAX_TOTAL_SIZE) {
          rejected.push(file.name);
          return;
        }
        total += file.size;
        selectedFiles.push(file);
      });

      syncSlots(slots, selectedFiles);
      renderAttachmentList(root, slots, selectedFiles);
      // The picker input only stages files in memory; it is never submitted.
      input.value = '';

      if (errorEl) {
        if (rejected.length) {
          errorEl.textContent = text.tooLarge(rejected);
          errorEl.hidden = false;
        } else if (tooManyCount > 0) {
          errorEl.textContent = text.tooMany(maxFiles);
          errorEl.hidden = false;
        } else {
          errorEl.textContent = '';
          errorEl.hidden = true;
        }
      }
    };

    input.addEventListener('change', () => {
      addFiles(input.files);
    });

    if (dropzone) {
      let dragDepth = 0;

      dropzone.addEventListener('dragenter', (e) => {
        e.preventDefault();
        dragDepth += 1;
        dropzone.classList.add('multi-attachment__dropzone--active');
      });

      dropzone.addEventListener('dragover', (e) => {
        e.preventDefault();
      });

      dropzone.addEventListener('dragleave', (e) => {
        e.preventDefault();
        dragDepth = Math.max(0, dragDepth - 1);
        if (dragDepth === 0) dropzone.classList.remove('multi-attachment__dropzone--active');
      });

      dropzone.addEventListener('drop', (e) => {
        e.preventDefault();
        dragDepth = 0;
        dropzone.classList.remove('multi-attachment__dropzone--active');
        const files = e.dataTransfer && e.dataTransfer.files;
        if (files && files.length) addFiles(files);
      });
    }
  });
</script>

<style>
.multi-attachment {
  display: grid;
  gap: 10px;
}
.multi-attachment__label {
  display: block;
  font-family: var(--font-mono);
  font-size: 11px;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--text-muted);
}
.multi-attachment__dropzone {
  border: 1.5px dashed var(--border-light);
  border-radius: 4px;
  padding: 16px;
  transition: border-color 0.15s, background 0.15s;
}
.multi-attachment__dropzone--active {
  border-color: var(--accent-steel);
  border-style: solid;
  background: var(--bg-soft);
}
.multi-attachment__dropzone input[type="file"]:not([hidden]) {
  position: absolute;
  inline-size: 1px;
  block-size: 1px;
  opacity: 0;
  pointer-events: none;
}
.multi-attachment__control {
  display: flex;
  align-items: center;
  gap: 12px;
  flex-wrap: wrap;
}
.multi-attachment__hint {
  margin: 12px 0 0;
  font-size: 12px;
  color: var(--text-muted);
}
.multi-attachment__button,
.multi-attachment__remove {
  border: 1px solid var(--text-main);
  background: var(--bg-white);
  color: var(--text-main);
  font-family: var(--font-sans);
  font-size: 13px;
  font-weight: 600;
  line-height: 1;
  padding: 10px 14px;
  cursor: pointer;
}
.multi-attachment__button:hover,
.multi-attachment__remove:hover {
  background: var(--text-main);
  color: var(--bg-white);
}
.multi-attachment__status,
.multi-attachment__description {
  font-size: 12.5px;
  line-height: 1.6;
  color: var(--text-muted);
}
.multi-attachment__error {
  font-size: 12.5px;
  line-height: 1.6;
  color: var(--accent-red);
  margin: 0;
}
.multi-attachment__list {
  display: grid;
  gap: 6px;
  margin: 0;
  padding: 0;
  list-style: none;
}
.multi-attachment__item {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  align-items: center;
  gap: 20px;
  padding: 11px 12px 11px 14px;
  border: 1px solid var(--border-light);
  background: var(--bg-soft);
}
.multi-attachment__meta {
  min-width: 0;
  overflow-wrap: anywhere;
  font-size: 13px;
  color: var(--text-secondary);
}
.multi-attachment__remove {
  flex: 0 0 auto;
  border-color: var(--accent-red);
  color: var(--accent-red);
  padding: 8px 12px;
  font-size: 12px;
  min-width: 72px;
}
.multi-attachment__remove:hover {
  background: var(--accent-red);
  border-color: var(--accent-red);
  color: var(--bg-white);
}
@media (max-width: 560px) {
  .multi-attachment__control {
    align-items: stretch;
    flex-direction: column;
  }
  .multi-attachment__item {
    grid-template-columns: 1fr;
    gap: 10px;
  }
  .multi-attachment__button,
  .multi-attachment__remove {
    text-align: center;
  }
}
</style>
