---
import type { Lang } from '../i18n/utils';

interface Props {
  lang?: Lang;
}
const { lang = 'en' } = Astro.props;
const label = lang === 'zh-cn' ? '切换日间/夜间模式' : lang === 'zh-tw' ? '切換日間/夜間模式' : 'Toggle light/dark theme';
---

<button class="theme-toggle" type="button" aria-label={label} title={label} data-theme-toggle>
  <svg class="theme-icon theme-icon-sun" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
    <circle cx="10" cy="10" r="3.5"></circle>
    <path d="M10 2.5v2M10 15.5v2M2.5 10h2M15.5 10h2M4.7 4.7l1.4 1.4M13.9 13.9l1.4 1.4M4.7 15.3l1.4-1.4M13.9 6.1l1.4-1.4"></path>
  </svg>
  <svg class="theme-icon theme-icon-moon" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
    <path d="M16.5 11.8A6.8 6.8 0 0 1 8.2 3.5a6.8 6.8 0 1 0 8.3 8.3z"></path>
  </svg>
</button>

<style is:global>
.theme-toggle {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 40px;
  height: 40px;
  padding: 0;
  border: 1px solid var(--pri-accent);
  border-radius: 999px;
  background: var(--bg-white);
  color: var(--accent-steel);
  cursor: pointer;
  transition: border-color 0.15s ease, background 0.15s ease;
}
.theme-toggle:hover { border-color: var(--pri-primary); }
.theme-toggle:focus-visible { outline: 2px solid var(--pri-focus); outline-offset: 2px; }
.theme-icon {
  width: 18px;
  height: 18px;
  fill: none;
  stroke: currentColor;
  stroke-width: 1.5;
  stroke-linecap: round;
  stroke-linejoin: round;
}
.theme-icon-moon { display: none; }
:root[data-theme="dark"] .theme-icon-sun { display: none; }
:root[data-theme="dark"] .theme-icon-moon { display: block; }
@media (max-width: 768px) {
  .theme-toggle { width: 38px; height: 38px; }
}
</style>
