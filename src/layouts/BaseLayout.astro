---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import { getBasePath, getLocalizedPath, type Lang } from '../i18n/utils';
import { translate } from '../i18n/dictionary';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  lang?: Lang;
}

const {
  title,
  description = 'Panorama Research Institute is an internal research and academic development division of Panorama Scholarly Group.',
  ogImage,
  lang = (Astro.currentLocale as Lang) ?? 'en',
} = Astro.props;

const siteOrigin = Astro.site ?? new URL('https://research.panorama-sg.com');
const basePath = getBasePath(Astro.url.pathname);
const canonicalURL = new URL(getLocalizedPath(lang, Astro.url.pathname), siteOrigin);
const brandName = translate(lang, 'Panorama Research Institute');
const resolvedTitle = title ?? 'Panorama Research Institute';
const fullTitle = resolvedTitle === 'Panorama Research Institute' || resolvedTitle === brandName
  ? brandName
  : `${resolvedTitle} | ${brandName}`;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:title"       content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type"        content="website" />
    <meta property="og:url"         content={canonicalURL} />
    {ogImage && <meta property="og:image" content={ogImage} />}

    <link rel="alternate" hreflang="en" href={new URL(getLocalizedPath('en', basePath), siteOrigin)} />
    <link rel="alternate" hreflang="zh-CN" href={new URL(getLocalizedPath('zh-cn', basePath), siteOrigin)} />
    <link rel="alternate" hreflang="zh-TW" href={new URL(getLocalizedPath('zh-tw', basePath), siteOrigin)} />
    <link rel="alternate" hreflang="x-default" href={new URL(getLocalizedPath('en', basePath), siteOrigin)} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  </head>
  <body>
    <Header lang={lang} />
    <main id="main-content">
      <slot />
    </main>
    <Footer lang={lang} />
    <script>
      function closeMobileNav() {
        const mobileNav = document.getElementById('mobile-nav');
        mobileNav?.classList.remove('open');
        document.body.style.overflow = '';
      }

      document.addEventListener('click', (event) => {
        const target = event.target;
        if (!(target instanceof Element)) return;

        const menuToggle = target.closest('#menu-toggle');
        if (menuToggle) {
          const mobileNav = document.getElementById('mobile-nav');
          mobileNav?.classList.add('open');
          document.body.style.overflow = 'hidden';
          return;
        }

        const mobileClose = target.closest('#mobile-close');
        if (mobileClose) {
          closeMobileNav();
          return;
        }

        const mobileTrigger = target.closest('.mobile-nav-trigger[data-target]');
        if (mobileTrigger) {
          const targetId = mobileTrigger.getAttribute('data-target');
          if (targetId) document.getElementById(targetId)?.classList.toggle('open');
          return;
        }

        const dropdownTrigger = target.closest('.nav-trigger[aria-haspopup]');
        if (dropdownTrigger) {
          dropdownTrigger.setAttribute('aria-expanded', String(dropdownTrigger.getAttribute('aria-expanded') !== 'true'));
          return;
        }
      });

      document.addEventListener('focusout', (event) => {
        const target = event.target;
        if (!(target instanceof Element)) return;
        const navItem = target.closest('.nav-item');
        const relatedTarget = event.relatedTarget instanceof Node ? event.relatedTarget : null;
        if (!navItem || (relatedTarget && navItem.contains(relatedTarget))) return;
        navItem.querySelector('.nav-trigger')?.setAttribute('aria-expanded', 'false');
      });

      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') closeMobileNav();
      });
    </script>
  </body>
</html>
