---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import RorLogo from '../../components/RorLogo.astro';
import { site } from '../../data/site';
---
<BaseLayout title="Institutional Status" description="The legal and institutional status of Panorama Research Institute.">
  <PageHero
    title="Institutional Status"
    description="The legal position, governance structure, and institutional relationship of Panorama Research Institute within Panorama Scholarly Group."
    breadcrumbs={[{ label: "Institute", href: "/about" }, { label: "Institutional Status" }]}
  />

  <section class="section" style="background:var(--bg-white);">
    <div class="container">
      <div style="max-width:800px;">
        <div class="statement-box" style="margin-bottom:48px;">
          <div style="font-family:var(--font-mono);font-size:11px;letter-spacing:0.12em;text-transform:uppercase;color:var(--text-muted);margin-bottom:12px;">Official Institutional Statement</div>
          <p style="font-size:17px;line-height:1.8;color:var(--text-secondary);margin-bottom:12px;font-family:var(--font-serif);font-style:italic;">
            "Panorama Research Institute is a research institute established by Panorama Scholarly Group, with its own academic governance and institutional identity. PSG serves as its parent organization and legal and administrative entity. PRI is not a separate legal entity."
          </p>
        </div>

        <div class="institutional-profile">
          <h2>Institutional Profile</h2>
          <dl>
            <div class="profile-row"><dt>Official Name</dt><dd>Panorama Research Institute</dd></div>
            <div class="profile-row"><dt>Chinese Name</dt><dd>全景研究院</dd></div>
            <div class="profile-row"><dt>Acronym</dt><dd>PRI</dd></div>
            <div class="profile-row"><dt>Organization Type</dt><dd>Research institute (not a separate legal entity)</dd></div>
            <div class="profile-row"><dt>Established</dt><dd>{site.established}</dd></div>
            <div class="profile-row"><dt>Location</dt><dd>{site.address.city}</dd></div>
            <div class="profile-row"><dt>Address</dt><dd><span class="profile-muted">Hong Kong Office</span><br /><span data-no-translate>{site.address.lines.join(', ')}, {site.address.city}</span></dd></div>
            <div class="profile-row"><dt>Parent Organization</dt><dd><span class="profile-inline"><a href={site.parentUrl} target="_blank" rel="noopener">Panorama Scholarly Group</a><RorLogo href={site.parentRor} label="Panorama Scholarly Group – ROR ID" size={18} /></span></dd></div>
            {site.ror && (
              <div class="profile-row"><dt>ROR ID</dt><dd><RorLogo href={site.ror} label="Panorama Research Institute – ROR ID" size={18} /></dd></div>
            )}
            <div class="profile-row"><dt>Website</dt><dd><a href="https://research.panorama-sg.com">research.panorama-sg.com</a></dd></div>
            <div class="profile-row"><dt>Email</dt><dd><a href="mailto:research@panorama-sg.com">research@panorama-sg.com</a></dd></div>
            <div class="profile-row"><dt>Current Charter</dt><dd>Version 1.1, effective 2026-10-05</dd></div>
          </dl>
        </div>

        {[
          {
            title: "Legal Status",
            body: "Panorama Research Institute is a research institute established by Panorama Scholarly Group, with its own academic governance and institutional identity. PSG is its parent organization and legal and administrative entity, and is the legal party for Institute contracts and formal legal instruments. PRI has no separate legal personality or independent legal registration, and does not maintain financial accounts separate from PSG."
          },
          {
            title: "Operational Independence",
            body: "While the Institute operates under the administrative governance of Panorama Scholarly Group, it maintains academic independence in its research activities, publication decisions, event organization, and scholarly functions. Administrative governance does not extend to research direction, academic judgment, or editorial decisions."
          },
          {
            title: "Governance Framework",
            body: "The Institute is governed by its own charter and set of internal governance policies, adopted under the authority of Panorama Scholarly Group. These documents establish the Institute's mission, research areas, organizational structure, ethical principles, and operational procedures."
          },
          {
            title: "Official Name Usage",
            body: "The Institute operates under the name \"Panorama Research Institute\" and is described as a research institute established by Panorama Scholarly Group. Official institutional descriptions and publications disclose PSG as PRI's parent organization and legal and administrative entity, and state that PRI is not a separate legal entity. Authorized academic affiliations may use the PRI name. Formal agreements must identify PSG as the legal party and PRI as the research institute carrying out the activities."
          },
          {
            title: "Financial Administration",
            body: "All financial matters related to the Institute are administered by Panorama Scholarly Group. Research funding, publication costs, event budgets, and fellowship payments are managed within the financial governance framework of Panorama Scholarly Group."
          },
          {
            title: "External Representation",
            body: "PRI may develop and coordinate academic cooperation arrangements, memoranda of understanding, and collaboration proposals under its institutional name. Any formal instrument requiring execution or creating legal or financial obligations must identify PSG as the legal party and be signed by a PSG-authorized representative; the PRI name alone does not confer signing authority."
          },
        ].map((s) => (
          <div style="margin-bottom:40px;padding-bottom:40px;border-bottom:1px solid var(--border-light);">
            <h2 style="font-family:var(--font-serif);font-size:22px;color:var(--text-main);margin-bottom:14px;font-weight:400;">{s.title}</h2>
            <p style="font-size:15.5px;line-height:1.8;color:var(--text-secondary);">{s.body}</p>
          </div>
        ))}

        <div style="display:flex;gap:10px;flex-wrap:wrap;margin-top:8px;">
          <a href="/charter"     class="btn btn-primary">Institute Charter</a>
          <a href="/about"       class="btn btn-secondary">Institute Overview</a>
          <a href="/governance/rules" class="btn btn-secondary">Governance Rules</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
<style>
  .institutional-profile { margin-bottom:48px; padding-bottom:40px; border-bottom:1px solid var(--border-light); }
  .institutional-profile h2 { font-family:var(--font-serif); font-size:22px; color:var(--text-main); margin-bottom:18px; font-weight:400; }
  .institutional-profile dl { margin:0; border-top:1px solid var(--border-light); }
  .profile-row { display:grid; grid-template-columns:200px 1fr; gap:24px; padding:12px 0; border-bottom:1px solid var(--border-light); }
  .profile-row dt { font-family:var(--font-mono); font-size:11px; letter-spacing:0.1em; text-transform:uppercase; color:var(--text-muted); padding-top:3px; }
  .profile-row dd { margin:0; font-size:15px; line-height:1.65; color:var(--text-main); }
  .profile-row dd a { color:var(--accent-steel); }
  .profile-muted { font-size:13px; color:var(--text-muted); }
  .profile-inline { display:inline-flex; align-items:center; gap:8px; }
  @media (max-width: 640px) {
    .profile-row { grid-template-columns:1fr; gap:4px; }
  }
</style>
