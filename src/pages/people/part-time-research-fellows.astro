---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
---
<BaseLayout title="Part-time Research Fellows" description="Part-time Research Fellows affiliated with Panorama Research Institute.">
  <PageHero
    title="Part-time Research Fellows"
    description="The Part-time Research Fellow track allows researchers with a primary academic or professional position elsewhere to affiliate with Panorama Research Institute on a reduced-commitment basis."
    breadcrumbs={[{ label: "People", href: "/people" }, { label: "Part-time Research Fellows" }]}
  />

  <section class="section" style="background:var(--bg-white);">
    <div class="container">
      <div style="display:grid;grid-template-columns:1fr 2fr;gap:64px;align-items:start;">
        <div>
          <div class="section-label">Fellowship Details</div>
          <div style="display:flex;flex-direction:column;gap:16px;margin-top:8px;">
            {[
              { label:"Title",       value:"Part-time Research Fellow, Panorama Research Institute" },
              { label:"Target",      value:"Researchers or practitioners with a primary position elsewhere" },
              { label:"Duration",    value:"1 year, renewable" },
              { label:"Format",      value:"Remote / distributed, flexible schedule" },
              { label:"Output",      value:"Reduced or project-based contribution" },
              { label:"Application", value:"Open (rolling)" },
            ].map((item) => (
              <div>
                <div style="font-size:11px;font-family:var(--font-mono);text-transform:uppercase;letter-spacing:0.1em;color:var(--text-muted);margin-bottom:4px;">{item.label}</div>
                <div style="font-size:14.5px;color:var(--text-main);">{item.value}</div>
              </div>
            ))}
          </div>
          <div style="margin-top:28px;display:flex;flex-direction:column;gap:8px;">
            <a href="/collaboration/research-fellow-application" class="btn btn-primary" style="width:100%;justify-content:center;">Apply Now</a>
            <a href="/people/research-fellows" class="btn btn-secondary" style="width:100%;justify-content:center;">Research Fellows</a>
          </div>
        </div>
        <div>
          <h2 style="font-family:var(--font-serif);font-size:24px;color:var(--text-main);margin-bottom:16px;font-weight:400;">About Part-time Research Fellows</h2>
          <p style="font-size:16px;line-height:1.85;color:var(--text-secondary);margin-bottom:20px;">
            The Part-time Research Fellow designation is intended for researchers or practitioners who hold a primary academic or professional position elsewhere but wish to maintain an ongoing, lighter-commitment affiliation with Panorama Research Institute. This track suits scholars who cannot commit to the full output expectations of a Research Fellow but still wish to contribute to the Institute's research program.
          </p>
          <p style="font-size:16px;line-height:1.85;color:var(--text-secondary);margin-bottom:32px;">
            Part-time Research Fellows contribute to Institute projects and publications on a reduced or project-based schedule, and participate in select Institute activities as their availability allows. Terms of contribution are agreed with the relevant research center at the time of appointment.
          </p>

          <div style="padding:24px;background:var(--bg-soft);border:1px solid var(--border-light);">
            <div style="font-family:var(--font-mono);font-size:11px;letter-spacing:0.08em;text-transform:uppercase;color:var(--text-muted);margin-bottom:8px;">Current Cohort</div>
            <p style="font-size:14.5px;color:var(--text-secondary);margin:0;line-height:1.7;">
              The Institute is currently accepting applications for its Part-time Research Fellow track. Accepted fellows will be listed on this page upon appointment.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
<style>
@media (max-width: 900px) {
  div[style*="grid-template-columns:1fr 2fr"] { display: block !important; }
}
</style>
