---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import JournalArticleList from '../../components/JournalArticleList.astro';
---
<BaseLayout title="Journal Articles" description="Journal articles with Institute members among their authors, supported by Institute sponsorship.">
  <PageHero
    title="Journal Articles"
    description="Journal articles with Institute members among their authors, supported by Institute sponsorship. Sponsored works by authors outside the Institute are listed under Sponsorship."
    breadcrumbs={[{ label: "Publications", href: "/publications" }, { label: "Journal Articles" }]}
  />

  <section class="section" style="background:var(--bg-main);">
    <div class="container">
      <JournalArticleList lang="en" membersOnly />
    </div>
  </section>
</BaseLayout>
