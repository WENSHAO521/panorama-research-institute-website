---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import JournalArticleList from '../../components/JournalArticleList.astro';
---
<BaseLayout title="Journal Articles" description="Journal articles published in Panorama journals with the sponsorship of Panorama Research Institute.">
  <PageHero
    title="Journal Articles"
    description="Journal articles published in Panorama journals with the sponsorship of Panorama Research Institute, including work by Institute members."
    breadcrumbs={[{ label: "Publications", href: "/publications" }, { label: "Journal Articles" }]}
  />

  <section class="section" style="background:var(--bg-main);">
    <div class="container">
      <JournalArticleList lang="en" />
    </div>
  </section>
</BaseLayout>
