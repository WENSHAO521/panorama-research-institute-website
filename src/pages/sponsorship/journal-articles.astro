---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import JournalArticleList from '../../components/JournalArticleList.astro';
---
<BaseLayout title="Sponsored Journal Articles" description="Journal articles supported by Panorama Research Institute sponsorship, authored mainly by scholars and institutions outside the Institute.">
  <PageHero
    title="Sponsored Journal Articles"
    description="Journal articles supported by Panorama Research Institute sponsorship, authored mainly by scholars and institutions outside the Institute."
    breadcrumbs={[{ label: "Sponsorship", href: "/sponsorship" }, { label: "Sponsored Journal Articles" }]}
  />

  <section class="section" style="background:var(--bg-main);">
    <div class="container">
      <JournalArticleList lang="en" sponsoredOnly />
    </div>
  </section>
</BaseLayout>
