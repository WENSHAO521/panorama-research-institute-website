---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/PageHero.astro';
import RorLogo from '../../../components/RorLogo.astro';
import { site } from '../../../data/site';
---
<BaseLayout title="机构性质" description="全景研究院的法律与机构地位。">
  <PageHero
    title="机构性质"
    description="全景研究院在全景学术集团内的法律定位、治理结构和机构关系。"
    breadcrumbs={[{ label: "研究院", href: "/zh-cn/about" }, { label: "机构性质" }]}
  />

  <section class="section" style="background:var(--bg-white);">
    <div class="container">
      <div style="max-width:800px;">
        <div class="statement-box" style="margin-bottom:48px;">
          <div style="font-family:var(--font-mono);font-size:11px;letter-spacing:0.12em;text-transform:uppercase;color:var(--text-muted);margin-bottom:12px;">正式机构声明</div>
          <p style="font-size:17px;line-height:1.8;color:var(--text-secondary);margin-bottom:12px;font-family:var(--font-serif);font-style:italic;">
            "全景研究院是由全景学术集团设立、具有自身学术治理体系与机构身份的研究机构。PSG 是其上级机构，负责其法律与行政事务。PRI 不具有独立法人资格。"
          </p>
        </div>

        <div class="institutional-profile">
          <h2>机构基本信息</h2>
          <dl>
            <div class="profile-row"><dt>正式名称</dt><dd>全景研究院</dd></div>
            <div class="profile-row"><dt>英文名称</dt><dd>Panorama Research Institute</dd></div>
            <div class="profile-row"><dt>简称</dt><dd>PRI</dd></div>
            <div class="profile-row"><dt>机构类型</dt><dd>研究机构（不具有独立法人资格）</dd></div>
            <div class="profile-row"><dt>成立年份</dt><dd>{site.established} 年</dd></div>
            <div class="profile-row"><dt>所在地</dt><dd>香港</dd></div>
            <div class="profile-row"><dt>地址</dt><dd><span class="profile-muted">香港办公室</span><br /><span data-no-translate>{site.address.lines.join(', ')}, {site.address.city}</span></dd></div>
            <div class="profile-row"><dt>上级机构</dt><dd><span class="profile-inline"><a href={site.parentUrl} target="_blank" rel="noopener">全景学术集团</a><RorLogo href={site.parentRor} label="全景学术集团 – ROR ID" size={14} /></span></dd></div>
            {site.ror && (
              <div class="profile-row"><dt>ROR ID</dt><dd><RorLogo href={site.ror} label="全景研究院 – ROR ID" size={14} /></dd></div>
            )}
            <div class="profile-row"><dt>网站</dt><dd><a href="https://research.panorama-sg.com">research.panorama-sg.com</a></dd></div>
            <div class="profile-row"><dt>电子邮箱</dt><dd><a href="mailto:research@panorama-sg.com">research@panorama-sg.com</a></dd></div>
            <div class="profile-row"><dt>现行章程</dt><dd>1.1 版，2026-10-05 生效</dd></div>
          </dl>
        </div>

        {[
          {
            title: "法律地位",
            body: "全景研究院是由全景学术集团设立、具有自身学术治理体系与机构身份的研究机构。PSG 是其上级机构及法律与行政承载主体，也是本院合同与正式法律文件的法律当事方。PRI 不具有独立法人资格或独立法律登记，也不设立独立于 PSG 的财务账户。"
          },
          {
            title: "运营独立",
            body: "研究院虽在全景学术集团的行政治理下运行，但在研究活动、出版决策、活动组织和学术职能方面保持学术独立。行政治理不延伸至研究方向、学术判断或编辑决策。"
          },
          {
            title: "治理框架",
            body: "研究院依据自身章程和内部治理政策进行治理，这些文件在全景学术集团授权下采纳，确立研究院使命、研究领域、组织架构、伦理原则和运营程序。"
          },
          {
            title: "正式名称使用",
            body: '研究院以“Panorama Research Institute”名称运行，其定位为由全景学术集团设立的研究机构。正式机构说明和出版物须披露 PSG 为 PRI 的上级机构及法律与行政承载主体，并说明 PRI 不具有独立法人资格。经授权的学术署名可使用 PRI 名称。正式协议须明确 PSG 为法律当事方，PRI 为开展有关活动的研究机构。'
          },
          {
            title: "财务管理",
            body: "与研究院相关的所有财务事项均由全景学术集团管理。研究经费、出版成本、活动预算和研究员支付均在全景学术集团财务治理框架内管理。"
          },
          {
            title: "对外代表",
            body: "PRI 可使用自身机构名称开展和协调学术合作安排、谅解备忘录及合作提案。凡需正式签署或产生法律、财务义务的文件，均须明确 PSG 为法律当事方，并由 PSG 授权代表签署；仅使用 PRI 名称不产生签约权限。"
          },
        ].map((s) => (
          <div style="margin-bottom:40px;padding-bottom:40px;border-bottom:1px solid var(--border-light);">
            <h2 style="font-family:var(--font-serif);font-size:22px;color:var(--text-main);margin-bottom:14px;font-weight:400;">{s.title}</h2>
            <p style="font-size:15.5px;line-height:1.8;color:var(--text-secondary);">{s.body}</p>
          </div>
        ))}

        <div style="display:flex;gap:10px;flex-wrap:wrap;margin-top:8px;">
          <a href="/zh-cn/charter"     class="btn btn-primary">研究院章程</a>
          <a href="/zh-cn/about"       class="btn btn-secondary">研究院概览</a>
          <a href="/zh-cn/governance/rules" class="btn btn-secondary">治理规则</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
<style>
  .institutional-profile { margin-bottom:48px; padding-bottom:40px; border-bottom:1px solid var(--border-light); }
  .institutional-profile h2 { font-family:var(--font-serif); font-size:22px; color:var(--text-main); margin-bottom:18px; font-weight:400; }
  .institutional-profile dl { margin:0; border-top:1px solid var(--border-light); }
  .profile-row { display:grid; grid-template-columns:200px 1fr; gap:24px; padding:12px 0; border-bottom:1px solid var(--border-light); }
  .profile-row dt { font-family:var(--font-mono); font-size:11px; letter-spacing:0.1em; text-transform:uppercase; color:var(--text-muted); padding-top:3px; }
  .profile-row dd { margin:0; font-size:15px; line-height:1.65; color:var(--text-main); }
  .profile-row dd a { color:var(--accent-steel); }
  .profile-muted { font-size:13px; color:var(--text-muted); }
  .profile-inline { display:inline-flex; align-items:center; gap:8px; }
  @media (max-width: 640px) {
    .profile-row { grid-template-columns:1fr; gap:4px; }
  }
</style>
