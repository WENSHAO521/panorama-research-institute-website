---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/PageHero.astro';
import CharterVersionList from '../../../components/CharterVersionList.astro';
---
<BaseLayout title="章程版本历史" description="全景研究院章程的现行版本及历史版本。">
  <PageHero
    title="章程版本历史"
    description="依照章程第 20 条，本页公布研究院章程的现行版本及历史版本，以保持透明。已被取代的版本原样存档，仅供参考，以现行版本为准。"
    breadcrumbs={[{ label: "研究院章程", href: "/zh-cn/charter" }, { label: "章程版本历史" }]}
  />

  <section class="section" style="background:var(--bg-main);">
    <div class="container">
      <CharterVersionList lang="zh-cn" />
    </div>
  </section>
</BaseLayout>
