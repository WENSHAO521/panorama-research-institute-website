---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/PageHero.astro';
import FormSubmitFields from '../../../components/FormSubmitFields.astro';
import MultiAttachmentUpload from '../../../components/MultiAttachmentUpload.astro';
---
<BaseLayout title="主编文集提案" description="提交与全景研究院合作编辑学术编著的提案。">
  <PageHero
    title="主编文集提案"
    description="提交主编学术文集提案，与全景研究院合作出版。研究院为文集主编提供机构隶属、编辑指导和出版社对接支持。"
    breadcrumbs={[{ label: "学术合作", href: "/zh-cn/collaboration" }, { label: "主编文集提案" }]}
  />

  <section class="section" style="background:var(--bg-white);">
    <div class="container">
      <div style="display:grid;grid-template-columns:1fr 2fr;gap:64px;align-items:start;">
        <div>
          <div class="section-label">提案要求</div>
          <div style="display:flex;flex-direction:column;gap:16px;margin-top:8px;">
            {[
              { label:"文集类型",  value:"主编学术文集" },
              { label:"提案",     value:"不超过 2,000 词 + 章节清单" },
              { label:"评审时间",  value:"20 个工作日内" },
              { label:"支持",      value:"机构隶属、编辑指导、出版社对接" },
              { label:"开放获取",  value:"优先开放获取；APC 支持视资源情况而定" },
            ].map((item) => (
              <div>
                <div style="font-size:11px;font-family:var(--font-mono);text-transform:uppercase;letter-spacing:0.1em;color:var(--text-muted);margin-bottom:4px;">{item.label}</div>
                <div style="font-size:14.5px;color:var(--text-main);">{item.value}</div>
              </div>
            ))}
          </div>
          <div style="margin-top:20px;">
            <a href="/templates/PRI_Edited Volume Proposal Template_CN.docx" class="btn btn-secondary" style="width:100%;justify-content:center;" download>下载提案模板</a>
          </div>
        </div>
        <div>
          <p style="font-size:16px;line-height:1.85;color:var(--text-secondary);margin-bottom:32px;">
            有意与全景研究院合作主编学术文集的研究人员可提交提案。研究院将考虑符合指定研究领域、并具有连贯且重要学术贡献的提案。
          </p>

          <div class="section-label" style="margin-bottom:14px;">提案内容</div>
          <div style="display:flex;flex-direction:column;gap:0;border:1px solid var(--border-light);margin-bottom:40px;">
            {[
              { sec:"1. 文集标题与概要",    desc:"文集暂定标题，以及 300 词范围与意义概要。" },
              { sec:"2. 主编简介",            desc:"拟任文集主编的学术简介与相关出版物。" },
              { sec:"3. 目标读者",              desc:"文集的主要和次要读者群。" },
              { sec:"4. 拟定章节结构",   desc:"含暂定标题和 50 词摘要的临时章节清单。" },
              { sec:"5. 拟合作出版社",           desc:"目标出版社，并说明已有沟通情况。" },
              { sec:"6. 时间表",                     desc:"拟定章节征集、投稿和出版时间表。" },
              { sec:"7. 开放获取计划",             desc:"拟定开放获取模式及已有 APC 经费。" },
            ].map((item) => (
              <div style="padding:14px 20px;border-bottom:1px solid var(--border-light);">
                <div style="font-size:13.5px;font-weight:600;color:var(--text-main);margin-bottom:4px;">{item.sec}</div>
                <div style="font-size:13px;color:var(--text-secondary);line-height:1.6;">{item.desc}</div>
              </div>
            ))}
          </div>
        </div>
      </div>

      <div style="border-top:1px solid var(--border-light);padding-top:48px;">
        <div class="section-label" style="margin-bottom:8px;">提案表格</div>
        <h2 style="font-family:var(--font-serif);font-size:24px;color:var(--text-main);margin-bottom:24px;font-weight:400;">提交提案</h2>
        <form style="max-width:740px;" action="https://formsubmit.co/publications@panorama-sg.com" method="POST" enctype="multipart/form-data">
          <FormSubmitFields subject="全景研究院编著提案" source="Edited Volume Proposal Form" />
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:0;margin-bottom:-0.5px;">
            {([
              { label:"主编姓名",  id:"editor-name",  type:"text",  placeholder:"姓名" },
              { label:"电子邮箱地址",     id:"editor-email", name:"email", type:"email", placeholder:"your@email.com" },
              { label:"所属机构",       id:"editor-inst",  type:"text",  placeholder:"当前机构隶属" },
              { label:"暂定标题",     id:"vol-title",    type:"text",  placeholder:"拟议文集标题" },
            ] as { label: string; id: string; name?: string; type: 'text' | 'email'; placeholder: string }[]).map((f) => (
              <div style="padding:12px;border:1px solid var(--border-light);margin:-0.5px;">
                <label for={f.id} style="display:block;font-size:11px;font-family:var(--font-mono);text-transform:uppercase;letter-spacing:0.1em;color:var(--text-muted);margin-bottom:6px;">{f.label}</label>
                <input id={f.id} name={f.name ?? f.id} type={f.type} placeholder={f.placeholder} class="form-input" style="width:100%;" />
              </div>
            ))}
          </div>
          <div style="padding:12px;border:1px solid var(--border-light);margin-top:-0.5px;">
            <label for="synopsis" style="display:block;font-size:11px;font-family:var(--font-mono);text-transform:uppercase;letter-spacing:0.1em;color:var(--text-muted);margin-bottom:6px;">文集提案（见上方指南）</label>
            <textarea id="synopsis" name="synopsis" rows="10" placeholder="请包含提案指南中列出的全部必需部分。" class="form-input" style="width:100%;resize:vertical;"></textarea>
          </div>
          <div style="padding:12px;border:1px solid var(--border-light);margin-top:-0.5px;">
            <MultiAttachmentUpload
              id="attachments"
              label="提案附件"
              description="请上传填写完成的文集提案文档、主编简历或其他支持材料，可使用 PDF、Word、图片或 ZIP 文件。最多可上传 5 个文件，总大小请勿超过 10MB。如需发送超过 5 个文件，请直接发送邮件至 publications@panorama-sg.com。"
              accept=".pdf,.doc,.docx,.zip,.png,.jpg,.jpeg"
            />
          </div>
          <div style="padding:12px;border:1px solid var(--border-light);margin-top:-0.5px;">
            <button type="submit" class="btn btn-primary" style="width:100%;justify-content:center;">提交文集提案</button>
          </div>
        </form>
      </div>
    </div>
  </section>
</BaseLayout>
<style>
@media (max-width: 900px) {
  div[style*="grid-template-columns:1fr 2fr"] { display: block !important; }
  div[style*="grid-template-columns:1fr 1fr"] { display: block !important; }
}
</style>
