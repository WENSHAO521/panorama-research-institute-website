const applicationSteps = [
  '申请人提交会员申请表',
  '研究院进行资格与资料审核',
  '审核通过后，研究院发送缴费说明',
  '申请人向 Panorama Scholarly Group 支付年度会费',
  '研究院确认付款后开通会员资格',
  '研究院签发会员确认邮件及会员证书',
  '会员可根据会员类别使用相应资源和申请权益',
];

const applicationMaterials = [
  '姓名',
  '电子邮箱',
  '所在机构或学校',
  '国家或地区',
