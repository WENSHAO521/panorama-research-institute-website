  {
    name: '标准会员',
    audience: '学者、研究人员、作者、编辑、独立研究者和学术从业者',
    fee: 'USD 200 / 年',
    term: '12 个月',
  },
  {
    name: '机构会员',
    audience: '高校、研究机构、学术团体、期刊、出版社和研究团队',
    fee: 'USD 800 / 年',
    term: '12 个月',
  },
  {
    name: '荣誉会员',
