    benefits: [
      '荣誉会员通常不收取会费。',
      '荣誉会员资格由研究院根据贡献、合作关系和学术声誉进行邀请和确认。',
      '除非另有正式任命文件，荣誉会员身份不自动代表治理职务、研究员身份、顾问身份或编委身份。',
    ],
    exclusions: [],
  },
];

const comparisonRows = [
  ['会员证书', '有', '有', '有'],
  ['官网会员档案', '基础展示', '完整展示', '机构展示'],
  ['基础资源下载', '有', '有', '有'],
  ['进阶资源下载', '部分开放', '有', '有'],
  ['会员通讯', '有', '有', '有'],
  ['线上公开活动', '免费或优惠', '免费或优惠', '可参与'],
  ['高级工作坊', '折扣', '优惠折扣', '机构优惠'],
  ['工作论文提交资格', '有', '有', '可推荐'],
  ['项目参与申请', '有', '优先初审', '可申请合作'],
  ['合作提案提交', '有', '优先初审', '机构优先初审'],
  ['研究报告或政策简报提案', '有', '有', '可联合提案'],
  ['活动合作申请', '可建议', '可申请', '可联合举办'],
  ['出版相关咨询优惠', '部分开放', '有', '可协商'],
  ['研究员身份', '不包含', '不包含', '不包含'],
  ['发表或出版保证', '不包含', '不包含', '不包含'],
  ['收录或背书保证', '不包含', '不包含', '不包含'],
