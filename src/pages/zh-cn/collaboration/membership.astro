  '会员类别',
  '学校或机构',
  '国家或地区',
  '研究兴趣',
  'ORCID',
  '个人主页',
  '简短简介',
  '会员年度',
];

const formFields = [
  '姓名 *',
  '邮箱 *',
  '国家 / 地区 *',
  '学校 / 机构 *',
  '当前身份 *',
  '申请会员类别 *',
