---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/PageHero.astro';
import FormSubmitFields from '../../../components/FormSubmitFields.astro';
---
<BaseLayout title="提交咨询" description="全景研究院一般合作咨询表单。">
  <PageHero
    title="提交咨询"
    description="本表格用于一般合作咨询；如咨询涉及特定合作类型，请选择下方专门表格。"
    breadcrumbs={[{ label: "学术合作", href: "/zh-cn/collaboration" }, { label: "提交咨询" }]}
  />

  <section class="section" style="background:var(--bg-white);">
    <div class="container">
      <div style="display:grid;grid-template-columns:1fr 2fr;gap:64px;align-items:start;">
        <div>
          <div class="section-label">专门表格</div>
          <p style="font-size:14px;color:var(--text-muted);line-height:1.6;margin-top:8px;margin-bottom:16px;">
            如果您的咨询涉及特定合作类型，请使用对应专门表格：
          </p>
          <div style="display:flex;flex-direction:column;gap:6px;">
            {[
              { label:"研究项目提案",     href:"/zh-cn/collaboration/research-project-proposal" },
              { label:"主编文集提案",        href:"/zh-cn/collaboration/edited-volume-proposal" },
              { label:"特刊提案",        href:"/zh-cn/collaboration/special-issue-proposal" },
              { label:"访问学者申请",  href:"/zh-cn/collaboration/visiting-scholar-application" },
              { label:"研究员申请",   href:"/zh-cn/collaboration/research-fellow-application" },
              { label:"活动合作",             href:"/zh-cn/collaboration/event-cooperation" },
              { label:"机构合作",     href:"/zh-cn/collaboration/institutional-cooperation" },
            ].map((item) => (
              <a href={item.href} style="display:block;font-size:13.5px;color:var(--accent-steel);padding:8px 0;border-bottom:1px solid var(--border-light);">{item.label} &rarr;</a>
            ))}
          </div>
        </div>
        <div>
          <h2 style="font-family:var(--font-serif);font-size:24px;color:var(--text-main);margin-bottom:16px;font-weight:400;">一般合作咨询</h2>
          <p style="font-size:16px;line-height:1.85;color:var(--text-secondary);margin-bottom:32px;">
            如果您的咨询不完全适用于上述特定合作类型，或希望在提交特定表格前与研究院讨论合作可能性，请使用本表格。合作事务办公室将在 10 个工作日内回复。
          </p>

          <form style="display:flex;flex-direction:column;gap:0;" action="https://formsubmit.co/collaboration@panorama-sg.com" method="POST">
            <FormSubmitFields subject="全景研究院一般合作咨询" source="General Collaboration Inquiry Form" />
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:0;">
              {[
                { label:"您的姓名",       id:"inq-name",  type:"text",  placeholder:"姓名" },
                { label:"电子邮箱地址",   id:"inq-email", name:"email", type:"email", placeholder:"your@email.com" },
                { label:"组织机构",    id:"inq-org",   type:"text",  placeholder:"机构或组织（如适用）" },
                { label:"国家",         id:"inq-country",type:"text", placeholder:"国家" },
              ].map((f) => (
                <div style="padding:12px;border:1px solid var(--border-light);margin:-0.5px;">
                  <label for={f.id} style="display:block;font-size:11px;font-family:var(--font-mono);text-transform:uppercase;letter-spacing:0.1em;color:var(--text-muted);margin-bottom:6px;">{f.label}</label>
                  <input id={f.id} name={f.name ?? f.id} type={f.type} placeholder={f.placeholder} class="form-input" style="width:100%;" />
                </div>
              ))}
            </div>
            <div style="padding:12px;border:1px solid var(--border-light);margin-top:-0.5px;">
              <label for="inq-type" style="display:block;font-size:11px;font-family:var(--font-mono);text-transform:uppercase;letter-spacing:0.1em;color:var(--text-muted);margin-bottom:6px;">咨询类型</label>
              <select id="inq-type" name="inq-type" class="form-input" style="width:100%;">
                <option value="">请选择咨询类型...</option>
                <option>机构合作 / 谅解备忘录</option>
                <option>研究合作</option>
                <option>出版合作</option>
                <option>活动合作</option>
                <option>研究员及学者计划咨询</option>
                <option>媒体 / 新闻咨询</option>
                <option>一般咨询</option>
              </select>
            </div>
            <div style="padding:12px;border:1px solid var(--border-light);margin-top:-0.5px;">
              <label for="inq-msg" style="display:block;font-size:11px;font-family:var(--font-mono);text-transform:uppercase;letter-spacing:0.1em;color:var(--text-muted);margin-bottom:6px;">您的信息</label>
              <textarea id="inq-msg" name="inq-msg" rows="8" placeholder="请说明您的咨询、拟议合作或问题，并尽可能提供相关细节，以便合作事务办公室作出有效回复。" class="form-input" style="width:100%;resize:vertical;"></textarea>
            </div>
            <div style="padding:12px;border:1px solid var(--border-light);margin-top:-0.5px;display:flex;gap:10px;align-items:flex-start;">
              <input type="checkbox" id="inq-consent" name="inq-consent" value="confirmed" style="margin-top:3px;flex-shrink:0;" />
              <label for="inq-consent" style="font-size:13.5px;color:var(--text-secondary);line-height:1.6;">本人同意全景研究院使用所提供信息回复本次咨询，并发送相关机构通信。本人可随时撤回该同意。</label>
            </div>
            <div style="padding:12px;border:1px solid var(--border-light);margin-top:-0.5px;">
              <button type="submit" class="btn btn-primary" style="width:100%;justify-content:center;">提交咨询</button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
<style>
@media (max-width: 900px) {
  div[style*="grid-template-columns:1fr 2fr"] { display: block !important; }
  div[style*="grid-template-columns:1fr 1fr"] { display: block !important; }
}
</style>
