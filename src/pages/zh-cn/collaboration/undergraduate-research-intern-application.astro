---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/PageHero.astro';
import FormSubmitFields from '../../../components/FormSubmitFields.astro';
import MultiAttachmentUpload from '../../../components/MultiAttachmentUpload.astro';
---
<BaseLayout title="本科生研究实习生申请" description="申请全景研究院本科生研究实习生项目。">
  <PageHero
    title="本科生研究实习生申请"
    description="申请加入全景研究院，成为本科生研究实习生。面向对研究院研究领域有真实兴趣的在读本科生开放。"
    breadcrumbs={[{ label: "学术合作", href: "/zh-cn/collaboration" }, { label: "本科生研究实习生申请" }]}
  />

  <section class="section" style="background:var(--bg-white);">
    <div class="container">
      <div style="display:grid;grid-template-columns:1fr 2fr;gap:64px;align-items:start;">
        <div>
          <div class="section-label">项目详情</div>
          <div style="display:flex;flex-direction:column;gap:16px;margin-top:8px;">
            {[
              { label:"时长",        value:"一学期或按项目安排，可续期" },
              { label:"形式",          value:"远程（分布式）" },
              { label:"资格要求",     value:"在读本科生" },
              { label:"申请方式",     value:"滚动申请（无固定截止日期）" },
              { label:"回复时间",   value:"20 个工作日内" },
              { label:"联系",         value:"fellows@panorama-sg.com" },
            ].map((item) => (
              <div>
                <div style="font-size:11px;font-family:var(--font-mono);text-transform:uppercase;letter-spacing:0.1em;color:var(--text-muted);margin-bottom:4px;">{item.label}</div>
                <div style="font-size:14.5px;color:var(--text-main);">{item.value}</div>
              </div>
            ))}
          </div>
          <div style="margin-top:20px;">
            <a href="/zh-cn/people/join" class="btn btn-secondary" style="width:100%;justify-content:center;">关于加入研究院</a>
          </div>
        </div>
        <div>
          <p style="font-size:16px;line-height:1.85;color:var(--text-secondary);margin-bottom:32px;">
            请使用本表格申请全景研究院本科生研究实习生项目。实习生在研究员和研究中心负责人指导下，协助完成文献综述、数据收集、编辑协助等工作。所有申请均由学者项目协调人及相关研究中心负责人评审。
          </p>

          <form style="display:flex;flex-direction:column;gap:0;" action="https://formsubmit.co/fellows@panorama-sg.com" method="POST" enctype="multipart/form-data">
            <FormSubmitFields subject="全景研究院本科生研究实习生申请" source="本科生研究实习生申请表" />
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:0;">
              {([
                { label:"姓名",           id:"ug-name",  type:"text",  placeholder:"姓名" },
                { label:"电子邮箱地址",   id:"ug-email", name:"email", type:"email", placeholder:"your@email.com" },
                { label:"就读院校",       id:"ug-inst",  type:"text",  placeholder:"现就读大学" },
                { label:"年级与专业",     id:"ug-year",  type:"text",  placeholder:"例如：大三，经济学" },
              ] as { label: string; id: string; name?: string; type: 'text' | 'email'; placeholder: string }[]).map((f) => (
                <div style="padding:12px;border:1px solid var(--border-light);margin:-0.5px;">
                  <label for={f.id} style="display:block;font-size:11px;font-family:var(--font-mono);text-transform:uppercase;letter-spacing:0.1em;color:var(--text-muted);margin-bottom:6px;">{f.label}</label>
                  <input id={f.id} name={f.name ?? f.id} type={f.type} placeholder={f.placeholder} class="form-input" style="width:100%;" />
                </div>
              ))}
            </div>
            <div style="padding:12px;border:1px solid var(--border-light);margin-top:-0.5px;">
              <label for="ug-center" style="display:block;font-size:11px;font-family:var(--font-mono);text-transform:uppercase;letter-spacing:0.1em;color:var(--text-muted);margin-bottom:6px;">首选研究中心</label>
              <select id="ug-center" name="ug-center" class="form-input" style="width:100%;">
                <option value="">请选择研究中心...</option>
                <option>学术出版研究中心</option>
                <option>学术索引与评价研究中心</option>
                <option>政策与社会研究中心</option>
                <option>人工智能与未来社会研究中心</option>
                <option>艺术、文化与具身研究中心</option>
                <option>健康与医学研究中心</option>
                <option>接受建议</option>
              </select>
            </div>
            <div style="padding:12px;border:1px solid var(--border-light);margin-top:-0.5px;">
              <label for="ug-motivation" style="display:block;font-size:11px;font-family:var(--font-mono);text-transform:uppercase;letter-spacing:0.1em;color:var(--text-muted);margin-bottom:6px;">申请动机与研究兴趣（200–500 词）</label>
              <textarea id="ug-motivation" name="ug-motivation" rows="8" placeholder="请说明您对研究院研究领域的兴趣、申请实习的原因，以及希望从中学习或作出的贡献。" class="form-input" style="width:100%;resize:vertical;"></textarea>
            </div>
            <div style="padding:12px;border:1px solid var(--border-light);margin-top:-0.5px;">
              <label for="ug-experience" style="display:block;font-size:11px;font-family:var(--font-mono);text-transform:uppercase;letter-spacing:0.1em;color:var(--text-muted);margin-bottom:6px;">相关课程或经历（不超过 300 词）</label>
              <textarea id="ug-experience" name="ug-experience" rows="5" placeholder="与研究方法相关的课程、以往参与的项目、语言能力或其他与本实习相关的经历。" class="form-input" style="width:100%;resize:vertical;"></textarea>
            </div>
            <div style="padding:12px;border:1px solid var(--border-light);margin-top:-0.5px;">
              <MultiAttachmentUpload
                id="ug-attachments"
                label="申请附件"
                description="请上传简历，以及可选的成绩单或推荐信，可使用 PDF、Word、图片或 ZIP 文件。最多可上传 5 个文件，总大小请勿超过 10MB。如需发送超过 5 个文件，请直接发送邮件至 fellows@panorama-sg.com。"
                accept=".pdf,.doc,.docx,.zip,.png,.jpg,.jpeg"
              />
            </div>
            <div style="padding:12px;border:1px solid var(--border-light);margin-top:-0.5px;display:flex;gap:10px;align-items:flex-start;">
              <input type="checkbox" id="ug-consent" name="ug-consent" value="confirmed" style="margin-top:3px;flex-shrink:0;" />
              <label for="ug-consent" style="font-size:13.5px;color:var(--text-secondary);line-height:1.6;">本人确认目前为在读本科生，且以上所提供信息真实准确。</label>
            </div>
            <div style="padding:12px;border:1px solid var(--border-light);margin-top:-0.5px;">
              <button type="submit" class="btn btn-primary" style="width:100%;justify-content:center;">提交申请</button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
<style>
@media (max-width: 900px) {
  div[style*="grid-template-columns:1fr 2fr"] { display: block !important; }
  div[style*="grid-template-columns:1fr 1fr"] { display: block !important; }
}
</style>
