---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/PageHero.astro';
import FormSubmitFields from '../../../components/FormSubmitFields.astro';
import MultiAttachmentUpload from '../../../components/MultiAttachmentUpload.astro';
---
<BaseLayout title="访问学者申请" description="申请全景研究院访问学者项目。">
  <PageHero
    title="访问学者申请"
    description="申请以访问学者身份与全景研究院建立 3–12 个月的隶属关系。访问学者计划面向具有博士或同等资历的成熟研究者开放。"
    breadcrumbs={[{ label: "学术合作", href: "/zh-cn/collaboration" }, { label: "访问学者申请" }]}
  />

  <section class="section" style="background:var(--bg-white);">
    <div class="container">
      <div style="display:grid;grid-template-columns:1fr 2fr;gap:64px;align-items:start;">
        <div>
          <div class="section-label">项目信息</div>
          <div style="display:flex;flex-direction:column;gap:16px;margin-top:8px;">
            {[
              { label:"时长",        value:"3–12 个月" },
              { label:"形式",          value:"远程或线下" },
              { label:"申请资格",     value:"博士或同等资历的成熟研究者" },
              { label:"申请",     value:"滚动申请（无固定截止日期）" },
              { label:"回复时间",   value:"15 个工作日内" },
              { label:"联系",         value:"scholars@panorama-sg.com" },
            ].map((item) => (
              <div>
                <div style="font-size:11px;font-family:var(--font-mono);text-transform:uppercase;letter-spacing:0.1em;color:var(--text-muted);margin-bottom:4px;">{item.label}</div>
                <div style="font-size:14.5px;color:var(--text-main);">{item.value}</div>
              </div>
            ))}
          </div>
          <div style="margin-top:20px;">
            <a href="/zh-cn/people/visiting-scholars" class="btn btn-secondary" style="width:100%;justify-content:center;">关于项目</a>
          </div>
        </div>
        <div>
          <p style="font-size:16px;line-height:1.85;color:var(--text-secondary);margin-bottom:32px;">
            请使用本表格申请以访问学者身份与全景研究院建立隶属关系。申请由学者计划协调员和相关研究中心主任评审。成功申请者将被联系，以讨论访问隶属的条款和范围。
          </p>

          <form style="display:flex;flex-direction:column;gap:0;" action="https://formsubmit.co/scholars@panorama-sg.com" method="POST" enctype="multipart/form-data">
            <FormSubmitFields subject="全景研究院访问学者申请" source="访问学者申请表" />
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:0;">
              {([
                { label:"姓名",      id:"vs-name",    type:"text",  placeholder:"姓名" },
                { label:"电子邮箱地址",  id:"vs-email",   name:"email", type:"email", placeholder:"your@email.com" },
                { label:"当前所属机构", id:"vs-inst", type:"text", placeholder:"大学或研究机构" },
                { label:"职位 / 头衔", id:"vs-title",   type:"text",  placeholder:"例如：高级讲师" },
              ] as { label: string; id: string; name?: string; type: 'text' | 'email'; placeholder: string }[]).map((f) => (
                <div style="padding:12px;border:1px solid var(--border-light);margin:-0.5px;">
                  <label for={f.id} style="display:block;font-size:11px;font-family:var(--font-mono);text-transform:uppercase;letter-spacing:0.1em;color:var(--text-muted);margin-bottom:6px;">{f.label}</label>
                  <input id={f.id} name={f.name ?? f.id} type={f.type} placeholder={f.placeholder} class="form-input" style="width:100%;" />
                </div>
              ))}
            </div>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:0;margin-top:-0.5px;">
              {([
                { label:"拟议开始日期", id:"vs-start", type:"text", placeholder:"例如：2026 年 1 月" },
                { label:"拟议时长",   id:"vs-dur",   type:"text", placeholder:"例如：6 个月" },
              ] as const).map((f) => (
                <div style="padding:12px;border:1px solid var(--border-light);margin:-0.5px;">
                  <label for={f.id} style="display:block;font-size:11px;font-family:var(--font-mono);text-transform:uppercase;letter-spacing:0.1em;color:var(--text-muted);margin-bottom:6px;">{f.label}</label>
                  <input id={f.id} name={f.id} type={f.type} placeholder={f.placeholder} class="form-input" style="width:100%;" />
                </div>
              ))}
            </div>
            <div style="padding:12px;border:1px solid var(--border-light);margin-top:-0.5px;">
              <label for="vs-center" style="display:block;font-size:11px;font-family:var(--font-mono);text-transform:uppercase;letter-spacing:0.1em;color:var(--text-muted);margin-bottom:6px;">首选接待研究中心</label>
              <select id="vs-center" name="vs-center" class="form-input" style="width:100%;">
                <option value="">请选择研究中心...</option>
                <option>学术出版研究中心</option>
                <option>学术索引与评价研究中心</option>
                <option>政策与社会研究中心</option>
                <option>人工智能与未来社会研究中心</option>
                <option>艺术、文化与具身研究中心</option>
                <option>接受建议</option>
              </select>
            </div>
            <div style="padding:12px;border:1px solid var(--border-light);margin-top:-0.5px;">
              <label for="vs-research" style="display:block;font-size:11px;font-family:var(--font-mono);text-transform:uppercase;letter-spacing:0.1em;color:var(--text-muted);margin-bottom:6px;">研究计划与目标（300–800 词）</label>
              <textarea id="vs-research" name="vs-research" rows="8" placeholder="请说明您在访问期间拟开展的研究、其与研究院研究项目的关系，以及任何具体合作或成果计划。" class="form-input" style="width:100%;resize:vertical;"></textarea>
            </div>
            <div style="padding:12px;border:1px solid var(--border-light);margin-top:-0.5px;">
              <label for="vs-cv" style="display:block;font-size:11px;font-family:var(--font-mono);text-transform:uppercase;letter-spacing:0.1em;color:var(--text-muted);margin-bottom:6px;">学术简介 / 简历摘要（不超过 400 词）</label>
              <textarea id="vs-cv" name="vs-cv" rows="5" placeholder="学术简介、主要出版物和其他相关经历。" class="form-input" style="width:100%;resize:vertical;"></textarea>
            </div>
            <div style="padding:12px;border:1px solid var(--border-light);margin-top:-0.5px;">
              <MultiAttachmentUpload
                id="vs-attachments"
                label="申请附件"
                description="请上传您的简历、出版物清单或其他支持材料，可使用 PDF、Word、图片或 ZIP 文件。最多可上传 5 个文件，总大小请勿超过 10MB。如需发送超过 5 个文件，请直接发送邮件至 scholars@panorama-sg.com。"
                accept=".pdf,.doc,.docx,.zip,.png,.jpg,.jpeg"
              />
            </div>
            <div style="padding:12px;border:1px solid var(--border-light);margin-top:-0.5px;display:flex;gap:10px;align-items:flex-start;">
              <input type="checkbox" id="vs-consent" name="vs-consent" value="confirmed" style="margin-top:3px;flex-shrink:0;" />
              <label for="vs-consent" style="font-size:13.5px;color:var(--text-secondary);line-height:1.6;">本人确认上述信息准确，并真诚希望在拟议访问期间开展所述研究。</label>
            </div>
            <div style="padding:12px;border:1px solid var(--border-light);margin-top:-0.5px;">
              <button type="submit" class="btn btn-primary" style="width:100%;justify-content:center;">提交申请</button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
<style>
@media (max-width: 900px) {
  div[style*="grid-template-columns:1fr 2fr"] { display: block !important; }
  div[style*="grid-template-columns:1fr 1fr"] { display: block !important; }
}
</style>
