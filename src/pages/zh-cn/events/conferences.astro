---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/PageHero.astro';
---
<BaseLayout title="学术会议" description="由全景研究院主办或联合主办的学术会议。">
  <PageHero
    title="学术会议"
    description="全景研究院主办和联合主办的学术会议，汇集研究院相关领域的学者、政策制定者和实践者。"
    breadcrumbs={[{ label: "学术活动", href: "/zh-cn/events" }, { label: "学术会议" }]}
  />

  <section class="section" style="background:var(--bg-white);">
    <div class="container">
      <div style="max-width:860px;">
        <p style="font-size:16px;line-height:1.85;color:var(--text-secondary);margin-bottom:40px;">
          全景研究院计划发展国际会议项目，围绕学术出版、期刊评价、学术政策和新兴数字未来等核心研究主题展开。研究院首个主办会议计划于 2026 年举行。
        </p>

        <div style="margin-bottom:48px;padding:32px;background:var(--bg-soft);border:1px solid var(--border-light);">
          <div style="font-family:var(--font-mono);font-size:11px;letter-spacing:0.1em;text-transform:uppercase;color:var(--text-muted);margin-bottom:12px;">即将开展——规划阶段</div>
          <h2 style="font-family:var(--font-serif);font-size:24px;color:var(--text-main);margin-bottom:12px;font-weight:400;">首届全景学术传播国际会议</h2>
          <p style="font-size:15px;color:var(--text-secondary);line-height:1.7;margin-bottom:20px;">
            研究院首届关于学术传播、学术出版和开放科学的国际会议处于早期规划阶段。会议将汇集亚太地区及其他地区的研究人员、编辑、出版商、图书馆员和政策制定者。
          </p>
          <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin-bottom:20px;">
            {[
              { label:"计划日期", value:"2026 年（待定）" },
              { label:"形式", value:"线下 + 线上（混合形式）" },
              { label:"地点", value:"待公布" },
            ].map((item) => (
              <div>
                <div style="font-size:11px;font-family:var(--font-mono);text-transform:uppercase;letter-spacing:0.1em;color:var(--text-muted);margin-bottom:4px;">{item.label}</div>
                <div style="font-size:14.5px;color:var(--text-main);">{item.value}</div>
              </div>
            ))}
          </div>
          <a href="/zh-cn/events/calls-for-papers" class="btn btn-primary">登记意向</a>
        </div>

        <h2 style="font-family:var(--font-serif);font-size:22px;color:var(--text-main);margin-bottom:16px;font-weight:400;">会议联合主办</h2>
        <p style="font-size:16px;line-height:1.85;color:var(--text-secondary);margin-bottom:20px;">
          研究院欢迎与伙伴机构联合主办学术会议。联合主办会议使研究院能够为符合其使命的活动贡献研究专长和机构支持，同时服务更广泛的学术共同体。会议联合主办咨询请联系合作事务办公室。
        </p>
        <div style="display:flex;gap:10px;flex-wrap:wrap;margin-top:24px;">
          <a href="/zh-cn/collaboration/event-cooperation" class="btn btn-primary">联合主办会议</a>
          <a href="/zh-cn/events/calls-for-papers" class="btn btn-secondary">论文征稿</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
<style>
@media (max-width: 768px) {
  div[style*="grid-template-columns:repeat(3,1fr)"] { display: block !important; }
}
</style>
