---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/PageHero.astro';
---
<BaseLayout title="工作坊" description="全景研究院组织的学术工作坊。">
  <PageHero
    title="工作坊"
    description="全景研究院组织的专题学术工作坊，为研究人员推进进行中的研究并讨论方法和概念问题提供密集、参与式环境。"
    breadcrumbs={[{ label: "学术活动", href: "/zh-cn/events" }, { label: "工作坊" }]}
  />

  <section class="section" style="background:var(--bg-white);">
    <div class="container">
      <div style="max-width:860px;">
        <p style="font-size:16px;line-height:1.85;color:var(--text-secondary);margin-bottom:48px;">
          全景研究院计划将学术工作坊作为活动日程的一部分。工作坊规模小于会议或研讨会，强度更高，通常聚焦具体研究问题或方法挑战。其设计强调参与性和产出导向，为研究人员在同行结构化反馈下推进进行中的工作提供空间。
        </p>

        <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:var(--border-light);border:1px solid var(--border-light);margin-bottom:48px;">
          {[
            { type:"研究工作坊",   desc:"围绕特定研究主题的小型研究人员聚会，用于推进进行中的工作、测试框架和交流方法。" },
            { type:"编辑工作坊",  desc:"面向期刊编辑和出版社的工作坊，聚焦编辑实践、出版伦理、同行评审管理和标准。" },
            { type:"写作工作坊",    desc:"面向早期职业研究者的密集写作工作坊，聚焦学术写作、发表策略和学术传播。" },
          ].map((item) => (
            <div class="card" style="border:none;border-radius:0;">
              <h3 style="font-family:var(--font-sans);font-size:15px;font-weight:600;color:var(--text-main);margin-bottom:10px;">{item.type}</h3>
              <p style="font-size:14px;line-height:1.7;color:var(--text-secondary);">{item.desc}</p>
            </div>
          ))}
        </div>

        <div style="padding:32px;background:var(--bg-soft);border:1px solid var(--border-light);margin-bottom:40px;">
          <div style="font-family:var(--font-mono);font-size:11px;letter-spacing:0.1em;text-transform:uppercase;color:var(--text-muted);margin-bottom:12px;">项目状态</div>
          <p style="font-size:15px;color:var(--text-secondary);line-height:1.7;margin:0;">
            研究院工作坊项目正在规划中。首个研究院组织的工作坊计划于 2026 年举行。请参阅 <a href="/zh-cn/events/training-programs" style="color:var(--accent-steel);">培训项目</a> 页面了解研究院当前能力建设活动。
          </p>
        </div>

        <h2 style="font-family:var(--font-serif);font-size:22px;color:var(--text-main);margin-bottom:14px;font-weight:400;">提出工作坊提案</h2>
        <p style="font-size:16px;line-height:1.85;color:var(--text-secondary);margin-bottom:24px;">
          有意与全景研究院联合组织工作坊的研究人员和机构可提交提案。成功提案将获得机构支持、活动协调协助，并可能获得研究院品牌使用支持和工作坊成果出版机会。
        </p>
        <div style="display:flex;gap:10px;flex-wrap:wrap;">
          <a href="/zh-cn/collaboration/event-cooperation" class="btn btn-primary">提交工作坊提案</a>
          <a href="/zh-cn/events/training-programs" class="btn btn-secondary">培训项目</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
<style>
@media (max-width: 768px) {
  div[style*="grid-template-columns:repeat(3,1fr)"] { display: block !important; }
}
</style>
