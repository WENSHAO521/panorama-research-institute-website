---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/PageHero.astro';
---
<BaseLayout title="修订程序" description="全景研究院章程及治理文件的修订程序。">
  <PageHero
    title="修订程序"
    description="提出、审查、批准和实施研究院章程及治理政策修订的程序。"
    breadcrumbs={[{ label: "治理", href: "/zh-cn/charter" }, { label: "修订程序" }]}
    tag="治理文件"
  />
  <section class="section" style="background:var(--bg-main);">
    <div class="container">
      <div style="max-width:760px;">
        {[
          { step: "1", title: "提交修订提案", body: "研究院领导层、关联研究者或全景学术集团均可提出研究院章程或治理政策修订。提案须以书面形式提交，并说明拟议修订内容及其理由。" },
          { step: "2", title: "审查期", body: "拟议修订须经过不少于 30 天的审查期，期间应送交全体研究中心主任及顾问委员会征求意见，其他相关利益方也可提交意见或异议。作出通过决定前应当审议所收到的意见，但该等意见不具有约束力。" },
          { step: "3", title: "批准", body: "研究院章程修订由研究院院长作出，并须经全景学术集团批准。附属治理文件，包括本治理规则及各项政策，可由研究院院长采纳、修订或替换，无需正式修订章程，前提是其不与章程冲突。批准须以书面形式记录。" },
          { step: "4", title: "实施", body: "已批准修订自通过之日起生效，但批准文件另行规定较后生效日期的除外。章程封面载明版本号及生效日期。" },
          { step: "5", title: "发布", body: "修订获批后，应尽快在研究院网站上发布。研究院办公室保存章程和治理文件的完整版本记录，在研究院网站公布每一已通过的版本，并将每一被取代的版本原样保留并向公众公开。" },
          { step: "6", title: "解释", body: "研究院院长对章程及治理文件拥有最终解释权。出现歧义时，应优先采用最符合本院使命的解释；如发生冲突，以章程为准，高于任何附属治理文件。解释应予记录，并酌情公布。" },
        ].map((s) => (
          <div style="display:grid;grid-template-columns:48px 1fr;gap:20px;margin-bottom:36px;padding-bottom:36px;border-bottom:1px solid var(--border-light);">
            <div style="font-family:var(--font-mono);font-size:28px;color:var(--border-medium);font-weight:700;line-height:1;">{s.step}</div>
            <div>
              <h2 style="font-family:var(--font-serif);font-size:22px;color:var(--text-main);margin-bottom:12px;font-weight:400;">{s.title}</h2>
              <p style="font-size:15.5px;line-height:1.8;color:var(--text-secondary);">{s.body}</p>
            </div>
          </div>
        ))}
        <a href="/zh-cn/charter" class="btn btn-primary">返回章程</a>
      </div>
    </div>
  </section>
</BaseLayout>
