---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/PageHero.astro';
---
<BaseLayout title="加入研究院" description="如何以研究员、副研究员、访问学者或研究助理身份加入全景研究院。">
  <PageHero
    title="加入研究院"
    description="全景研究院欢迎希望通过研究员、访问学者或研究助理角色参与研究院研究项目的学者和研究人员申请。"
    breadcrumbs={[{ label: "学术成员", href: "/zh-cn/people" }, { label: "加入研究院" }]}
  />

  <section class="section" style="background:var(--bg-white);">
    <div class="container">
      <p style="font-size:16px;line-height:1.85;color:var(--text-secondary);max-width:720px;margin-bottom:48px;">
        研究院在基础建设阶段正在积极建设学术共同体。我们欢迎各职业阶段、从事研究院相关领域工作的研究人员申请，共同建设严谨、协作且独立的研究环境。
      </p>

      <div style="display:grid;grid-template-columns:repeat(2,1fr);gap:1px;background:var(--border-light);border:1px solid var(--border-light);">
        {[
          {
            role:   "研究员",
            target: "具有博士学位或同等资历的中高级职业阶段研究者",
            commit: "每年至少 1 项出版成果；参加研究院活动",
            format: "远程（分布式）——无需搬迁",
            duration:"1–3 年，可续期",
            href:   "/zh-cn/collaboration/research-fellow-application",
            cta:    "申请研究员",
          },
          {
            role:   "副研究员",
            target: "博士生与早期职业研究者",
            commit: "积极参与研究院项目",
            format: "远程（分布式）",
            duration:"1 年，可续期",
            href:   "/zh-cn/collaboration/research-fellow-application",
            cta:    "申请副研究员",
          },
          {
            role:   "青年研究员",
            target: "博士后或早期职业研究者，通常为博士毕业五年以内",
            commit: "每两年至少 1 项出版成果；积极参加研究院活动",
            format: "远程（分布式）——无需搬迁",
            duration:"1–2 年，可续期",
            href:   "/zh-cn/collaboration/research-fellow-application",
            cta:    "申请青年研究员",
          },
          {
            role:   "兼职研究员",
            target: "在其他机构或单位担任主要学术或专业职务的研究人员",
            commit: "成果要求相应减少或按项目计算；参与部分研究院活动",
            format: "远程（分布式），时间安排灵活",
            duration:"1 年，可续期",
            href:   "/zh-cn/collaboration/research-fellow-application",
            cta:    "申请兼职研究员",
          },
          {
            role:   "访问学者",
            target: "来自其他机构的成熟研究者（博士或同等资历）",
            commit: "在隶属期间积极开展研究贡献",
            format: "远程或线下（3–12 个月）",
            duration:"3–12 个月",
            href:   "/zh-cn/collaboration/visiting-scholar-application",
            cta:    "申请访问学者",
          },
          {
            role:   "研究助理",
            target: "具有研究经验的硕士/博士生或近期毕业生",
            commit: "在研究员指导下承担项目特定任务",
            format: "远程（分布式）",
            duration:"按项目安排",
            href:   "/zh-cn/people/research-assistants",
            cta:    "立即申请",
          },
          {
            role:   "本科生研究实习生",
            target: "对研究院研究领域有真实兴趣的在读本科生",
            commit: "在指导下承担文献综述、数据收集、编辑协助等支持性工作",
            format: "远程（分布式）",
            duration:"一学期或按项目安排，可续期",
            href:   "/zh-cn/collaboration/research-fellow-application",
            cta:    "申请本科生实习",
          },
        ].map((item) => (
          <div class="card" style="border:none;border-radius:0;display:flex;flex-direction:column;justify-content:space-between;">
            <div>
              <h2 style="font-family:var(--font-serif);font-size:22px;color:var(--text-main);margin-bottom:20px;font-weight:400;">{item.role}</h2>
              <div style="display:flex;flex-direction:column;gap:14px;margin-bottom:24px;">
                {[
                  { label:"适合对象", value:item.target },
                  { label:"承诺",   value:item.commit },
                  { label:"形式",       value:item.format },
                  { label:"时长",     value:item.duration },
                ].map((d) => (
                  <div>
                    <div style="font-size:11px;font-family:var(--font-mono);text-transform:uppercase;letter-spacing:0.1em;color:var(--text-muted);margin-bottom:3px;">{d.label}</div>
                    <div style="font-size:14px;color:var(--text-secondary);">{d.value}</div>
                  </div>
                ))}
              </div>
            </div>
            <a href={item.href} class="btn btn-primary" style="margin-top:auto;">{item.cta}</a>
          </div>
        ))}
      </div>

      <div style="margin-top:48px;padding:32px;background:var(--bg-soft);border:1px solid var(--border-light);max-width:720px;">
        <div style="font-size:11px;font-family:var(--font-mono);text-transform:uppercase;letter-spacing:0.1em;color:var(--text-muted);margin-bottom:10px;">受邀任命</div>
        <h2 style="font-family:var(--font-serif);font-size:22px;color:var(--text-main);margin-bottom:12px;font-weight:400;">特聘研究员</h2>
        <p style="font-size:15px;line-height:1.8;color:var(--text-secondary);margin-bottom:20px;">
          特聘研究员是一项荣誉任命，用于表彰在学术上有杰出成就、并对研究院研究领域有持续贡献的资深学者。特聘研究员由学术委员会及研究院负责人受邀任命，不通过上述公开申请流程产生。希望获得考虑的资深学者可直接联系研究院。
        </p>
        <a href="/zh-cn/contact" class="btn btn-secondary">联系研究院</a>
      </div>

      <div style="margin-top:32px;max-width:720px;">
        <h2 style="font-family:var(--font-serif);font-size:22px;color:var(--text-main);margin-bottom:14px;font-weight:400;">研究院提供</h2>
        <div style="display:flex;flex-direction:column;gap:4px;">
          {[
            "全景研究院正式机构隶属",
            "研究院工作论文、报告和政策简报系列的出版支持",
            "进入研究院学术共同体、网络和资源体系",
            "参与研究院组织的研讨会、工作坊和会议",
            "共同署名与合作研究机会",
            "致力于学术独立和诚信的研究环境",
          ].map((item) => (
            <div style="display:flex;gap:10px;font-size:15px;color:var(--text-secondary);padding:8px 0;border-bottom:1px solid var(--bg-main);">
              <span style="color:var(--text-muted);flex-shrink:0;">&#8212;</span>{item}
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
<style>
@media (max-width: 768px) {
  div[style*="grid-template-columns:repeat(2,1fr)"] { display: block !important; }
}
</style>
