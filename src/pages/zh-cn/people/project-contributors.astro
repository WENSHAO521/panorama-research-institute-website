---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/PageHero.astro';
---
<BaseLayout title="项目贡献者" description="为全景研究院具体项目作出贡献的学者。">
  <PageHero
    title="项目贡献者"
    description="未持有研究院正式隶属身份，但为全景研究院具体研究项目、出版成果或活动作出贡献的学者和实践者。"
    breadcrumbs={[{ label: "学术成员", href: "/zh-cn/people" }, { label: "项目贡献者" }]}
  />

  <section class="section" style="background:var(--bg-white);">
    <div class="container">
      <div style="max-width:820px;">
        <p style="font-size:16px;line-height:1.85;color:var(--text-secondary);margin-bottom:40px;">
          项目贡献者是为全景研究院具体研究项目、出版成果或活动作出贡献的学者、实践者和专家。他们在项目层面贡献专业知识，但不持有研究院正式研究员或访问隶属身份。其贡献将在相关项目和出版记录中予以确认。
        </p>

        <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:var(--border-light);border:1px solid var(--border-light);margin-bottom:40px;">
          {[
            { type:"研究贡献者",    desc:"为具体研究项目贡献数据、分析或智识投入的学者，通常作为共同作者或致谢贡献者。" },
            { type:"章节作者",          desc:"为研究院组织或联合出版的主编文集撰写章节、但不与研究院建立更广泛隶属关系的作者。" },
            { type:"活动参与者",       desc:"为研究院活动作出贡献的演讲者、圆桌嘉宾和工作坊参与者。其个人简介可列入活动记录。" },
          ].map((item) => (
            <div class="card" style="border:none;border-radius:0;">
              <h3 style="font-family:var(--font-sans);font-size:15px;font-weight:600;color:var(--text-main);margin-bottom:10px;">{item.type}</h3>
              <p style="font-size:14px;line-height:1.7;color:var(--text-secondary);">{item.desc}</p>
            </div>
          ))}
        </div>

        <div style="padding:24px;background:var(--bg-soft);border:1px solid var(--border-light);margin-bottom:32px;">
          <div style="font-family:var(--font-mono);font-size:11px;letter-spacing:0.08em;text-transform:uppercase;color:var(--text-muted);margin-bottom:8px;">当前贡献者</div>
          <p style="font-size:14.5px;color:var(--text-secondary);margin:0;line-height:1.7;">
            研究院目前处于基础建设阶段。随着研究院研究成果完成，具体项目贡献者将在本页及相关项目和出版记录中列出。
          </p>
        </div>

        <h2 style="font-family:var(--font-serif);font-size:22px;color:var(--text-main);margin-bottom:14px;font-weight:400;">参与项目</h2>
        <p style="font-size:15.5px;line-height:1.85;color:var(--text-secondary);margin-bottom:24px;">
          有意为研究院具体项目作出贡献的研究人员和实践者，应联系该项目牵头研究中心。根据项目需要，贡献形式可包括共同作者、数据贡献、同行评审、活动参与或其他形式。
        </p>
        <div style="display:flex;gap:10px;flex-wrap:wrap;">
          <a href="/zh-cn/projects/current" class="btn btn-primary">查看当前项目</a>
          <a href="/zh-cn/collaboration" class="btn btn-secondary">学术合作</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
<style>
@media (max-width: 768px) {
  div[style*="grid-template-columns:repeat(3,1fr)"] { grid-template-columns: repeat(2,1fr) !important; }
}
@media (max-width: 500px) {
  div[style*="grid-template-columns:repeat(2,1fr)"] { display: block !important; }
}
</style>
