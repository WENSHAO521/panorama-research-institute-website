---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/PageHero.astro';
---
<BaseLayout title="青年研究员" description="全景研究院青年研究员。">
  <PageHero
    title="青年研究员"
    description="青年研究员通道面向博士后及早期职业研究者，支持其在全景研究院的项目中建立独立研究方向。"
    breadcrumbs={[{ label: "学术成员", href: "/zh-cn/people" }, { label: "青年研究员" }]}
  />

  <section class="section" style="background:var(--bg-white);">
    <div class="container">
      <div style="display:grid;grid-template-columns:1fr 2fr;gap:64px;align-items:start;">
        <div>
          <div class="section-label">岗位详情</div>
          <div style="display:flex;flex-direction:column;gap:16px;margin-top:8px;">
            {[
              { label:"头衔",     value:"全景研究院青年研究员" },
              { label:"适合对象", value:"博士后或早期职业研究者，博士毕业五年以内" },
              { label:"期限",     value:"1–2 年，可续期" },
              { label:"形式",     value:"远程（分布式）——无需搬迁" },
              { label:"成果要求", value:"每两年至少 1 项出版成果" },
              { label:"申请方式", value:"开放申请（滚动）" },
            ].map((item) => (
              <div>
                <div style="font-size:11px;font-family:var(--font-mono);text-transform:uppercase;letter-spacing:0.1em;color:var(--text-muted);margin-bottom:4px;">{item.label}</div>
                <div style="font-size:14.5px;color:var(--text-main);">{item.value}</div>
              </div>
            ))}
          </div>
          <div style="margin-top:28px;display:flex;flex-direction:column;gap:8px;">
            <a href="/zh-cn/collaboration/research-fellow-application" class="btn btn-primary" style="width:100%;justify-content:center;">立即申请</a>
            <a href="/zh-cn/people/research-fellows" class="btn btn-secondary" style="width:100%;justify-content:center;">研究员</a>
          </div>
        </div>
        <div>
          <h2 style="font-family:var(--font-serif);font-size:24px;color:var(--text-main);margin-bottom:16px;font-weight:400;">关于青年研究员</h2>
          <p style="font-size:16px;line-height:1.85;color:var(--text-secondary);margin-bottom:20px;">
            青年研究员岗位面向博士后及早期职业研究者，通常为博士毕业五年以内、已确立独立研究方向并希望与全景研究院建立联系的学者。青年研究员定位介于副研究员与研究员之间，认可那些已完成博士训练但尚未进入中级职业阶段的学者。
          </p>
          <p style="font-size:16px;line-height:1.85;color:var(--text-secondary);margin-bottom:32px;">
            青年研究员参与研究院的研究项目、参加研究院活动，并按早期职业研究者相应的节奏在研究院项目框架内发表成果。持续贡献者可被考虑晋升为研究员。
          </p>

          <div style="padding:24px;background:var(--bg-soft);border:1px solid var(--border-light);">
            <div style="font-family:var(--font-mono);font-size:11px;letter-spacing:0.08em;text-transform:uppercase;color:var(--text-muted);margin-bottom:8px;">当前团队</div>
            <div style="padding-bottom:16px;border-bottom:1px solid var(--border-light);">
              <h3 style="font-family:var(--font-sans);font-size:16px;font-weight:600;color:var(--text-main);margin-bottom:4px;">张碧如 博士</h3>
              <div style="font-size:13px;color:var(--text-muted);margin-bottom:8px;">全景研究院青年研究员</div>
              <p style="font-size:14.5px;color:var(--text-secondary);margin:0;line-height:1.7;">研究方向：舞蹈教育；美育研究；民族舞蹈文化传承；跨文化艺术比较。</p>
            </div>
            <p style="font-size:14.5px;color:var(--text-secondary);margin:16px 0 0;line-height:1.7;">
              研究院持续为青年研究员通道接受滚动申请。获聘研究员将在任命后列于本页面。
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
<style>
@media (max-width: 900px) {
  div[style*="grid-template-columns:1fr 2fr"] { display: block !important; }
}
</style>
