---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/PageHero.astro';
---
<BaseLayout title="人工智能与未来社会研究项目" description="人工智能与未来社会研究中心的首个研究项目，探讨人工智能治理、伦理及其对学术传播的影响。">
  <PageHero
    title="人工智能与未来社会研究项目"
    description="一项创始研究项目，考察人工智能的治理、伦理和社会影响，重点关注人工智能对学术传播、知识生产和学术出版的影响。"
    breadcrumbs={[{ label: "研究", href: "/zh-cn/research-areas" }, { label: "项目", href: "/zh-cn/projects" }, { label: "人工智能与未来社会" }]}
    tag="开发中"
  >
  </PageHero>

  <section class="section" style="background:var(--bg-white);">
    <div class="container">
      <div style="display:grid;grid-template-columns:1fr 2fr;gap:64px;align-items:start;">
        <div>
          <div class="section-label">项目详情</div>
          <div style="display:flex;flex-direction:column;gap:20px;margin-top:8px;">
            {[
              { label: "状态",       value: "开发中" },
              { label: "已发布",    value: "2026" },
              { label: "牵头中心",  value: "人工智能与未来社会研究中心" },
              { label: "中心状态","": "", value: "即将开展（预计 2027 年）" },
              { label: "项目类型", value: "跨学科研究" },
              { label: "联系",      value: "research@panorama-sg.com" },
            ].map((item) => (
              <div>
                <div style="font-size:11px;font-family:var(--font-mono);text-transform:uppercase;letter-spacing:0.1em;color:var(--text-muted);margin-bottom:4px;">{item.label}</div>
                <div style="font-size:14.5px;color:var(--text-main);">{item.value}</div>
              </div>
            ))}
          </div>
          <div style="margin-top:32px;display:flex;flex-direction:column;gap:8px;">
            <a href="/zh-cn/research-centers/ai-future-society" class="btn btn-primary" style="justify-content:center;">牵头中心</a>
            <a href="/zh-cn/collaboration/research-project-proposal" class="btn btn-secondary" style="justify-content:center;">合作</a>
          </div>
        </div>
        <div>
          <div style="background:var(--bg-soft);border:1px solid var(--border-light);padding:20px 24px;margin-bottom:28px;">
            <div style="font-family:var(--font-mono);font-size:11px;letter-spacing:0.1em;text-transform:uppercase;color:var(--accent-steel);margin-bottom:8px;">项目状态</div>
            <p style="font-size:14px;color:var(--text-secondary);margin:0;line-height:1.6;">本项目目前处于初步规划和范围界定阶段。牵头研究中心“人工智能与未来社会研究中心”预计于 2026 年正式设立。有意参与本项目的研究人员可联系研究院。</p>
          </div>
          <h2 style="font-family:var(--font-serif);font-size:28px;color:var(--text-main);margin-bottom:20px;font-weight:400;">关于项目</h2>
          <p style="font-size:16px;line-height:1.85;color:var(--text-secondary);margin-bottom:20px;">
            人工智能与未来社会研究项目是人工智能与未来社会研究中心的创始项目，关注人工智能作为技术、治理挑战和社会现象，如何重塑人类制度、知识体系和未来。
          </p>
          <p style="font-size:16px;line-height:1.85;color:var(--text-secondary);margin-bottom:20px;">
            本项目范围涵盖三个相互交叉的主题：人工智能治理（人工智能系统如何在机构、国家和国际层面受到监管、问责和治理）；人工智能伦理（人工智能发展的规范维度，包括公平性、透明度、隐私和自主性）；以及学术中的人工智能（人工智能系统如何融入学术研究、出版与传播，以及这种融入带来的治理挑战）。
          </p>
          <p style="font-size:16px;line-height:1.85;color:var(--text-secondary);">
            本项目采取明确的跨学科方法，汇集技术研究、政治学、哲学、传播学和信息科学等领域的研究人员，旨在形成兼具学术严谨性和政策相关性的研究成果。
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section" style="background:var(--bg-main);border-top:1px solid var(--border-light);">
    <div class="container">
      <div class="section-label">研究议程</div>
      <h2 class="section-title">核心研究问题</h2>
      <div style="max-width:820px;margin-top:8px;">
        {[
          { q: "不同国家和机构情境中如何治理和监管人工智能系统？治理差异会带来哪些影响？" },
          { q: "对于部署在公共和学术情境中的人工智能系统，何种伦理框架最适合评估其公平性、透明度和问责性？" },
          { q: "人工智能融入学术出版，包括 AI 生成文本、AI 辅助同行评审和 AI 编辑工具，正在如何重塑学术传播规范与实践？" },
          { q: "需要何种治理框架来应对大型语言模型在学术研究和出版中的使用？" },
          { q: "青年如何体验和理解人工智能系统？这对数字公民身份、教育和治理意味着什么？" },
          { q: "将知识生产任务交由人工智能系统承担，会产生哪些长期社会与认识论影响？" },
        ].map((item, i) => (
          <div style="display:flex;gap:16px;padding:16px 0;border-bottom:1px solid var(--border-light);">
            <span style="font-family:var(--font-mono);font-size:12px;color:var(--text-muted);flex-shrink:0;padding-top:2px;">{String(i+1).padStart(2,'0')}</span>
            <p style="font-size:15px;color:var(--text-secondary);line-height:1.75;margin:0;">{item.q}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section-compact" style="background:var(--bg-white);border-top:1px solid var(--border-light);">
    <div class="container">
      <div style="display:flex;align-items:center;justify-content:space-between;gap:24px;flex-wrap:wrap;">
        <div>
          <h2 style="font-family:var(--font-serif);font-size:22px;color:var(--text-main);margin-bottom:8px;">有意参与贡献？</h2>
          <p style="font-size:15px;color:var(--text-secondary);">本项目正在寻求在人工智能、数字治理、科学技术研究及相关领域具有专长的研究人员参与。</p>
        </div>
        <div style="display:flex;gap:10px;flex-wrap:wrap;">
          <a href="/zh-cn/collaboration/research-fellow-application" class="btn btn-primary">申请研究员</a>
          <a href="/zh-cn/collaboration/research-project-proposal" class="btn btn-secondary">提交提案</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
<style>
@media (max-width: 900px) {
  div[style*="grid-template-columns:1fr 2fr"] { display: block !important; }
}
</style>
