---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/PageHero.astro';
---
<BaseLayout title="第十五个五年规划研究" description="探讨中国“十五五”规划及其对研究、高等教育和社会政策影响的研究项目。">
  <PageHero
    title="第十五个五年规划研究"
    description="一项系统研究中国第十五个五年规划（2026–2030）的项目，分析其对高等教育、科学研究重点和社会政策发展的影响。"
    breadcrumbs={[{ label: "研究", href: "/zh-cn/research-areas" }, { label: "项目", href: "/zh-cn/projects" }, { label: "第十五个五年规划研究" }]}
    tag="进行中的项目"
  >
  </PageHero>

  <section class="section" style="background:var(--bg-white);">
    <div class="container">
      <div style="display:grid;grid-template-columns:1fr 2fr;gap:64px;align-items:start;">
        <div>
          <div class="section-label">项目详情</div>
          <div style="display:flex;flex-direction:column;gap:20px;margin-top:8px;">
            {[
              { label: "状态",       value: "进行中" },
              { label: "开始日期",   value: "2026" },
              { label: "规划周期",  value: "2026–2030" },
              { label: "牵头中心",  value: "政策与社会研究中心" },
              { label: "重点领域",  value: "高等教育、科学政策、社会发展" },
              { label: "项目类型", value: "政策研究" },
            ].map((item) => (
              <div>
                <div style="font-size:11px;font-family:var(--font-mono);text-transform:uppercase;letter-spacing:0.1em;color:var(--text-muted);margin-bottom:4px;">{item.label}</div>
                <div style="font-size:14.5px;color:var(--text-main);">{item.value}</div>
              </div>
            ))}
          </div>
          <div style="margin-top:32px;display:flex;flex-direction:column;gap:8px;">
            <a href="/zh-cn/research-centers/policy-social-research" class="btn btn-primary" style="justify-content:center;">牵头中心</a>
            <a href="/zh-cn/publications" class="btn btn-secondary" style="justify-content:center;">出版成果</a>
          </div>
        </div>
        <div>
          <h2 style="font-family:var(--font-serif);font-size:28px;color:var(--text-main);margin-bottom:20px;font-weight:400;">关于项目</h2>
          <p style="font-size:16px;line-height:1.85;color:var(--text-secondary);margin-bottom:20px;">
            第十五个五年规划研究项目是一项系统研究中国第十五个五年规划（2026–2030）及其对高等教育、科学研究、社会治理和学术出版影响的研究项目。本项目建立在对以往五年规划的积累研究基础上，并将结构化分析框架应用于新的规划周期。
          </p>
          <p style="font-size:16px;line-height:1.85;color:var(--text-secondary);margin-bottom:20px;">
            本项目特别关注国家规划框架如何塑造大学和研究机构的研究优先事项，如何影响学术出版和学术传播基础设施的发展，以及规划目标如何与国际学术环境互动。
          </p>
          <p style="font-size:16px;line-height:1.85;color:var(--text-secondary);">
            本项目成果旨在服务研究中国高等教育和科学政策的学者、应对规划所塑造政策环境的机构，以及关注中国学术领域的政策制定者和国际组织。
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section" style="background:var(--bg-main);border-top:1px solid var(--border-light);">
    <div class="container">
      <div class="section-label">研究范围</div>
      <h2 class="section-title">分析维度</h2>
      <div style="display:grid;grid-template-columns:repeat(2,1fr);gap:1px;background:var(--border-light);border:1px solid var(--border-light);margin-top:8px;">
        {[
          { title:"高等教育发展", desc:"分析规划中关于高等教育扩展、大学治理改革、人才发展和国际化的目标。" },
          { title:"科技政策", desc:"分析研发目标、创新体系目标、关键技术优先事项和科学治理框架。" },
          { title:"社会政策维度",      desc:"分析与学术和知识工作相关的社会发展目标，包括就业、社会保障和数字包容。" },
          { title:"学术出版影响", desc:"评估规划中有关出版、开放科学、知识产权和数据治理的政策如何影响学术传播。" },
          { title:"国际参与",     desc:"分析规划对国际学术合作、外国人才项目以及全球研究网络参与的表述。" },
          { title:"历史与比较分析", desc:"与第十四个五年规划进行系统比较，识别第十五个五年规划中的延续、转向和新优先事项。" },
        ].map((item) => (
          <div class="card" style="border:none;border-radius:0;">
            <h3 style="font-family:var(--font-sans);font-size:15px;font-weight:600;color:var(--text-main);margin-bottom:10px;">{item.title}</h3>
            <p style="font-size:14px;line-height:1.7;color:var(--text-secondary);">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section" style="background:var(--bg-white);border-top:1px solid var(--border-light);">
    <div class="container">
      <div class="section-label">项目成果</div>
      <h2 class="section-title">预期出版成果</h2>
      <div style="margin-top:8px;">
        {[
          { type:"研究报告", title:"中国第十五个五年规划：对高等教育与科学研究的影响", status:"筹备中" },
          { type:"政策简报", title:"第十五个五年规划中的科学治理与研究优先事项设定", status:"筹备中" },
          { type:"工作论文", title:"中国规划框架中的学术出版与学术传播：一项纵向分析", status:"筹备中" },
        ].map((pub) => (
          <div class="publication-item">
            <div class="pub-type">{pub.type}</div>
            <div class="pub-title">{pub.title}</div>
            <div style="text-align:right;">
              <div style="font-family:var(--font-mono);font-size:13px;color:var(--accent-steel);margin-bottom:10px;">{pub.status}</div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
<style>
@media (max-width: 900px) {
  div[style*="grid-template-columns:1fr 2fr"] { display: block !important; }
  div[style*="grid-template-columns:repeat(2,1fr)"] { grid-template-columns: 1fr !important; }
}
</style>
