---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/PageHero.astro';
---
<BaseLayout title="学术出版标准项目" description="为学术期刊与出版机构制定编辑标准、出版伦理指南及学术传播框架的研究项目。">
  <PageHero
    title="学术出版标准项目"
    description="一项研究与标准建设项目，为学术期刊和出版社制定编辑标准、出版伦理指南、同行评审框架和学术传播基准。"
    breadcrumbs={[{ label: "研究", href: "/zh-cn/research-areas" }, { label: "项目", href: "/zh-cn/projects" }, { label: "学术出版标准" }]}
    tag="进行中的项目"
  >
  </PageHero>

  <section class="section" style="background:var(--bg-white);">
    <div class="container">
      <div style="display:grid;grid-template-columns:1fr 2fr;gap:64px;align-items:start;">
        <div>
          <div class="section-label">项目详情</div>
          <div style="display:flex;flex-direction:column;gap:20px;margin-top:8px;">
            {[
              { label: "状态",       value: "进行中" },
              { label: "开始日期",   value: "2026" },
              { label: "牵头中心",  value: "学术出版研究中心" },
              { label: "项目类型", value: "研究与标准建设" },
              { label: "成果类型", value: "标准、指南、工作论文" },
              { label: "联系",      value: "research@panorama-sg.com" },
            ].map((item) => (
              <div>
                <div style="font-size:11px;font-family:var(--font-mono);text-transform:uppercase;letter-spacing:0.1em;color:var(--text-muted);margin-bottom:4px;">{item.label}</div>
                <div style="font-size:14.5px;color:var(--text-main);">{item.value}</div>
              </div>
            ))}
          </div>
          <div style="margin-top:32px;display:flex;flex-direction:column;gap:8px;">
            <a href="/zh-cn/research-centers/scholarly-publishing-studies" class="btn btn-primary" style="justify-content:center;">牵头中心</a>
            <a href="/zh-cn/resources/guidelines" class="btn btn-secondary" style="justify-content:center;">项目指南</a>
          </div>
        </div>
        <div>
          <h2 style="font-family:var(--font-serif);font-size:28px;color:var(--text-main);margin-bottom:20px;font-weight:400;">关于项目</h2>
          <p style="font-size:16px;line-height:1.85;color:var(--text-secondary);margin-bottom:20px;">
            学术出版标准项目是由学术出版研究中心牵头的研究与标准建设综合项目。其核心目标是形成实用、循证的标准和指南文件，供期刊编辑、出版社和学术机构用于提升出版实践的质量、透明度和伦理完整性。
          </p>
          <p style="font-size:16px;line-height:1.85;color:var(--text-secondary);margin-bottom:20px;">
            本项目以研究为基础开展标准建设：标准和指南文件建立在对现有实践的系统综述、对 COPE、ICMJE 和 WAME 等机构现行指南的分析，以及对期刊编辑和出版社需求与挑战的实证研究基础之上。
          </p>
          <p style="font-size:16px;line-height:1.85;color:var(--text-secondary);">
            所有项目成果均以开放获取方式提供。本项目欢迎全球期刊编辑、出版社和研究人员反馈与参与，并可根据具体学科或区域情境进行调整。
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section" style="background:var(--bg-main);border-top:1px solid var(--border-light);">
    <div class="container">
      <div class="section-label">标准领域</div>
      <h2 class="section-title">规划中的标准文件</h2>
      <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:var(--border-light);border:1px solid var(--border-light);margin-top:8px;">
        {[
          { num:"01", title:"编辑标准", status:"开发中", desc:"关于编辑范围、编委会构成、编辑决策流程、稿件追踪和编辑透明度的标准。" },
          { num:"02", title:"同行评审标准", status:"开发中", desc:"关于同行评审模式选择、评审人选择、评审指南、评审时间表和评审中利益冲突处理的标准。" },
          { num:"03", title:"出版伦理标准", status:"规划中", desc:"关于作者身份、剽窃处理、数据捏造与篡改、撤稿政策和编辑不端处理程序的标准。" },
          { num:"04", title:"开放获取标准", status:"规划中", desc:"关于开放获取政策披露、APC 透明度、许可、权利保留、自存档权利和预印本政策的标准。" },
          { num:"05", title:"研究数据标准", status:"规划中", desc:"关于期刊出版中数据可得性声明、数据共享、补充材料和研究数据管理的标准。" },
          { num:"06", title:"元数据与可发现性", status:"规划中", desc:"关于文章级元数据、DOI 注册、ORCID 集成、资助方致谢以及摘要和关键词质量的标准。" },
        ].map((item) => (
          <div class="card" style="border:none;border-radius:0;">
            <div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:10px;">
              <span style="font-family:var(--font-mono);font-size:11px;color:var(--text-muted);">{item.num}</span>
              <span class={`tag ${item.status === '开发中' ? 'tag-active' : ''}`} style="font-size:10px;">{item.status}</span>
            </div>
            <h3 style="font-family:var(--font-sans);font-size:15px;font-weight:600;color:var(--text-main);margin-bottom:10px;">{item.title}</h3>
            <p style="font-size:14px;line-height:1.7;color:var(--text-secondary);">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section" style="background:var(--bg-white);border-top:1px solid var(--border-light);">
    <div class="container">
      <div class="section-label">研究出版成果</div>
      <h2 class="section-title">项目出版成果</h2>
      <div style="margin-top:8px;">
        {[
          { type:"工作论文", title:"数字时代的同行评审模式与出版伦理", year:"2026", status:"可用" },
          { type:"标准文件", title:"学术期刊编辑标准：草案 v0.1", year:"2026", status:"筹备中" },
        ].map((pub) => (
          <div class="publication-item">
            <div class="pub-type">{pub.type}</div>
            <div class="pub-title">{pub.title}</div>
            <div style="text-align:right;">
              <div style="font-family:var(--font-mono);font-size:12px;color:var(--text-muted);margin-bottom:4px;">{pub.year}</div>
              <div style="font-family:var(--font-mono);font-size:12px;color:var(--accent-steel);">{pub.status}</div>
            </div>
          </div>
        ))}
      </div>
      <div style="margin-top:32px;">
        <a href="/zh-cn/publications" class="btn btn-secondary">全部出版成果</a>
      </div>
    </div>
  </section>
</BaseLayout>
<style>
@media (max-width: 900px) {
  div[style*="grid-template-columns:1fr 2fr"] { display: block !important; }
  div[style*="grid-template-columns:repeat(3,1fr)"] { grid-template-columns: repeat(2,1fr) !important; }
}
@media (max-width: 600px) {
  div[style*="grid-template-columns:repeat(3,1fr)"],
  div[style*="grid-template-columns:repeat(2,1fr)"] { display: block !important; }
}
</style>
