---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/PageHero.astro';
import JournalArticleList from '../../../components/JournalArticleList.astro';
---
<BaseLayout title="期刊论文" description="作者含研究院成员、并获研究院资助的期刊论文。">
  <PageHero
    title="期刊论文"
    description="作者含研究院成员、并获研究院资助的期刊论文。作者主要来自研究院以外的资助成果，列于“资助”。"
    breadcrumbs={[{ label: "出版成果", href: "/zh-cn/publications" }, { label: "期刊论文" }]}
  />

  <section class="section" style="background:var(--bg-main);">
    <div class="container">
      <JournalArticleList lang="zh-cn" membersOnly />
    </div>
  </section>
</BaseLayout>
