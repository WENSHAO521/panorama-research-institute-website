---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/PageHero.astro';
---
<BaseLayout title="工作论文" description="全景研究院工作论文，呈现初步研究发现与学术论点。">
  <PageHero
    title="工作论文"
    description="工作论文呈现全景研究院相关研究人员的初步研究发现、理论论证和进行中的学术工作。"
    breadcrumbs={[{ label: "出版成果", href: "/zh-cn/publications" }, { label: "工作论文" }]}
  />

  <section class="section" style="background:var(--bg-white);">
    <div class="container">
      <div style="display:grid;grid-template-columns:1fr 2fr;gap:64px;align-items:start;">
        <div>
          <div class="section-label">关于本系列</div>
          <div style="display:flex;flex-direction:column;gap:16px;margin-top:8px;">
            {[
              { label: "形式",         value: "工作论文" },
              { label: "通常篇幅", value: "5,000–15,000 词" },
              { label: "评审",         value: "内部编辑评审" },
              { label: "获取方式",         value: "开放获取" },
              { label: "DOI",            value: "已注册（Crossref）" },
              { label: "ISSN",           value: "已申请" },
            ].map((item) => (
              <div>
                <div style="font-size:11px;font-family:var(--font-mono);text-transform:uppercase;letter-spacing:0.1em;color:var(--text-muted);margin-bottom:4px;">{item.label}</div>
                <div style="font-size:14.5px;color:var(--text-main);">{item.value}</div>
              </div>
            ))}
          </div>
          <div style="margin-top:32px;">
            <a href="/zh-cn/people/research-fellows" class="btn btn-primary" style="width:100%;justify-content:center;">成为研究员</a>
          </div>
        </div>
        <div>
          <h2 style="font-family:var(--font-serif);font-size:24px;color:var(--text-main);margin-bottom:16px;font-weight:400;">关于工作论文</h2>
          <p style="font-size:16px;line-height:1.85;color:var(--text-secondary);margin-bottom:20px;">
            工作论文是全景研究院的重要出版形式，使研究发现、理论贡献和学术论证能够在正式同行评审之前或同时快速传播。工作论文可呈现初步发现、理论框架、系统文献综述，或对研究院相关领域新发展作出评论。
          </p>
          <p style="font-size:16px;line-height:1.85;color:var(--text-secondary);margin-bottom:32px;">
            所有工作论文均以开放获取方式发布并获得 DOI。研究院工作论文系列接受隶属研究员、访问学者以及在研究院研究领域内工作的受邀贡献者投稿。
          </p>

          <div class="section-label" style="margin-bottom:12px;">已发布工作论文</div>
          {[
            { num:"WP-2026-001", title:"数字时代的同行评审模式与出版伦理", authors:"全景研究院", center:"学术出版研究中心", date:"2026" },
            { num:"WP-2026-002", title:"迈向透明期刊评价框架：学术索引的原则与标准", authors:"全景研究院", center:"学术索引与评价研究中心", date:"2026" },
          ].map((pub) => (
            <div class="publication-item">
              <div>
                <div style="font-size:11px;font-family:var(--font-mono);color:var(--text-muted);margin-bottom:6px;">{pub.num} &bull; {pub.center}</div>
                <div class="pub-title">{pub.title}</div>
                <div style="font-size:13px;color:var(--text-muted);margin-top:6px;">{pub.authors}</div>
              </div>
              <div style="text-align:right;flex-shrink:0;">
                <div style="font-family:var(--font-mono);font-size:13px;color:var(--text-muted);margin-bottom:10px;">{pub.date}</div>
                <a href="/zh-cn/publications" class="btn btn-ghost" style="font-size:13px;padding:0;">下载 →</a>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
<style>
@media (max-width: 900px) {
  div[style*="grid-template-columns:1fr 2fr"] { display: block !important; }
}
</style>
