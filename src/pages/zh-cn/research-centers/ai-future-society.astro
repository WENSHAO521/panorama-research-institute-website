---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/PageHero.astro';
---
<BaseLayout title="人工智能与未来社会研究中心" description="专注于人工智能治理、人工智能伦理、数字未来以及智能系统社会影响的研究中心。">
  <PageHero
    title="人工智能与未来社会研究中心"
    description="研究人工智能治理、人工智能伦理、智能系统的社会与认识论影响，以及学术和公民情境中人机互动的未来。"
    breadcrumbs={[{ label: "研究", href: "/zh-cn/research-areas" }, { label: "研究中心", href: "/zh-cn/research-centers" }, { label: "人工智能与未来社会" }]}
    tag="即将设立的研究中心"
  >
  </PageHero>

  <section class="section" style="background:var(--bg-white);">
    <div class="container">
      <div style="display:grid;grid-template-columns:1fr 2fr;gap:64px;align-items:start;">
        <div>
          <div class="section-label">概览</div>
          <div style="display:flex;flex-direction:column;gap:20px;margin-top:8px;">
            {[
              { label: "中心状态",    value: "即将设立，预计 2026 年" },
              { label: "已发布",        value: "2026" },
              { label: "研究领域",    value: "人工智能与未来社会" },
              { label: "创始项目","": "" , value: "人工智能与未来社会研究" },
              { label: "进行中的项目",  value: "1 项（创始项目）" },
              { label: "联系",          value: "research@panorama-sg.com" },
            ].map((item) => (
              <div>
                <div style="font-size:11px;font-family:var(--font-mono);text-transform:uppercase;letter-spacing:0.1em;color:var(--text-muted);margin-bottom:4px;">{item.label}</div>
                <div style="font-size:14.5px;color:var(--text-main);">{item.value}</div>
              </div>
            ))}
          </div>
          <div style="margin-top:32px;display:flex;flex-direction:column;gap:8px;">
            <a href="/zh-cn/collaboration/research-fellow-application" class="btn btn-primary" style="justify-content:center;">研究员</a>
            <a href="/zh-cn/collaboration/visiting-scholar-application" class="btn btn-secondary" style="justify-content:center;">访问学者</a>
          </div>
        </div>
        <div>
          <div style="background:var(--bg-soft);border:1px solid var(--border-light);padding:20px 24px;margin-bottom:28px;display:flex;gap:12px;align-items:flex-start;">
            <span style="font-family:var(--font-mono);font-size:11px;letter-spacing:0.1em;text-transform:uppercase;color:var(--accent-steel);flex-shrink:0;">状态说明</span>
            <p style="font-size:14px;color:var(--text-secondary);margin:0;line-height:1.6;">人工智能与未来社会研究中心目前处于设立阶段，预计于 2026 年全面运行。有意与该中心建立学术关联的研究者可通过研究员申请流程表达意向。</p>
          </div>
          <h2 style="font-family:var(--font-serif);font-size:28px;color:var(--text-main);margin-bottom:20px;font-weight:400;">关于中心</h2>
          <p style="font-size:16px;line-height:1.85;color:var(--text-secondary);margin-bottom:20px;">
            人工智能与未来社会研究中心将成为全景研究院第四个研究中心，回应本十年最紧迫且多维的研究议程之一：人工智能的治理、伦理和社会后果。
          </p>
          <p style="font-size:16px;line-height:1.85;color:var(--text-secondary);margin-bottom:20px;">
            该中心不仅将人工智能视为技术，也将其视为社会、认识论和政治现象：它重塑知识生产，改变劳动力市场，挑战治理框架，并提出关于主体性、问责和人类未来的根本问题。
          </p>
          <p style="font-size:16px;line-height:1.85;color:var(--text-secondary);">
            该中心将特别关注人工智能对学术传播和研究实践的影响，包括学术出版中的 AI 生成内容、AI 辅助同行评审、研究中大型语言模型的使用，以及这些发展带来的治理挑战。
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section" style="background:var(--bg-main);border-top:1px solid var(--border-light);">
    <div class="container">
      <div class="section-label">规划研究重点</div>
      <h2 class="section-title">核心研究主题</h2>
      <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:var(--border-light);border:1px solid var(--border-light);margin-top:8px;">
        {[
          { title: "人工智能治理",             desc: "研究机构、国家和国际层面的人工智能系统治理，包括监管、标准和问责框架。" },
          { title: "人工智能伦理",                 desc: "研究人工智能开发和部署的伦理维度，包括公平性、偏见、透明度、隐私和人权影响。" },
          { title: "学术出版中的人工智能", desc: "研究人工智能在学术出版中的使用与治理，包括 AI 生成内容、AI 辅助同行评审和剽窃检测。" },
          { title: "人机互动",       desc: "研究人类如何在学术、公民和专业情境中与人工智能系统互动，包括信任、委托、增强和依赖。" },
          { title: "数字未来",            desc: "研究人工智能和数字转型引发的长期社会情景，包括自动化、劳动、教育和民主治理。" },
          { title: "人工智能与知识生产", desc: "研究人工智能系统如何在学术和公共情境中塑造知识的生产、验证和传播。" },
        ].map((item) => (
          <div class="card" style="border:none;border-radius:0;">
            <h3 style="font-family:var(--font-sans);font-size:15px;font-weight:600;color:var(--text-main);margin-bottom:10px;">{item.title}</h3>
            <p style="font-size:14px;line-height:1.7;color:var(--text-secondary);">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section" style="background:var(--bg-white);border-top:1px solid var(--border-light);">
    <div class="container">
      <div class="section-label">研究项目</div>
      <h2 class="section-title">创始项目</h2>
      <div style="margin-top:8px;">
        <div class="project-card" style="margin-bottom:1px;border-radius:0;border-bottom:1px solid var(--border-light);">
          <span class="tag tag-steel" style="margin-bottom:12px;display:inline-flex;">开发中</span>
          <h3 class="project-title">人工智能与未来社会研究项目</h3>
          <p class="project-desc">人工智能与未来社会研究中心的创始研究项目，考察人工智能的社会、伦理和治理维度，尤其关注人工智能对学术传播、研究实践和学术出版的影响。</p>
          <a href="/zh-cn/projects/ai-future-society" style="display:inline-flex;margin-top:16px;font-size:13.5px;color:var(--accent-steel);">View Project &rarr;</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section" style="background:var(--bg-main);border-top:1px solid var(--border-light);">
    <div class="container">
      <div style="max-width:700px;">
        <div class="section-label">参与</div>
        <h2 class="section-title">在创始阶段加入中心</h2>
        <p style="font-size:16px;line-height:1.85;color:var(--text-secondary);margin-bottom:32px;">
          人工智能与未来社会研究中心正在积极招募研究人员加入首批关联学者队伍。鼓励具有人工智能、数字治理、科学技术研究、媒体研究、技术哲学或相关领域专长的研究者申请。
        </p>
        <div style="display:flex;gap:10px;flex-wrap:wrap;">
          <a href="/zh-cn/collaboration/research-fellow-application"  class="btn btn-primary">申请研究员</a>
          <a href="/zh-cn/collaboration/visiting-scholar-application" class="btn btn-secondary">访问学者计划</a>
          <a href="/zh-cn/collaboration/research-project-proposal"   class="btn btn-secondary">提交研究提案</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
<style>
@media (max-width: 900px) {
  div[style*="grid-template-columns:1fr 2fr"] { display: block !important; }
  div[style*="grid-template-columns:repeat(3,1fr)"] { grid-template-columns: repeat(2,1fr) !important; }
}
@media (max-width: 600px) {
  div[style*="grid-template-columns:repeat(3,1fr)"],
  div[style*="grid-template-columns:repeat(2,1fr)"] { display: block !important; }
}
</style>
