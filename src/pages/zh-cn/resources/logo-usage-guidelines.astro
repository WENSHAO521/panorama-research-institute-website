---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/PageHero.astro';
---
<BaseLayout title="标志与名称使用指南" description="正确使用全景研究院名称与标识的指南。">
  <PageHero
    title="标志与名称使用指南"
    description="关于在出版物、演示文稿、活动和数字传播中正确使用全景研究院名称、标志和视觉识别的官方指南。"
    breadcrumbs={[{ label: "资源", href: "/zh-cn/resources" }, { label: "标识使用指南" }]}
  />

  <section class="section" style="background:var(--bg-white);">
    <div class="container">
      <div style="max-width:860px;">
        <div class="statement-box" style="margin-bottom:48px;">
          <div style="font-family:var(--font-mono);font-size:11px;letter-spacing:0.12em;text-transform:uppercase;color:var(--text-muted);margin-bottom:10px;">使用说明</div>
          <p style="font-size:16px;line-height:1.8;color:var(--text-secondary);margin:0;">
            全景研究院名称和标志仅可用于研究院正式授权的工作。未经明确书面许可，不得在出版物、活动、网站或通信中擅自使用研究院名称或标志。
          </p>
        </div>

        <div style="display:flex;flex-direction:column;gap:48px;">
          {[
            {
              title: "允许使用",
              content: "研究院名称和标志可由以下主体使用：",
              items: [
                "研究员、副研究员和访问学者，在与研究院支持下开展的工作相关时使用",
                "研究院出版成果共同作者，在引用其研究院隶属时使用",
                "伙伴机构，在正式文件中提及与研究院合作时使用",
                "活动联合组织方，在经研究院学术活动事务部批准的活动材料中使用",
                "媒体和新闻机构，在准确事实报道研究院及其活动时使用",
              ],
            },
            {
              title: "禁止使用",
              content: "明确禁止以下研究院名称和标志使用方式：",
              items: [
                "暗示研究院认可未经正式授权的立场、产品、出版物或活动",
                "未经明确书面许可，将研究院名称或标志用于商业活动",
                "修改、扭曲或将研究院标志与其他视觉元素组合",
                "使用研究院名称或标志表示不存在或已经终止的隶属关系",
                "在未经研究院正式批准的出版物标题或封面中包含研究院名称",
              ],
            },
            {
              title: "名称使用",
              content: "在文本中提及研究院时，请使用以下形式：",
              items: [
                "全称：Panorama Research Institute",
                '简称（首次提及后）：the Institute',
                '含母体机构："Panorama Research Institute, an internal research division of Panorama Scholarly Group"',
                '正式文件中："Panorama Research Institute (an internal research division of Panorama Scholarly Group)"',
              ],
            },
            {
              title: "标志使用",
              content: "使用研究院标志时，请遵守以下要求：",
              items: [
                "仅使用研究院学术出版事务部提供的官方标志文件",
                "保持标志周围最小留白（四周均等于 PANORAMA 中字母 P 的高度）",
                "数字使用中标志高度不得低于 24px，印刷使用中不得低于 15mm",
                "使用深色版本（PANORAMA 用于深色或白色背景）；浅色版本（白色 PANORAMA）仅用于深色背景",
                "不得降低标志不透明度、仅使用轮廓，或使用非品牌颜色",
              ],
            },
          ].map((section) => (
            <div style="padding-bottom:48px;border-bottom:1px solid var(--border-light);">
              <h2 style="font-family:var(--font-serif);font-size:22px;color:var(--text-main);margin-bottom:12px;font-weight:400;">{section.title}</h2>
              <p style="font-size:15px;color:var(--text-secondary);margin-bottom:16px;">{section.content}</p>
              <div style="display:flex;flex-direction:column;gap:4px;">
                {section.items.map((item) => (
                  <div style="display:flex;gap:10px;font-size:14.5px;color:var(--text-secondary);padding:8px 0;border-bottom:1px solid var(--bg-main);">
                    <span style="color:var(--text-muted);flex-shrink:0;">&#8212;</span>{item}
                  </div>
                ))}
              </div>
            </div>
          ))}
        </div>

        <div style="margin-top:8px;">
          <h2 style="font-family:var(--font-serif);font-size:22px;color:var(--text-main);margin-bottom:14px;font-weight:400;">申请标志文件或使用许可</h2>
          <p style="font-size:15.5px;color:var(--text-secondary);line-height:1.7;margin-bottom:24px;">
            如需申请研究院标志文件，或申请本指南未涵盖的特定使用许可，请联系研究院办公室： <span style="color:var(--accent-steel);">office@panorama-sg.com</span>。请说明拟使用方式、使用情境以及预计覆盖或传播范围。
          </p>
          <div style="display:flex;gap:10px;flex-wrap:wrap;">
            <a href="/zh-cn/collaboration/submit" class="btn btn-primary">申请许可</a>
            <a href="/zh-cn/governance/name-logo-usage" class="btn btn-secondary">治理政策</a>
            <a href="/zh-cn/resources" class="btn btn-secondary">全部资源</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
