---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/PageHero.astro';
import JournalArticleList from '../../../components/JournalArticleList.astro';
---
<BaseLayout title="资助期刊论文" description="获全景研究院资助的期刊论文，作者主要来自研究院以外的学者和机构。">
  <PageHero
    title="资助期刊论文"
    description="获全景研究院资助的期刊论文，作者主要来自研究院以外的学者和机构。"
    breadcrumbs={[{ label: "资助", href: "/zh-cn/sponsorship" }, { label: "资助期刊论文" }]}
  />

  <section class="section" style="background:var(--bg-main);">
    <div class="container">
      <JournalArticleList lang="zh-cn" sponsoredOnly />
    </div>
  </section>
</BaseLayout>
