---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
---

<BaseLayout
  title="關於"
  description="全景研究院是全景學術集團的內部研究與學術發展部門。"
>
  <PageHero
    title="關於全景研究院"
    description="全景學術集團的內部研究與學術發展部門。"
    breadcrumbs={[{ label: "研究院" }, { label: "概覽" }]}
  />

  <!-- Overview -->
  <section class="section" style="background:var(--bg-white);">
    <div class="container">
      <div style="display:grid;grid-template-columns:1fr 2fr;gap:72px;align-items:start;">
        <div>
          <h2 style="font-family:var(--font-serif);font-size:22px;color:var(--text-main);margin-bottom:16px;font-weight:400;">概覽</h2>
          <div style="display:flex;flex-direction:column;gap:12px;margin-top:8px;">
            <a href="#mission"    style="font-size:14px;color:var(--accent-steel);">使命與願景</a>
            <a href="#status"     style="font-size:14px;color:var(--accent-steel);">機構性質</a>
            <a href="#affiliation"style="font-size:14px;color:var(--accent-steel);">隸屬關係</a>
            <a href="#scope"      style="font-size:14px;color:var(--accent-steel);">工作範圍</a>
            <a href="#functions"  style="font-size:14px;color:var(--accent-steel);">學術職能</a>
          </div>
        </div>
        <div>
          <p style="font-size:17px;line-height:1.8;color:var(--text-secondary);margin-bottom:28px;">
            全景研究院是全景學術集團的內部研究與學術發展部門。研究院支持跨學科研究、學術出版研究、期刊索引與評價、政策分析、研究出版、學術活動和機構合作。
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Mission & Vision -->
  <section id="mission" class="section" style="background:var(--bg-main);border-top:1px solid var(--border-light);">
    <div class="container">
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:64px;">
        <div>
          <div class="section-label">使命</div>
          <h2 style="font-family:var(--font-serif);font-size:28px;color:var(--text-main);margin-bottom:20px;font-weight:400;">
            通過嚴謹研究與開放交流推進學術知識發展
          </h2>
          <p style="font-size:16px;line-height:1.8;color:var(--text-secondary);">
            全景研究院致力於產出嚴謹、獨立且具有公共相關性的研究。研究院在各研究領域推進知識發展，支持學者和研究團隊，並建設強化全球學術傳播的基礎設施。
          </p>
        </div>
        <div>
          <div class="section-label">願景</div>
          <h2 style="font-family:var(--font-serif);font-size:28px;color:var(--text-main);margin-bottom:20px;font-weight:400;">
            一個值得信賴的跨學科學術探究平台
          </h2>
          <p style="font-size:16px;line-height:1.8;color:var(--text-secondary);">
            研究院展望一個研究基礎設施、學術出版和學術合作透明、公平並可全球訪問的未來，並致力於成為全球研究者、機構和政策制定者信賴的可信平台。
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Institutional Status -->
  <section id="status" class="section" style="background:var(--bg-white);border-top:1px solid var(--border-light);">
    <div class="container">
      <div class="section-label">機構性質</div>
      <h2 class="section-title">法律與機構定位</h2>
      <div style="max-width:760px;">
        <div class="statement-box" style="margin-bottom:32px;">
          <p style="font-size:16px;line-height:1.75;color:var(--text-secondary);margin-bottom:12px;">
            全景研究院是全景學術集團的內部研究與學術發展部門，不具備獨立法人資格。
          </p>
        </div>
        <p style="font-size:16px;line-height:1.8;color:var(--text-secondary);">
          研究院作為內部學術部門運行，在研究、出版和學術活動方面具有營運獨立性，同時仍受全景學術集團治理框架和行政管理約束。所有正式協議、合約和法律文件均由全景學術集團代表研究院簽署。
        </p>
      </div>
    </div>
  </section>

  <!-- Affiliation -->
  <section id="affiliation" class="section" style="background:var(--bg-main);border-top:1px solid var(--border-light);">
    <div class="container">
      <div class="section-label">隸屬關係</div>
      <h2 class="section-title">全景學術集團</h2>
      <div style="max-width:760px;">
        <p style="font-size:16px;line-height:1.8;color:var(--text-secondary);margin-bottom:24px;">
          全景學術集團（PSG）是全景研究院的上級機構。PSG 是一家學術出版與學術服務組織，營運包括全景期刊、全景圖書、POSI 資料庫和全景學者檔案在內的一系列平台。
        </p>
        <p style="font-size:16px;line-height:1.8;color:var(--text-secondary);">
          研究院作為 PSG 內部學術研究與發展部門，提供學術分析、研究出版成果和機構知識，以支持推進全球學術傳播這一更廣泛使命。
        </p>
      </div>
    </div>
  </section>

  <!-- Scope of Work -->
  <section id="scope" class="section" style="background:var(--bg-white);border-top:1px solid var(--border-light);">
    <div class="container">
      <div class="section-label">工作範圍</div>
      <h2 class="section-title">工作內容</h2>
      <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:var(--border-light);border:1px solid var(--border-light);margin-top:8px;">
        {[
          { title: "跨學科研究",       desc: "支持學術出版、政策、人工智慧與社會、教育、藝術和文化等領域的研究項目。" },
          { title: "學術出版研究",     desc: "研究出版倫理、同儕評審模式、編輯標準、開放取用和研究誠信。" },
          { title: "期刊索引與評價",    desc: "建立期刊評價、後設資料透明度和開放學術索引的框架。" },
          { title: "政策分析",                  desc: "以嚴謹方法分析公共政策、治理、社會發展和青年議題。" },
          { title: "學術出版成果",            desc: "撰寫研究報告、工作論文、政策簡報、主編文集和年度報告。" },
          { title: "學術活動",                  desc: "為研究人員組織學術會議、研討會、工作坊、論文徵稿和培訓項目。" },
        ].map((item) => (
          <div class="card" style="border:none;border-radius:0;">
            <h3 style="font-family:var(--font-sans);font-size:15px;font-weight:600;color:var(--text-main);margin-bottom:10px;">{item.title}</h3>
            <p style="font-size:14px;line-height:1.7;color:var(--text-secondary);">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Academic Functions -->
  <section id="functions" class="section" style="background:var(--bg-main);border-top:1px solid var(--border-light);">
    <div class="container">
      <div class="section-label">學術職能</div>
      <h2 class="section-title">核心學術活動</h2>
      <div style="max-width:760px;">
        {[
          "開展並支持原創跨學科研究",
          "出版研究報告、工作論文和政策簡報",
          "組織學術會議、研討會和工作坊",
          "支持訪問學者、研究員和項目貢獻者",
          "開發學術期刊和出版成果評價框架",
          "提供機構合作與研究夥伴關係服務",
          "建設開放學術基礎設施，包括 POSI 索引平台",
          "發布關於學術出版和學術傳播的年度報告",
        ].map((fn) => (
          <div style="display:flex;align-items:flex-start;gap:14px;padding:14px 0;border-bottom:1px solid var(--border-light);">
            <span style="width:4px;height:4px;background:var(--text-muted);border-radius:50%;flex-shrink:0;margin-top:8px;"></span>
            <span style="font-size:15.5px;color:var(--text-secondary);line-height:1.6;">{fn}</span>
          </div>
        ))}
      </div>
      <div style="margin-top:40px;display:flex;gap:12px;flex-wrap:wrap;">
        <a href="/zh-tw/framework" class="btn btn-primary">查看組織與職能框架</a>
        <a href="/zh-tw/contact"   class="btn btn-secondary">聯絡研究院</a>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
@media (max-width: 768px) {
  .container > div[style*="grid-template-columns:1fr 2fr"],
  .container > div[style*="grid-template-columns:1fr 1fr"],
  .container > div[style*="grid-template-columns:repeat(3,1fr)"] {
    display: block !important;
  }
}
</style>
