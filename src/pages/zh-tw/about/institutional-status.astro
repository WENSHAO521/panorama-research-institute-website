---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/PageHero.astro';
import RorLogo from '../../../components/RorLogo.astro';
import { site } from '../../../data/site';
---
<BaseLayout title="機構性質" description="全景研究院的法律與機構地位。">
  <PageHero
    title="機構性質"
    description="全景研究院在全景學術集團內的法律定位、治理結構和機構關係。"
    breadcrumbs={[{ label: "研究院", href: "/zh-tw/about" }, { label: "機構性質" }]}
  />

  <section class="section" style="background:var(--bg-white);">
    <div class="container">
      <div style="max-width:800px;">
        <div class="statement-box" style="margin-bottom:48px;">
          <div style="font-family:var(--font-mono);font-size:11px;letter-spacing:0.12em;text-transform:uppercase;color:var(--text-muted);margin-bottom:12px;">正式機構聲明</div>
          <p style="font-size:17px;line-height:1.8;color:var(--text-secondary);margin-bottom:12px;font-family:var(--font-serif);font-style:italic;">
            "全景研究院是由全景學術集團設立、具有自身學術治理體系與機構身分的研究機構。PSG 是其上級機構，負責其法律與行政事務。PRI 不具有獨立法人資格。"
          </p>
        </div>

        <div class="institutional-profile">
          <h2>機構基本資訊</h2>
          <dl>
            <div class="profile-row"><dt>正式名稱</dt><dd>全景研究院</dd></div>
            <div class="profile-row"><dt>英文名稱</dt><dd>Panorama Research Institute</dd></div>
            <div class="profile-row"><dt>簡稱</dt><dd>PRI</dd></div>
            <div class="profile-row"><dt>機構類型</dt><dd>研究機構（不具有獨立法人資格）</dd></div>
            <div class="profile-row"><dt>成立日期</dt><dd>2026 年 8 月 23 日</dd></div>
            <div class="profile-row"><dt>所在地</dt><dd>香港</dd></div>
            <div class="profile-row"><dt>地址</dt><dd><span class="profile-muted">香港辦公室</span><br /><span data-no-translate>{site.address.lines.join(', ')}, {site.address.city}</span></dd></div>
            <div class="profile-row"><dt>上級機構</dt><dd><span class="profile-inline"><a href={site.parentUrl} target="_blank" rel="noopener">全景學術集團</a><RorLogo href={site.parentRor} label="全景學術集團 – ROR ID" size={14} /></span></dd></div>
            {site.ror && (
              <div class="profile-row"><dt>ROR ID</dt><dd><RorLogo href={site.ror} label="全景研究院 – ROR ID" size={14} /></dd></div>
            )}
            <div class="profile-row"><dt>網站</dt><dd><a href="https://research.panorama-sg.com">research.panorama-sg.com</a></dd></div>
            <div class="profile-row"><dt>電子郵箱</dt><dd><a href="mailto:research@panorama-sg.com">research@panorama-sg.com</a></dd></div>
            <div class="profile-row"><dt>現行章程</dt><dd>1.2 版，2026-10-10 生效</dd></div>
          </dl>
        </div>

        {[
          {
            title: "法律地位",
            body: "全景研究院是由全景學術集團設立、具有自身學術治理體系與機構身分的研究機構。PSG 是其上級機構及法律與行政承載主體，也是本院合約與正式法律文件的法律當事方。PRI 不具有獨立法人資格或獨立法律登記，也不設立獨立於 PSG 的財務帳戶。"
          },
          {
            title: "營運獨立",
            body: "研究院雖在全景學術集團的行政治理下運行，但在研究活動、出版決策、活動組織和學術職能方面保持學術獨立。行政治理不延伸至研究方向、學術判斷或編輯決策。"
          },
          {
            title: "治理框架",
            body: "研究院依據自身章程和內部治理政策進行治理，這些文件在全景學術集團授權下採納，確立研究院使命、研究領域、組織架構、倫理原則和營運程序。"
          },
          {
            title: "正式名稱使用",
            body: '研究院以「Panorama Research Institute」名稱運行，其定位為由全景學術集團設立的研究機構。正式機構說明和出版物須披露 PSG 為 PRI 的上級機構及法律與行政承載主體，並說明 PRI 不具有獨立法人資格。經授權的學術署名可使用 PRI 名稱。正式協議須明確 PSG 為法律當事方，PRI 為開展有關活動的研究機構。'
          },
          {
            title: "財務管理",
            body: "與研究院相關的所有財務事項均由全景學術集團管理。研究經費、出版成本、活動預算和研究員支付均在全景學術集團財務治理框架內管理。"
          },
          {
            title: "對外代表",
            body: "PRI 可使用自身機構名稱開展和協調學術合作安排、諒解備忘錄及合作提案。凡需正式簽署或產生法律、財務義務的文件，均須明確 PSG 為法律當事方，並由 PSG 授權代表簽署；僅使用 PRI 名稱不產生簽約權限。"
          },
        ].map((s) => (
          <div style="margin-bottom:40px;padding-bottom:40px;border-bottom:1px solid var(--border-light);">
            <h2 style="font-family:var(--font-serif);font-size:22px;color:var(--text-main);margin-bottom:14px;font-weight:400;">{s.title}</h2>
            <p style="font-size:15.5px;line-height:1.8;color:var(--text-secondary);">{s.body}</p>
          </div>
        ))}

        <div style="display:flex;gap:10px;flex-wrap:wrap;margin-top:8px;">
          <a href="/zh-tw/charter"     class="btn btn-primary">研究院章程</a>
          <a href="/zh-tw/about"       class="btn btn-secondary">研究院概覽</a>
          <a href="/zh-tw/governance/rules" class="btn btn-secondary">治理規則</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
<style>
  .institutional-profile { margin-bottom:48px; padding-bottom:40px; border-bottom:1px solid var(--border-light); }
  .institutional-profile h2 { font-family:var(--font-serif); font-size:22px; color:var(--text-main); margin-bottom:18px; font-weight:400; }
  .institutional-profile dl { margin:0; border-top:1px solid var(--border-light); }
  .profile-row { display:grid; grid-template-columns:200px 1fr; gap:24px; padding:12px 0; border-bottom:1px solid var(--border-light); }
  .profile-row dt { font-family:var(--font-mono); font-size:11px; letter-spacing:0.1em; text-transform:uppercase; color:var(--text-muted); padding-top:3px; }
  .profile-row dd { margin:0; font-size:15px; line-height:1.65; color:var(--text-main); }
  .profile-row dd a { color:var(--accent-steel); }
  .profile-muted { font-size:13px; color:var(--text-muted); }
  .profile-inline { display:inline-flex; align-items:center; gap:8px; }
  @media (max-width: 640px) {
    .profile-row { grid-template-columns:1fr; gap:4px; }
  }
</style>
