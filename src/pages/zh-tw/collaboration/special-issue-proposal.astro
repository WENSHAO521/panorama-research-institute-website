---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/PageHero.astro';
import FormSubmitFields from '../../../components/FormSubmitFields.astro';
---
<BaseLayout title="特刊提案" description="提交與全景研究院合作的期刊特刊提案。">
  <PageHero
    title="特刊提案"
    description="提交與全景研究院合作組織並客座編輯學術期刊特刊的提案。研究院為客座編輯提供機構參與和學術協調支持。"
    breadcrumbs={[{ label: "學術合作", href: "/zh-tw/collaboration" }, { label: "特刊提案" }]}
  />

  <section class="section" style="background:var(--bg-white);">
    <div class="container">
      <div style="display:grid;grid-template-columns:1fr 2fr;gap:64px;align-items:start;">
        <div>
          <div class="section-label">概覽</div>
          <div style="display:flex;flex-direction:column;gap:16px;margin-top:8px;">
            {[
              { label:"類型",          value:"既有學術期刊特刊" },
              { label:"提案",      value:"不超過 1,500 詞" },
              { label:"評審時間",   value:"15 個工作日內" },
              { label:"期刊",       value:"提案人確定目標期刊" },
              { label:"研究院角色","": "", value:"聯合品牌、學術協調、出版支持" },
            ].map((item) => (
              <div>
                <div style="font-size:11px;font-family:var(--font-mono);text-transform:uppercase;letter-spacing:0.1em;color:var(--text-muted);margin-bottom:4px;">{item.label}</div>
                <div style="font-size:14.5px;color:var(--text-main);">{item.value}</div>
              </div>
            ))}
          </div>
        </div>
        <div>
          <p style="font-size:16px;line-height:1.85;color:var(--text-secondary);margin-bottom:32px;">
            全景研究院歡迎與客座編輯和承辦期刊合作組織期刊特刊。研究院的參與可為特刊增加機構信譽和學術協調支持。提案人負責對接目標期刊並主持客座編輯流程。
          </p>

          <div class="section-label" style="margin-bottom:14px;">提案要求</div>
          <div style="display:flex;flex-direction:column;gap:0;border:1px solid var(--border-light);margin-bottom:40px;">
            {[
              "特刊主題標題及 200 詞說明",
              "目標期刊及選擇理由",
              "期刊溝通狀態（已諮詢、討論中、已批准）",
              "客座編輯簡介及相關專長",
              "4–8 個論文主題或預期作者臨時清單",
              "擬議徵稿時間表和投稿截止日期",
              "擬議出版日期",
            ].map((item, i) => (
              <div style="padding:14px 20px;border-bottom:1px solid var(--border-light);display:flex;gap:12px;">
                <span style="font-family:var(--font-mono);font-size:11px;color:var(--text-muted);flex-shrink:0;padding-top:2px;">{String(i+1).padStart(2,'0')}</span>
                <span style="font-size:14px;color:var(--text-secondary);line-height:1.6;">{item}</span>
              </div>
            ))}
          </div>
        </div>
      </div>

      <div style="border-top:1px solid var(--border-light);padding-top:48px;">
        <div class="section-label" style="margin-bottom:8px;">提案表格</div>
        <h2 style="font-family:var(--font-serif);font-size:24px;color:var(--text-main);margin-bottom:24px;font-weight:400;">提交提案</h2>
        <form style="max-width:740px;" action="https://formsubmit.co/publications@panorama-sg.com" method="POST">
          <FormSubmitFields subject="全景研究院特刊提案" source="Special Issue Proposal Form" />
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:0;">
            {([
              { label:"客座編輯姓名", id:"ge-name",    type:"text",  placeholder:"姓名" },
              { label:"電子郵箱地址",     id:"ge-email",   name:"email", type:"email", placeholder:"your@email.com" },
              { label:"目標期刊",    id:"ge-journal", type:"text",  placeholder:"期刊名稱" },
              { label:"特刊主題",       id:"ge-theme",   type:"text",  placeholder:"暫定標題" },
            ] as { label: string; id: string; name?: string; type: 'text' | 'email'; placeholder: string }[]).map((f) => (
              <div style="padding:12px;border:1px solid var(--border-light);margin:-0.5px;">
                <label for={f.id} style="display:block;font-size:11px;font-family:var(--font-mono);text-transform:uppercase;letter-spacing:0.1em;color:var(--text-muted);margin-bottom:6px;">{f.label}</label>
                <input id={f.id} name={f.name ?? f.id} type={f.type} placeholder={f.placeholder} class="form-input" style="width:100%;" />
              </div>
            ))}
          </div>
          <div style="padding:12px;border:1px solid var(--border-light);margin-top:-0.5px;">
            <label for="si-proposal" style="display:block;font-size:11px;font-family:var(--font-mono);text-transform:uppercase;letter-spacing:0.1em;color:var(--text-muted);margin-bottom:6px;">完整提案</label>
            <textarea id="si-proposal" name="si-proposal" rows="8" placeholder="請包含提案要求中列出的全部必要資訊。" class="form-input" style="width:100%;resize:vertical;"></textarea>
          </div>
          <div style="padding:12px;border:1px solid var(--border-light);margin-top:-0.5px;">
            <button type="submit" class="btn btn-primary" style="width:100%;justify-content:center;">提交提案</button>
          </div>
        </form>
      </div>
    </div>
  </section>
</BaseLayout>
<style>
@media (max-width: 900px) {
  div[style*="grid-template-columns:1fr 2fr"] { display: block !important; }
  div[style*="grid-template-columns:1fr 1fr"] { display: block !important; }
}
</style>
