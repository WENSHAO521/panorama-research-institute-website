---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import FormSubmitFields from '../../components/FormSubmitFields.astro';
---

<BaseLayout
  title="聯絡"
  description="就研究諮詢、合作提案和一般資訊聯絡全景研究院。"
>
  <PageHero
    title="聯絡"
    description="如有研究諮詢、合作提案、媒體請求或一般資訊需求，請聯絡研究院。"
    breadcrumbs={[{ label: "聯絡" }]}
  />

  <section class="section" style="background:var(--bg-main);">
    <div class="container">
      <div style="display:grid;grid-template-columns:1fr 1.5fr;gap:72px;align-items:start;">

        <!-- Left: Contact Info -->
        <div>
          <div style="margin-bottom:40px;">
            <div class="section-label">全景研究院</div>
            <h2 style="font-family:var(--font-serif);font-size:26px;color:var(--text-main);margin-bottom:20px;font-weight:400;">聯絡</h2>
            <div style="display:flex;flex-direction:column;gap:20px;">
              <div>
                <div style="font-size:11px;font-family:var(--font-mono);text-transform:uppercase;letter-spacing:0.12em;color:var(--text-muted);margin-bottom:6px;">電子郵箱</div>
                <a href="mailto:research@panorama-sg.com" style="font-size:16px;color:var(--accent-steel);">research@panorama-sg.com</a>
              </div>
              <div>
                <div style="font-size:11px;font-family:var(--font-mono);text-transform:uppercase;letter-spacing:0.12em;color:var(--text-muted);margin-bottom:6px;">網站</div>
                <a href="https://research.panorama-sg.com" style="font-size:15px;color:var(--text-secondary);">research.panorama-sg.com</a>
              </div>
              <div>
                <div style="font-size:11px;font-family:var(--font-mono);text-transform:uppercase;letter-spacing:0.12em;color:var(--text-muted);margin-bottom:6px;">所屬機構</div>
                <a href="https://www.panorama-sg.com" target="_blank" rel="noopener" style="font-size:15px;color:var(--text-secondary);">全景學術集團</a>
              </div>
            </div>
          </div>

          <div class="statement-box">
            <div style="font-size:12px;font-family:var(--font-mono);text-transform:uppercase;letter-spacing:0.1em;color:var(--text-muted);margin-bottom:10px;">機構性質</div>
            <p style="font-size:13.5px;line-height:1.65;color:var(--text-secondary);">
              全景學術集團內部研究與學術發展部門，不具備獨立法人資格。
            </p>
          </div>

          <div style="margin-top:32px;">
            <div style="font-family:var(--font-mono);font-size:11px;text-transform:uppercase;letter-spacing:0.12em;color:var(--text-muted);margin-bottom:16px;">常見諮詢</div>
            {[
              { label: "研究合作",   href: "/zh-tw/collaboration" },
              { label: "訪問學者申請", href: "/zh-tw/collaboration/visiting-scholar-application" },
              { label: "研究院章程",         href: "/zh-tw/charter" },
              { label: "出版成果",              href: "/zh-tw/publications" },
            ].map((link) => (
              <a href={link.href} style="display:flex;justify-content:space-between;padding:10px 0;font-size:14px;color:var(--text-secondary);border-bottom:1px solid var(--border-light);">
                {link.label}
                <span style="color:var(--text-muted);">&rarr;</span>
              </a>
            ))}
          </div>
        </div>

        <!-- Right: Contact Form -->
        <form action="https://formsubmit.co/research@panorama-sg.com" method="POST" style="background:var(--bg-white);border:1px solid var(--border-light);padding:40px;display:flex;flex-direction:column;gap:20px;">
          <FormSubmitFields subject="全景研究院網站聯絡表單" source="Contact Page" />
          <div style="font-family:var(--font-serif);font-size:22px;color:var(--text-main);margin-bottom:4px;font-weight:400;">發送訊息</div>

          <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;">
            <div class="form-group">
              <label class="form-label" for="c-name">姓名 <span style="color:var(--accent-red);">*</span></label>
              <input type="text" id="c-name" name="name" class="form-input" required placeholder="您的姓名" />
            </div>
            <div class="form-group">
              <label class="form-label" for="c-email">電子郵箱 <span style="color:var(--accent-red);">*</span></label>
              <input type="email" id="c-email" name="email" class="form-input" required placeholder="your@email.com" />
            </div>
          </div>

          <div class="form-group">
            <label class="form-label" for="c-subject">主題 <span style="color:var(--accent-red);">*</span></label>
            <input type="text" id="c-subject" name="subject" class="form-input" required placeholder="您的諮詢主題是什麼？" />
          </div>

          <div class="form-group">
            <label class="form-label" for="c-message">訊息 <span style="color:var(--accent-red);">*</span></label>
            <textarea id="c-message" name="message" class="form-textarea" required placeholder="請詳細說明您的諮詢內容。" style="min-height:180px;"></textarea>
          </div>

          <button type="submit" class="btn btn-primary" style="justify-content:center;">發送訊息</button>

          <p style="font-size:12.5px;color:var(--text-muted);text-align:center;line-height:1.5;">
            研究院力求在 10 個工作日內回覆所有諮詢。
          </p>
        </form>

      </div>
    </div>
  </section>
</BaseLayout>

<style>
@media (max-width: 900px) {
  div[style*="grid-template-columns:1fr 1.5fr"] { display: block !important; }
  form > div[style*="grid-template-columns:1fr 1fr"] { display: block !important; gap: 16px !important; }
}
</style>
