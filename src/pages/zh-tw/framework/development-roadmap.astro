---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/PageHero.astro';
import { getRoadmap, roadmapDoneLabel } from '../../../data/roadmap';
const roadmap = getRoadmap('zh-tw');
const doneLabel = roadmapDoneLabel['zh-tw'];
---
<BaseLayout title="發展路線圖" description="全景研究院分階段發展路線圖。">
  <PageHero
    title="發展路線圖"
    description="全景研究院的階段性發展計畫，概述多年週期內的優先事項、里程碑和目標。"
    breadcrumbs={[{ label: "研究院", href: "/zh-tw/about" }, { label: "框架", href: "/zh-tw/framework" }, { label: "發展路線圖" }]}
  />

  <section class="section" style="background:var(--bg-white);">
    <div class="container">
      <div style="max-width:840px;">
        <p style="font-size:17px;line-height:1.85;color:var(--text-secondary);margin-bottom:48px;">
          全景研究院採取階段性發展方式，在保持高標準學術品質和治理要求的同時逐步建設機構能力。下方路線圖概述各階段的關鍵里程碑、優先事項和預期成果。
        </p>

        {roadmap.map((phase) => (
          <div style="margin-bottom:56px;padding-bottom:56px;border-bottom:1px solid var(--border-light);">
            <div style="display:grid;grid-template-columns:160px 1fr;gap:40px;align-items:start;">
              <div>
                <div style={`font-family:var(--font-mono);font-size:11px;text-transform:uppercase;letter-spacing:0.1em;color:${phase.color};margin-bottom:8px;`}>{phase.phase}</div>
                <div style="font-family:var(--font-serif);font-size:26px;color:var(--text-main);margin-bottom:6px;">{phase.label}</div>
                <div style="font-family:var(--font-mono);font-size:13px;color:var(--text-muted);">{phase.period}</div>
                <div style="margin-top:12px;">
                  <span class={`tag ${phase.key === 'current' ? 'tag-active' : phase.key === 'upcoming' ? 'tag-steel' : ''}`}>{phase.status}</span>
                </div>
              </div>
              <div>
                {phase.goals.map((goal) => (
                  <div style="display:flex;gap:12px;padding:10px 0;border-bottom:1px solid var(--bg-soft);">
                    <span style="color:var(--text-muted);flex-shrink:0;font-size:14px;">&#8212;</span>
                    <span style="font-size:15px;color:var(--text-secondary);line-height:1.7;">{goal.text}</span>
                    {goal.done && <span class="tag tag-active" style="font-size:10px;margin-left:auto;flex-shrink:0;align-self:flex-start;">{doneLabel}</span>}
                  </div>
                ))}
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section-compact" style="background:var(--bg-main);border-top:1px solid var(--border-light);">
    <div class="container">
      <div style="display:flex;align-items:center;justify-content:space-between;gap:24px;flex-wrap:wrap;">
        <div>
          <h2 style="font-family:var(--font-serif);font-size:22px;color:var(--text-main);margin-bottom:8px;">進一步了解研究院</h2>
        </div>
        <div style="display:flex;gap:10px;flex-wrap:wrap;">
          <a href="/zh-tw/framework"                          class="btn btn-primary">研究院組織與職能框架</a>
          <a href="/zh-tw/framework/organizational-structure" class="btn btn-secondary">組織架構</a>
          <a href="/zh-tw/research-centers"                   class="btn btn-secondary">研究中心</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
<style>
@media (max-width: 768px) {
  div[style*="grid-template-columns:160px 1fr"] { display: block !important; }
}
</style>
