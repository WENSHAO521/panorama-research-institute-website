---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getSiteDescription, getPlatforms, getResearchAreas, getResearchCenters, getFeaturedProjects, getFeaturedPublications, getUpcomingEvents } from '../../data/site';
import { getAnnouncements, localizeAnnouncementHref } from '../../data/announcements';
import type { Lang } from '../../i18n/utils';

const lang = (Astro.currentLocale as Lang) ?? 'en';
const platforms = getPlatforms(lang);
const researchAreas = getResearchAreas(lang);
const researchCenters = getResearchCenters(lang);
const featuredProjects = getFeaturedProjects(lang);
const featuredPublications = getFeaturedPublications(lang);
const upcomingEvents = getUpcomingEvents(lang);
const announcements = getAnnouncements(lang).slice(0, 3);

const homeFrameworkUnits = [
  { unit: "研究中心",              role: "專業學術單位" },
  { unit: "研究項目",             role: "研究院支持的項目" },
  { unit: "學術出版事務部",             role: "報告、論文與簡報" },
  { unit: "學術活動",               role: "會議、研討會、工作坊" },
  { unit: "學者計劃",  role: "研究員、訪問學者與研究助理" },
  { unit: "合作事務辦公室",          role: "夥伴關係、提案與諒解備忘錄" },
];
---

<BaseLayout
  title="全景研究院"
  description={getSiteDescription(lang)}
>

<!-- ── 02 Hero ── -->
<section class="hero-section" style="background:var(--bg-main);border-bottom:1px solid var(--border-light);">
  <div class="container">
    <div class="hero-inner">
      <!-- Left: text -->
      <div class="hero-text">
        <div style="font-family:var(--font-mono);font-size:12px;letter-spacing:0.14em;text-transform:uppercase;color:var(--text-muted);margin-bottom:28px;">
          全景學術集團內部的研究院
        </div>
        <h1 style="font-family:var(--font-serif);font-size:clamp(38px,5.5vw,60px);line-height:1.08;letter-spacing:-0.035em;color:var(--text-main);margin-bottom:28px;max-width:600px;">
          全景研究院
        </h1>
        <p style="font-size:18px;line-height:1.75;color:var(--text-secondary);max-width:560px;margin-bottom:36px;">
          研究、學術基礎設施與學術合作。研究院支持跨學科研究、學術出版研究、期刊索引與評價、政策分析，以及全球學術傳播基礎設施的發展。
        </p>
        <div style="display:flex;flex-wrap:wrap;gap:12px;">
          <a href="/zh-tw/about"            class="btn btn-primary">了解研究院</a>
          <a href="/zh-tw/research-centers" class="btn btn-secondary">查看研究中心</a>
          <a href="/zh-tw/charter"          class="btn btn-ghost">閱讀章程 →</a>
        </div>
      </div>

      <!-- Right: abstract research structure graphic -->
      <div class="hero-graphic" aria-hidden="true">
        <svg viewBox="0 0 480 400" fill="none" xmlns="http://www.w3.org/2000/svg" style="width:100%;max-width:480px;">
          <!-- Grid background -->
          <defs>
            <pattern id="grid" x="0" y="0" width="40" height="40" patternUnits="userSpaceOnUse">
              <path d="M 40 0 L 0 0 0 40" fill="none" stroke="#DADDDD" stroke-width="0.5"/>
            </pattern>
          </defs>
          <rect width="480" height="400" fill="url(#grid)" />

          <!-- Central node: PRI -->
          <rect x="170" y="160" width="140" height="80" rx="2" fill="white" stroke="#1F2326" stroke-width="1.5"/>
          <text x="240" y="195" text-anchor="middle" font-family="'IBM Plex Sans',sans-serif" font-size="11" font-weight="600" fill="#1F2326" letter-spacing="1">全景</text>
          <text x="240" y="212" text-anchor="middle" font-family="'IBM Plex Sans',sans-serif" font-size="10" fill="#5C6368" letter-spacing="0.5">研究院</text>

          <!-- Top node: Research Centers -->
          <rect x="166" y="40" width="148" height="56" rx="2" fill="white" stroke="#DADDDD" stroke-width="1"/>
          <text x="240" y="65" text-anchor="middle" font-family="'IBM Plex Sans',sans-serif" font-size="10" font-weight="600" fill="#1F2326">研究中心</text>
          <text x="240" y="82" text-anchor="middle" font-family="'IBM Plex Sans',sans-serif" font-size="9" fill="#8A9196">5 個運行中的研究中心</text>
          <line x1="240" y1="96" x2="240" y2="160" stroke="#DADDDD" stroke-width="1" stroke-dasharray="4 3"/>

          <!-- Bottom node: Publications -->
          <rect x="166" y="304" width="148" height="56" rx="2" fill="white" stroke="#DADDDD" stroke-width="1"/>
          <text x="240" y="329" text-anchor="middle" font-family="'IBM Plex Sans',sans-serif" font-size="10" font-weight="600" fill="#1F2326">出版成果</text>
          <text x="240" y="346" text-anchor="middle" font-family="'IBM Plex Sans',sans-serif" font-size="9" fill="#8A9196">報告 · 論文 · 簡報</text>
          <line x1="240" y1="240" x2="240" y2="304" stroke="#DADDDD" stroke-width="1" stroke-dasharray="4 3"/>

          <!-- Left node: Projects -->
          <rect x="20" y="164" width="120" height="56" rx="2" fill="white" stroke="#DADDDD" stroke-width="1"/>
          <text x="80" y="189" text-anchor="middle" font-family="'IBM Plex Sans',sans-serif" font-size="10" font-weight="600" fill="#1F2326">項目</text>
          <text x="80" y="206" text-anchor="middle" font-family="'IBM Plex Sans',sans-serif" font-size="9" fill="#8A9196">5 個進行中的項目</text>
          <line x1="140" y1="192" x2="170" y2="200" stroke="#DADDDD" stroke-width="1" stroke-dasharray="4 3"/>

          <!-- Right node: Scholars -->
          <rect x="340" y="164" width="120" height="56" rx="2" fill="white" stroke="#DADDDD" stroke-width="1"/>
          <text x="400" y="189" text-anchor="middle" font-family="'IBM Plex Sans',sans-serif" font-size="10" font-weight="600" fill="#1F2326">學者</text>
          <text x="400" y="206" text-anchor="middle" font-family="'IBM Plex Sans',sans-serif" font-size="9" fill="#8A9196">研究員 · 訪問學者</text>
          <line x1="310" y1="192" x2="340" y2="200" stroke="#DADDDD" stroke-width="1" stroke-dasharray="4 3"/>

          <!-- Top-left: Scholarly Indexing -->
          <rect x="20" y="40" width="128" height="52" rx="2" fill="#F7F7F5" stroke="#C5C9C9" stroke-width="1"/>
          <text x="84" y="63" text-anchor="middle" font-family="'IBM Plex Sans',sans-serif" font-size="9.5" font-weight="600" fill="#375A6B">學術索引</text>
          <text x="84" y="79" text-anchor="middle" font-family="'IBM Plex Sans',sans-serif" font-size="8.5" fill="#8A9196">POSI 項目</text>
          <line x1="148" y1="66" x2="170" y2="175" stroke="#E6E8E8" stroke-width="1"/>

          <!-- Top-right: Policy Research -->
          <rect x="332" y="40" width="128" height="52" rx="2" fill="#F7F7F5" stroke="#C5C9C9" stroke-width="1"/>
          <text x="396" y="63" text-anchor="middle" font-family="'IBM Plex Sans',sans-serif" font-size="9.5" font-weight="600" fill="#375A6B">政策研究</text>
          <text x="396" y="79" text-anchor="middle" font-family="'IBM Plex Sans',sans-serif" font-size="8.5" fill="#8A9196">社會 · 治理</text>
          <line x1="332" y1="66" x2="310" y2="175" stroke="#E6E8E8" stroke-width="1"/>

          <!-- Bottom-left: Academic Events -->
          <rect x="20" y="308" width="128" height="52" rx="2" fill="#F7F7F5" stroke="#C5C9C9" stroke-width="1"/>
          <text x="84" y="331" text-anchor="middle" font-family="'IBM Plex Sans',sans-serif" font-size="9.5" font-weight="600" fill="#375A6B">學術活動</text>
          <text x="84" y="347" text-anchor="middle" font-family="'IBM Plex Sans',sans-serif" font-size="8.5" fill="#8A9196">會議 · 研討會</text>
          <line x1="148" y1="334" x2="170" y2="240" stroke="#E6E8E8" stroke-width="1"/>

          <!-- Bottom-right: Collaboration -->
          <rect x="332" y="308" width="128" height="52" rx="2" fill="#F7F7F5" stroke="#C5C9C9" stroke-width="1"/>
          <text x="396" y="331" text-anchor="middle" font-family="'IBM Plex Sans',sans-serif" font-size="9.5" font-weight="600" fill="#375A6B">學術合作</text>
          <text x="396" y="347" text-anchor="middle" font-family="'IBM Plex Sans',sans-serif" font-size="8.5" fill="#8A9196">機構 · 夥伴</text>
          <line x1="332" y1="334" x2="310" y2="240" stroke="#E6E8E8" stroke-width="1"/>
        </svg>
      </div>
    </div>
  </div>
</section>

<!-- ── 02A Announcements ── -->
<section class="section-compact" style="background:var(--bg-white);border-bottom:1px solid var(--border-light);">
  <div class="container">
    <div style="display:flex;justify-content:space-between;align-items:flex-end;margin-bottom:32px;gap:24px;">
      <div>
        <h2 class="section-title" style="margin-bottom:12px;">公告</h2>
        <p class="section-desc">全景研究院的公告、更新與招募資訊。</p>
      </div>
      <a href="/zh-tw/announcements" class="btn btn-secondary" style="flex-shrink:0;">全部公告</a>
    </div>
    <div>
      {announcements.map((item) => (
        <a href={localizeAnnouncementHref(lang, item.slug)} class="announcement-item">
          <div class="announcement-meta">
            <span class="announcement-date">{item.date}</span>
            <span class="tag tag-steel">{item.tag}</span>
          </div>
          <div>
            <h3 class="announcement-title">{item.title}</h3>
            {item.summary && <p class="announcement-desc">{item.summary}</p>}
            <span class="announcement-link">閱讀更多 &rarr;</span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<!-- ── 03 Institutional Statement ── -->
<section class="section-compact" style="background:var(--bg-white);">
  <div class="container">
    <div style="max-width:880px;">
      <div class="statement-box">
        <div style="font-family:var(--font-mono);font-size:11px;letter-spacing:0.12em;text-transform:uppercase;color:var(--text-muted);margin-bottom:14px;">
          機構性質
        </div>
        <h2 style="font-family:var(--font-serif);font-size:22px;color:var(--text-main);margin-bottom:14px;font-weight:400;">
          全景學術集團內部的研究院
        </h2>
        <p style="font-size:15.5px;line-height:1.7;color:var(--text-secondary);margin-bottom:10px;">
          全景研究院是全景學術集團的內部研究與學術發展部門，在研究活動中保持學術獨立，但不具備獨立法人資格。
        </p>
      </div>
    </div>
  </div>
</section>

<!-- ── 04 Institute Framework Preview ── -->
<section class="section" style="background:var(--bg-main);">
  <div class="container">
    <div style="margin-bottom:56px;">
      <h2 class="section-title">研究院組織與職能框架</h2>
      <p class="section-desc">
        一個結構化的研究與學術發展平台，為研究項目、學術出版、研究中心、學術活動、學者計劃與機構合作提供支撐。
      </p>
    </div>

    <div class="org-structure-card" style="margin-bottom:48px;">
      <div class="org-hierarchy">
        <div class="org-node org-node-parent">
          全景學術集團
        </div>
        <div class="org-connector"></div>
        <div class="org-node org-node-institute">
          全景研究院
        </div>
        <div class="org-branch"></div>
        <div class="org-unit-grid">
          {homeFrameworkUnits.map((item, index) => (
            <div class="org-unit-card">
              <div class="org-unit-index">{String(index + 1).padStart(2, '0')}</div>
              <div>
                <div class="org-unit-title">{item.unit}</div>
                <div class="org-unit-role">{item.role}</div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>

    <a href="/zh-tw/framework" class="btn btn-secondary">查看完整框架</a>
  </div>
</section>

<!-- ── 05 Research Areas ── -->
<section class="section" style="background:var(--bg-white);border-top:1px solid var(--border-light);">
  <div class="container">
    <div style="margin-bottom:56px;">
      <h2 class="section-title">研究領域</h2>
      <p class="section-desc">
        研究院聚焦連接學術傳播、期刊評價、公共政策、教育、技術和文化研究的研究領域。
      </p>
    </div>
    <div class="areas-grid">
      {researchAreas.map((area) => (
        <div class="area-card">
          <div class="area-num">{area.num}</div>
          <h3 class="area-title">{area.title}</h3>
          <p class="area-text">{area.desc}</p>
        </div>
      ))}
    </div>
    <div style="margin-top:40px;">
      <a href="/zh-tw/research-areas" class="btn btn-secondary">查看全部研究領域</a>
    </div>
  </div>
</section>

<!-- ── 06 Research Centers ── -->
<section class="section" style="background:var(--bg-main);border-top:1px solid var(--border-light);">
  <div class="container">
    <div style="margin-bottom:48px;">
      <h2 class="section-title">研究中心</h2>
      <p class="section-desc">
        研究院通過專業研究中心組織學術活動，支持研究項目、出版成果、學術活動和合作關係。
      </p>
    </div>
    <div>
      {researchCenters.map((center) => (
        <div class="center-card">
          <div class="center-num">{center.num}</div>
          <div>
            <h3 style="font-family:var(--font-serif);font-size:20px;color:var(--text-main);margin-bottom:6px;">{center.name}</h3>
            <div style="display:flex;flex-wrap:wrap;gap:6px;">
              {center.areas.map((a) => <span class="tag">{a}</span>)}
              {center.upcoming && <span class="tag tag-steel">即將開展</span>}
            </div>
          </div>
          <a href={center.href} class="btn btn-ghost" style="padding-top:0;">查看中心 →</a>
        </div>
      ))}
    </div>
    <div style="margin-top:40px;">
      <a href="/zh-tw/research-centers" class="btn btn-secondary">全部研究中心</a>
    </div>
  </div>
</section>

<!-- ── 07 Featured Projects ── -->
<section class="section" style="background:var(--bg-white);border-top:1px solid var(--border-light);">
  <div class="container">
    <div style="margin-bottom:56px;">
      <h2 class="section-title">重點項目</h2>
      <p class="section-desc">
        全景研究院開發或支持的當前研究項目。
      </p>
    </div>
    <div class="projects-grid">
      {featuredProjects.map((p) => (
        <div class="project-card">
          <div style="margin-bottom:16px;">
            <span class={`tag ${p.status === '進行中' ? 'tag-active' : p.status === '參與徵集' ? 'tag-steel' : ''}`}>
              {p.status}
            </span>
          </div>
          <h3 class="project-title">{p.title}</h3>
          <p class="project-desc">{p.desc}</p>
          <a href={p.href} style="display:inline-flex;align-items:center;gap:6px;margin-top:20px;font-size:13.5px;font-weight:500;color:var(--accent-steel);font-family:var(--font-sans);">
            查看項目 →
          </a>
        </div>
      ))}
    </div>
    <div style="margin-top:40px;">
      <a href="/zh-tw/projects" class="btn btn-secondary">全部研究項目</a>
    </div>
  </div>
</section>

<!-- ── 08 Publications ── -->
<section class="section" style="background:var(--bg-main);border-top:1px solid var(--border-light);">
  <div class="container">
    <div style="display:flex;justify-content:space-between;align-items:flex-end;margin-bottom:48px;gap:24px;">
      <div>
        <h2 class="section-title" style="margin-bottom:12px;">出版成果</h2>
        <p class="section-desc">
          研究院撰寫或支持的研究報告、工作論文、政策簡報、主編文集和年度報告。
        </p>
      </div>
      <a href="/zh-tw/publications" class="btn btn-secondary" style="flex-shrink:0;">全部出版成果</a>
    </div>

    <div>
      {featuredPublications.map((pub) => (
        <div class="publication-item">
          <div class="pub-type">{pub.type}</div>
          <div>
            <div class="pub-title">{pub.title}</div>
            <div class="pub-meta">{pub.team}</div>
          </div>
          <div style="text-align:right;">
            <div style="font-family:var(--font-mono);font-size:13px;color:var(--text-muted);margin-bottom:12px;">{pub.year}</div>
            <a href="/zh-tw/publications" class="btn btn-ghost" style="font-size:13px;">查看詳情 →</a>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ── 09 Charter & Governance Preview ── -->
<section class="section" style="background:var(--bg-white);border-top:1px solid var(--border-light);">
  <div class="container">
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:72px;align-items:start;">
      <div>
        <h2 class="section-title">章程與治理</h2>
        <p class="section-desc" style="margin-bottom:32px;">
          研究院通過結構化的內部章程、治理規則、研究倫理原則、出版政策和合作程序運行。
        </p>
        <div style="display:flex;flex-wrap:wrap;gap:10px;">
          <a href="/zh-tw/charter"                              class="btn btn-primary">閱讀章程</a>
          <a href="/zh-tw/governance/research-ethics"           class="btn btn-secondary">查看治理政策</a>
        </div>
      </div>
      <div>
        {[
          { label: "研究院章程",              href: "/zh-tw/charter" },
          { label: "治理規則",               href: "/zh-tw/governance/rules" },
          { label: "研究倫理",                href: "/zh-tw/governance/research-ethics" },
          { label: "學術獨立聲明",href: "/zh-tw/governance/academic-independence" },
          { label: "利益衝突政策",    href: "/zh-tw/governance/conflict-of-interest" },
          { label: "出版與報告政策",    href: "/zh-tw/governance/publication-report-policy" },
          { label: "資料與文件政策",    href: "/zh-tw/governance/data-documentation-policy" },
        ].map((item) => (
          <a href={item.href} style="display:flex;justify-content:space-between;align-items:center;padding:14px 0;border-bottom:1px solid var(--border-light);font-size:14.5px;color:var(--text-main);transition:color 0.15s;font-family:var(--font-sans);">
            {item.label}
            <span style="color:var(--text-muted);font-size:13px;">&rarr;</span>
          </a>
        ))}
      </div>
    </div>
  </div>
</section>

<!-- ── 10 Events & Calls ── -->
<section class="section" style="background:var(--bg-main);border-top:1px solid var(--border-light);">
  <div class="container">
    <div style="display:flex;justify-content:space-between;align-items:flex-end;margin-bottom:48px;gap:24px;">
      <div>
        <h2 class="section-title" style="margin-bottom:12px;">活動與徵集</h2>
        <p class="section-desc">即將開展的會議、研討會、工作坊、論文徵稿和章節徵集。</p>
      </div>
      <a href="/zh-tw/events" class="btn btn-secondary" style="flex-shrink:0;">全部活動</a>
    </div>
    <div>
      {upcomingEvents.map((ev) => (
        <div class="event-item">
          <div class="event-date">{ev.date.split(' ')[0]}<br />{ev.date.split(' ')[1]}</div>
          <div>
            <span class="tag" style="margin-bottom:10px;display:inline-flex;">{ev.type}</span>
            <h3 class="event-title">{ev.title}</h3>
            <p class="event-meta">{ev.location}</p>
          </div>
          <div style="text-align:right;padding-top:4px;">
            <span class="tag tag-steel">{ev.status}</span>
          </div>
        </div>
      ))}
    </div>
    <div style="margin-top:32px;display:flex;gap:12px;flex-wrap:wrap;">
      <a href="/zh-tw/events/calls-for-papers"   class="btn btn-secondary">論文徵稿</a>
      <a href="/zh-tw/events/calls-for-chapters" class="btn btn-secondary">章節徵集</a>
    </div>
  </div>
</section>

<!-- ── 11 Collaboration ── -->
<section class="section" style="background:var(--bg-dark);border-top:1px solid var(--border-light);">
  <div class="container">
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:72px;align-items:center;">
      <div>
        <h2 style="font-family:var(--font-serif);font-size:clamp(26px,3.5vw,38px);line-height:1.2;color:var(--text-inverse);margin-bottom:20px;letter-spacing:-0.02em;">
          與全景研究院合作
        </h2>
        <p style="font-size:16px;line-height:1.75;color:rgba(255,255,255,0.6);margin-bottom:32px;">
          研究院歡迎學術合作、機構夥伴關係、研究項目提案、主編文集提案、訪問學者申請和學術活動合作。
        </p>
        <div style="display:flex;flex-wrap:wrap;gap:10px;">
          <a href="/zh-tw/collaboration/submit" style="background:var(--bg-white);color:var(--text-main);border:1px solid var(--bg-white);" class="btn">提交提案</a>
          <a href="/zh-tw/contact"             style="background:transparent;color:var(--text-inverse);border:1px solid rgba(255,255,255,0.3);" class="btn">聯絡研究院</a>
        </div>
      </div>
      <div>
        {[
