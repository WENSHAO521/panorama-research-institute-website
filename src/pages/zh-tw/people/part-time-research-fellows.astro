---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/PageHero.astro';
---
<BaseLayout title="兼職研究員" description="全景研究院兼職研究員。">
  <PageHero
    title="兼職研究員"
    description="兼職研究員通道面向在其他機構或單位擔任主要職務、希望以較低強度參與全景研究院工作的研究人員。"
    breadcrumbs={[{ label: "學術成員", href: "/zh-tw/people" }, { label: "兼職研究員" }]}
  />

  <section class="section" style="background:var(--bg-white);">
    <div class="container">
      <div style="display:grid;grid-template-columns:1fr 2fr;gap:64px;align-items:start;">
        <div>
          <div class="section-label">職位詳情</div>
          <div style="display:flex;flex-direction:column;gap:16px;margin-top:8px;">
            {[
              { label:"頭銜",     value:"全景研究院兼職研究員" },
              { label:"適合對象", value:"在其他機構擔任主要職務的研究人員或從業者" },
              { label:"期限",     value:"1 年，可續期" },
              { label:"形式",     value:"遠端（分散式），時間安排靈活" },
              { label:"成果要求", value:"成果要求相應減少或按項目計算" },
              { label:"申請方式", value:"開放申請（滾動）" },
            ].map((item) => (
              <div>
                <div style="font-size:11px;font-family:var(--font-mono);text-transform:uppercase;letter-spacing:0.1em;color:var(--text-muted);margin-bottom:4px;">{item.label}</div>
                <div style="font-size:14.5px;color:var(--text-main);">{item.value}</div>
              </div>
            ))}
          </div>
          <div style="margin-top:28px;display:flex;flex-direction:column;gap:8px;">
            <a href="/zh-tw/collaboration/research-fellow-application" class="btn btn-primary" style="width:100%;justify-content:center;">立即申請</a>
            <a href="/zh-tw/people/research-fellows" class="btn btn-secondary" style="width:100%;justify-content:center;">研究員</a>
          </div>
        </div>
        <div>
          <h2 style="font-family:var(--font-serif);font-size:24px;color:var(--text-main);margin-bottom:16px;font-weight:400;">關於兼職研究員</h2>
          <p style="font-size:16px;line-height:1.85;color:var(--text-secondary);margin-bottom:20px;">
            兼職研究員職位面向在其他機構或單位擔任主要學術或專業職務、但希望與全景研究院保持長期、較低強度合作關係的研究人員或從業者。該通道適合無法達到研究員完整產出要求、但仍希望為研究院研究項目作出貢獻的學者。
          </p>
          <p style="font-size:16px;line-height:1.85;color:var(--text-secondary);margin-bottom:32px;">
            兼職研究員按減少後的節奏或以項目為單位參與研究院的項目和出版工作，並依自身時間安排參與部分研究院活動。具體貢獻條款由本人與相關研究中心在任命時協商確定。
          </p>

          <div style="padding:24px;background:var(--bg-soft);border:1px solid var(--border-light);">
            <div style="font-family:var(--font-mono);font-size:11px;letter-spacing:0.08em;text-transform:uppercase;color:var(--text-muted);margin-bottom:8px;">現任團隊</div>
            <p style="font-size:14.5px;color:var(--text-secondary);margin:0;line-height:1.7;">
              研究院正在為兼職研究員通道接受申請。獲聘研究員將在任命後列於本頁面。
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
<style>
@media (max-width: 900px) {
  div[style*="grid-template-columns:1fr 2fr"] { display: block !important; }
}
</style>
