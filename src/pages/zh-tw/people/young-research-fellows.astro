---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/PageHero.astro';
---
<BaseLayout title="青年研究員" description="全景研究院青年研究員。">
  <PageHero
    title="青年研究員"
    description="青年研究員通道面向博士後及早期職涯研究者，支持其在全景研究院的項目中建立獨立研究方向。"
    breadcrumbs={[{ label: "學術成員", href: "/zh-tw/people" }, { label: "青年研究員" }]}
  />

  <section class="section" style="background:var(--bg-white);">
    <div class="container">
      <div style="display:grid;grid-template-columns:1fr 2fr;gap:64px;align-items:start;">
        <div>
          <div class="section-label">職位詳情</div>
          <div style="display:flex;flex-direction:column;gap:16px;margin-top:8px;">
            {[
              { label:"頭銜",     value:"全景研究院青年研究員" },
              { label:"適合對象", value:"博士後或早期職涯研究者，博士畢業五年以內" },
              { label:"期限",     value:"1–2 年，可續期" },
              { label:"形式",     value:"遠端（分散式）——無需搬遷" },
              { label:"成果要求", value:"每兩年至少 1 項出版成果" },
              { label:"申請方式", value:"開放申請（滾動）" },
            ].map((item) => (
              <div>
                <div style="font-size:11px;font-family:var(--font-mono);text-transform:uppercase;letter-spacing:0.1em;color:var(--text-muted);margin-bottom:4px;">{item.label}</div>
                <div style="font-size:14.5px;color:var(--text-main);">{item.value}</div>
              </div>
            ))}
          </div>
          <div style="margin-top:28px;display:flex;flex-direction:column;gap:8px;">
            <a href="/zh-tw/collaboration/research-fellow-application" class="btn btn-primary" style="width:100%;justify-content:center;">立即申請</a>
            <a href="/zh-tw/people/research-fellows" class="btn btn-secondary" style="width:100%;justify-content:center;">研究員</a>
          </div>
        </div>
        <div>
          <h2 style="font-family:var(--font-serif);font-size:24px;color:var(--text-main);margin-bottom:16px;font-weight:400;">關於青年研究員</h2>
          <p style="font-size:16px;line-height:1.85;color:var(--text-secondary);margin-bottom:20px;">
            青年研究員職位面向博士後及早期職涯研究者，通常為博士畢業五年以內、已確立獨立研究方向並希望與全景研究院建立聯繫的學者。青年研究員定位介於副研究員與研究員之間，認可那些已完成博士訓練但尚未進入中級職涯階段的學者。
          </p>
          <p style="font-size:16px;line-height:1.85;color:var(--text-secondary);margin-bottom:32px;">
            青年研究員參與研究院的研究項目、參加研究院活動，並依早期職涯研究者相應的節奏在研究院項目框架內發表成果。持續貢獻者可被考慮晉升為研究員。
          </p>

          <div style="padding:24px;background:var(--bg-soft);border:1px solid var(--border-light);">
            <div style="font-family:var(--font-mono);font-size:11px;letter-spacing:0.08em;text-transform:uppercase;color:var(--text-muted);margin-bottom:8px;">現任團隊</div>
            <div style="padding-bottom:16px;border-bottom:1px solid var(--border-light);">
              <h3 style="font-family:var(--font-sans);font-size:16px;font-weight:600;color:var(--text-main);margin-bottom:4px;">張碧如 博士</h3>
              <div style="font-size:13px;color:var(--text-muted);margin-bottom:8px;">全景研究院青年研究員</div>
              <p style="font-size:14.5px;color:var(--text-secondary);margin:0;line-height:1.7;">研究方向：舞蹈教育；美育研究；民族舞蹈文化傳承；跨文化藝術比較。</p>
            </div>
            <p style="font-size:14.5px;color:var(--text-secondary);margin:16px 0 0;line-height:1.7;">
              研究院持續為青年研究員通道接受滾動申請。獲聘研究員將在任命後列於本頁面。
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
<style>
@media (max-width: 900px) {
  div[style*="grid-template-columns:1fr 2fr"] { display: block !important; }
}
</style>
