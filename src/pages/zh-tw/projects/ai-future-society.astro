---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/PageHero.astro';
---
<BaseLayout title="人工智慧與未來社會研究項目" description="人工智慧與未來社會研究中心的首個研究項目，探討人工智慧治理、倫理及其對學術傳播的影響。">
  <PageHero
    title="人工智慧與未來社會研究項目"
    description="一項創始研究項目，考察人工智慧的治理、倫理和社會影響，重點關注人工智慧對學術傳播、知識生產和學術出版的影響。"
    breadcrumbs={[{ label: "研究", href: "/zh-tw/research-areas" }, { label: "項目", href: "/zh-tw/projects" }, { label: "人工智慧與未來社會" }]}
    tag="開發中"
  >
  </PageHero>

  <section class="section" style="background:var(--bg-white);">
    <div class="container">
      <div style="display:grid;grid-template-columns:1fr 2fr;gap:64px;align-items:start;">
        <div>
          <div class="section-label">項目詳情</div>
          <div style="display:flex;flex-direction:column;gap:20px;margin-top:8px;">
            {[
              { label: "狀態",       value: "開發中" },
              { label: "已發布",    value: "2026" },
              { label: "牽頭中心",  value: "人工智慧與未來社會研究中心" },
              { label: "中心狀態","": "", value: "即將開展（預計 2027 年）" },
              { label: "項目類型", value: "跨學科研究" },
              { label: "聯絡",      value: "research@panorama-sg.com" },
            ].map((item) => (
              <div>
                <div style="font-size:11px;font-family:var(--font-mono);text-transform:uppercase;letter-spacing:0.1em;color:var(--text-muted);margin-bottom:4px;">{item.label}</div>
                <div style="font-size:14.5px;color:var(--text-main);">{item.value}</div>
              </div>
            ))}
          </div>
          <div style="margin-top:32px;display:flex;flex-direction:column;gap:8px;">
            <a href="/zh-tw/research-centers/ai-future-society" class="btn btn-primary" style="justify-content:center;">牽頭中心</a>
            <a href="/zh-tw/collaboration/research-project-proposal" class="btn btn-secondary" style="justify-content:center;">合作</a>
          </div>
        </div>
        <div>
          <div style="background:var(--bg-soft);border:1px solid var(--border-light);padding:20px 24px;margin-bottom:28px;">
            <div style="font-family:var(--font-mono);font-size:11px;letter-spacing:0.1em;text-transform:uppercase;color:var(--accent-steel);margin-bottom:8px;">項目狀態</div>
            <p style="font-size:14px;color:var(--text-secondary);margin:0;line-height:1.6;">本項目目前處於初步規劃和範圍界定階段。牽頭研究中心「人工智慧與未來社會研究中心」預計於 2026 年正式設立。有意參與本項目的研究人員可聯絡研究院。</p>
          </div>
          <h2 style="font-family:var(--font-serif);font-size:28px;color:var(--text-main);margin-bottom:20px;font-weight:400;">關於項目</h2>
          <p style="font-size:16px;line-height:1.85;color:var(--text-secondary);margin-bottom:20px;">
            人工智慧與未來社會研究項目是人工智慧與未來社會研究中心的創始項目，關注人工智慧作為技術、治理挑戰和社會現象，如何重塑人類制度、知識體系和未來。
          </p>
          <p style="font-size:16px;line-height:1.85;color:var(--text-secondary);margin-bottom:20px;">
            本項目範圍涵蓋三個相互交叉的主題：人工智慧治理（人工智慧系統如何在機構、國家和國際層面受到監管、問責和治理）；人工智慧倫理（人工智慧發展的規範維度，包括公平性、透明度、隱私和自主性）；以及學術中的人工智慧（人工智慧系統如何融入學術研究、出版與傳播，以及這種融入帶來的治理挑戰）。
          </p>
          <p style="font-size:16px;line-height:1.85;color:var(--text-secondary);">
            本項目採取明確的跨學科方法，匯集技術研究、政治學、哲學、傳播學和資訊科學等領域的研究人員，旨在形成兼具學術嚴謹性和政策相關性的研究成果。
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section" style="background:var(--bg-main);border-top:1px solid var(--border-light);">
    <div class="container">
      <div class="section-label">研究議程</div>
      <h2 class="section-title">核心研究問題</h2>
      <div style="max-width:820px;margin-top:8px;">
        {[
          { q: "不同國家和機構情境中如何治理和監管人工智慧系統？治理差異會帶來哪些影響？" },
          { q: "對於部署在公共和學術情境中的人工智慧系統，何種倫理框架最適合評估其公平性、透明度和問責性？" },
          { q: "人工智慧融入學術出版，包括 AI 生成文本、AI 輔助同儕評審和 AI 編輯工具，正在如何重塑學術傳播規範與實踐？" },
          { q: "需要何種治理框架來應對大型語言模型在學術研究和出版中的使用？" },
          { q: "青年如何體驗和理解人工智慧系統？這對數位公民身分、教育和治理意味著什麼？" },
          { q: "將知識生產任務交由人工智慧系統承擔，會產生哪些長期社會與認識論影響？" },
        ].map((item, i) => (
          <div style="display:flex;gap:16px;padding:16px 0;border-bottom:1px solid var(--border-light);">
            <span style="font-family:var(--font-mono);font-size:12px;color:var(--text-muted);flex-shrink:0;padding-top:2px;">{String(i+1).padStart(2,'0')}</span>
            <p style="font-size:15px;color:var(--text-secondary);line-height:1.75;margin:0;">{item.q}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section-compact" style="background:var(--bg-white);border-top:1px solid var(--border-light);">
    <div class="container">
      <div style="display:flex;align-items:center;justify-content:space-between;gap:24px;flex-wrap:wrap;">
        <div>
          <h2 style="font-family:var(--font-serif);font-size:22px;color:var(--text-main);margin-bottom:8px;">有意參與貢獻？</h2>
          <p style="font-size:15px;color:var(--text-secondary);">本項目正在尋求在人工智慧、數位治理、科學技術研究及相關領域具有專長的研究人員參與。</p>
        </div>
        <div style="display:flex;gap:10px;flex-wrap:wrap;">
          <a href="/zh-tw/collaboration/research-fellow-application" class="btn btn-primary">申請研究員</a>
          <a href="/zh-tw/collaboration/research-project-proposal" class="btn btn-secondary">提交提案</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
<style>
@media (max-width: 900px) {
  div[style*="grid-template-columns:1fr 2fr"] { display: block !important; }
}
</style>
