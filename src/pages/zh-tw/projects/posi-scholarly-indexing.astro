---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/PageHero.astro';
---
<BaseLayout title="POSI 學術索引項目" description="全景開放學術索引項目 — 已開發完成、等待正式上線的學術資料庫。">
  <PageHero
    title="POSI 學術索引項目"
    description="一個長期學術基礎設施項目，旨在建立透明、全面且方法嚴謹的開放學術期刊索引。資料庫已經開發完畢，正在等待正式上線。"
    breadcrumbs={[{ label: "研究", href: "/zh-tw/research-areas" }, { label: "項目", href: "/zh-tw/projects" }, { label: "POSI 學術索引" }]}
    tag="進行中的項目"
  >
  </PageHero>

  <section class="section" style="background:var(--bg-white);">
    <div class="container">
      <div style="display:grid;grid-template-columns:1fr 2fr;gap:64px;align-items:start;">
        <div>
          <div class="section-label">項目詳情</div>
          <div style="display:flex;flex-direction:column;gap:20px;margin-top:8px;">
            {[
              { label: "狀態",          value: "已開發完成，等待正式上線" },
              { label: "階段",           value: "上線前" },
              { label: "開始日期",      value: "2026" },
              { label: "預計發布", value: "等待正式上線" },
              { label: "牽頭中心",     value: "學術索引與評價研究中心" },
              { label: "項目類型",    value: "開放學術基礎設施" },
            ].map((item) => (
              <div>
                <div style="font-size:11px;font-family:var(--font-mono);text-transform:uppercase;letter-spacing:0.1em;color:var(--text-muted);margin-bottom:4px;">{item.label}</div>
                <div style="font-size:14.5px;color:var(--text-main);">{item.value}</div>
              </div>
            ))}
          </div>
          <div style="margin-top:32px;display:flex;flex-direction:column;gap:8px;">
            <a href="/zh-tw/research-centers/scholarly-indexing-evaluation" class="btn btn-primary" style="justify-content:center;">牽頭中心</a>
            <a href="/zh-tw/collaboration/research-project-proposal" class="btn btn-secondary" style="justify-content:center;">合作</a>
          </div>
        </div>
        <div>
          <h2 style="font-family:var(--font-serif);font-size:28px;color:var(--text-main);margin-bottom:20px;font-weight:400;">關於項目</h2>
          <p style="font-size:16px;line-height:1.85;color:var(--text-secondary);margin-bottom:20px;">
            全景開放學術索引（POSI）項目是全景研究院的旗艦研究與基礎設施項目。其主要目標是開發一個全面、可供公眾存取且方法透明的學術期刊索引，涵蓋期刊編輯實踐、索引狀態、同儕評審標準、開放取用政策、出版倫理承諾以及其他與學術品質相關的維度。
          </p>
          <p style="font-size:16px;line-height:1.85;color:var(--text-secondary);margin-bottom:20px;">
            POSI 以開放和透明為原則運行：其方法將公開形成文件，其評價標準接受學術同儕審查，其資料將免費向研究人員、機構、出版社、資助方和政策制定者開放。不同於商業索引系統，POSI 對任何期刊的納入或排除均不具有財務利益。
          </p>
          <p style="font-size:16px;line-height:1.85;color:var(--text-secondary);">
            POSI 被設計為一個長期基礎設施項目。資料庫已經開發完畢，目前處於上線前階段，最後檢查重點包括方法文件、資料品質、存取流程和公開呈現。後續階段將擴大覆蓋範圍，深化資料維度，並開發更多資料存取和視覺化工具。
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section" style="background:var(--bg-main);border-top:1px solid var(--border-light);">
    <div class="container">
      <div class="section-label">研究方法</div>
      <h2 class="section-title">評價維度</h2>
      <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:var(--border-light);border:1px solid var(--border-light);margin-top:8px;">
        {[
          { num:"01", dim:"編輯標準",        desc:"評估編輯政策、作者指南、範圍聲明以及編輯決策流程的透明度。" },
          { num:"02", dim:"同儕評審實踐",       desc:"記錄同儕評審模式（單盲、雙盲、開放評審）、評審人指南和品質保障流程。" },
          { num:"03", dim:"索引與可發現性", desc:"記錄主要和次級索引（Scopus、WoS、DOAJ、ESCI、Google Scholar、Dimensions 等）的收錄情況、日期和覆蓋層級。" },
          { num:"04", dim:"開放取用狀態",         desc:"分類記錄開放取用模式（金色、鑽石、綠色、混合）、APC 水準、授權條款和權利保留政策。" },
          { num:"05", dim:"出版倫理合規", desc:"記錄期刊對 COPE 指南、撤稿政策、更正政策、作者身分標準和利益衝突揭露的承諾。" },
          { num:"06", dim:"期刊後設資料品質",   desc:"評估期刊後設資料的完整性和準確性，包括 ISSN、DOI 註冊、文章級後設資料和 ORCID 整合。" },
        ].map((item) => (
          <div class="card" style="border:none;border-radius:0;">
            <div style="font-family:var(--font-mono);font-size:11px;color:var(--text-muted);margin-bottom:8px;">{item.num}</div>
            <h3 style="font-family:var(--font-sans);font-size:15px;font-weight:600;color:var(--text-main);margin-bottom:10px;">{item.dim}</h3>
            <p style="font-size:14px;line-height:1.7;color:var(--text-secondary);">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section" style="background:var(--bg-white);border-top:1px solid var(--border-light);">
    <div class="container">
      <div class="section-label">項目路線圖</div>
      <h2 class="section-title">發展階段</h2>
      <div style="max-width:780px;margin-top:8px;">
        {[
          { phase:"第一階段", period:"2026", status:"當前", items:["完成 POSI 資料庫開發工作","最終確定並記錄 POSI 方法和評價框架","審查期刊記錄的資料模型和後設資料架構","準備面向公眾發布的初始期刊覆蓋清單","完成上線前資料品質檢查","籌備公共資料庫正式上線"] },
          { phase:"第二階段", period:"上線後", status:"即將開展", items:["將期刊覆蓋範圍擴展至更多學科和地區","根據用戶反饋優化面向公眾的資料庫介面","發布 API 或結構化資料存取選項","由外部學者對 POSI 方法進行同儕評審","啟動機構用戶計畫"] },
          { phase:"第三階段", period:"2028+", status:"規劃中", items:["拓展為獲得認可的全球性資源","將 POSI 資料與開放學術基礎設施（OpenAlex、Crossref）整合","建立定期更新與審查週期","根據用戶反饋開發擴展資料維度","探索長期可持續治理模式"] },
        ].map((phase) => (
          <div style="margin-bottom:40px;padding-bottom:40px;border-bottom:1px solid var(--border-light);">
            <div style="display:grid;grid-template-columns:160px 1fr;gap:40px;align-items:start;">
              <div>
                <div style="font-family:var(--font-serif);font-size:20px;color:var(--text-main);margin-bottom:4px;">{phase.phase}</div>
                <div style="font-family:var(--font-mono);font-size:12px;color:var(--text-muted);margin-bottom:12px;">{phase.period}</div>
                <span class={`tag ${phase.status === '當前' ? 'tag-active' : phase.status === '即將開展' ? 'tag-steel' : ''}`}>{phase.status}</span>
              </div>
              <div>
                {phase.items.map((item) => (
                  <div style="display:flex;gap:10px;padding:8px 0;border-bottom:1px solid var(--bg-soft);">
                    <span style="color:var(--text-muted);flex-shrink:0;font-size:14px;">&#8212;</span>
                    <span style="font-size:14.5px;color:var(--text-secondary);line-height:1.7;">{item}</span>
                  </div>
                ))}
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
<style>
@media (max-width: 900px) {
  div[style*="grid-template-columns:1fr 2fr"],
  div[style*="grid-template-columns:160px 1fr"] { display: block !important; }
  div[style*="grid-template-columns:repeat(3,1fr)"] { grid-template-columns: repeat(2,1fr) !important; }
}
@media (max-width: 600px) {
  div[style*="grid-template-columns:repeat(3,1fr)"],
  div[style*="grid-template-columns:repeat(2,1fr)"] { display: block !important; }
}
</style>
