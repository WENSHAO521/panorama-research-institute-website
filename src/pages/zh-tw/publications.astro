---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';

const categories = ["全部", "研究報告", "工作論文", "政策簡報", "主編文集", "年度報告", "資助期刊論文"];

const publications: { type: string; title: string; team: string; year: string; status: string; journal?: string; doi?: string; url?: string; sponsor?: string }[] = [
  { type: "資助期刊論文", title: "Assessing the quality and reliability of short video platforms as sources of information on depression among Chinese adolescents: a comparative study with data from Douyin, Bilibili, WeChat, and Xiaohongshu APPs", team: "Qilong Wang, Xixi Fan, Xin Qi, Yuyu Zhang, Yayan Wang, Chen Wang, Qian Wu, ChengWen Song, Siheng Ma", year: "2026", status: "已發布", journal: "Health Nexus: Digital Health and Medical AI, Vol. 1, No. 1, pp. 14–36", doi: "10.63802/hndh.V1.I1.356", url: "https://journals.panorama-sg.com/hndh/article/view/356", sponsor: "全景研究院資助 · No. PSG-PRI-SPN-2026-000017" },
  { type: "資助期刊論文", title: "Liturgical Sonic Order in the Catholic Mass: Music, Participation, and the German-Language Gotteslob", team: "Yanlin Feng, Sebastian Lenz", year: "2026", status: "已發布", journal: "Resonance: Journal of Global Music Studies, Vol. 2, No. 2, pp. 31–43", doi: "10.63802/rjgms.V2.I2.360", url: "https://journals.panorama-sg.com/Resonance/article/view/360", sponsor: "全景研究院資助 · No. PSG-PRI-SPN-2026-000015" },
  { type: "資助期刊論文", title: "From Technological Capability to Disaster Governance in North Korea: An Evidence-Bounded Framework from Scientific Publications", team: "Leyuan Liu", year: "2026", status: "已發布", journal: "PoliEcoM Administration Review, Vol. 2, No. 2, pp. 1–18", doi: "10.63802/pemr.V2.I2.357", url: "https://journals.panorama-sg.com/pemr/article/view/357", sponsor: "全景研究院資助 · No. PSG-PRI-SPN-2026-000014" },
];
import PublicationsEmpty from '../../components/PublicationsEmpty.astro';
---

<BaseLayout
  title="出版成果"
  description="全景研究院撰寫或支持的研究報告、工作論文、政策簡報、主編文集和年度報告。"
>
  <PageHero
    title="出版成果"
    description="研究院撰寫或支持的研究報告、工作論文、政策簡報、主編文集和年度報告。"
    breadcrumbs={[{ label: "出版成果" }]}
  />

  <!-- Category Filter -->
  {publications.length > 0 && (
  <section style="background:var(--bg-white);border-bottom:1px solid var(--border-light);padding:20px 0;">
    <div class="container">
      <div class="pub-filter" style="display:flex;gap:8px;flex-wrap:wrap;">
        {categories.map((c, i) => (
          <button class={`tag ${i === 0 ? 'tag-active' : ''}`} style="cursor:pointer;" type="button" data-cat={c}>{c}</button>
        ))}
      </div>
    </div>
  </section>
  )}

  <!-- Publications List -->
  <section class="section" style="background:var(--bg-main);">
    <div class="container">
      {publications.length === 0 && <PublicationsEmpty lang="zh-tw" />}
      {publications.map((pub) => (
        <div class="publication-item" data-type={pub.type}>
          <div>
            <div class="pub-type">{pub.type}</div>
            <div style="margin-top:8px;">
              <span class={`tag ${pub.status === '已發布' ? 'tag-active' : pub.status === '即將發布' ? 'tag-steel' : ''}`} style="font-size:11px;">
                {pub.status}
              </span>
            </div>
          </div>
          <div>
            <div class="pub-title">{pub.title}</div>
            <div class="pub-meta" style="margin-top:6px;">{pub.team}</div>
            {pub.journal && <div class="pub-meta" style="margin-top:4px;font-style:italic;">{pub.journal}</div>}
            {pub.doi && <div class="pub-meta" style="margin-top:4px;">DOI: <a href={`https://doi.org/${pub.doi}`} target="_blank" rel="noopener noreferrer">{pub.doi}</a></div>}
            {pub.sponsor && <div class="pub-meta" style="margin-top:4px;">{pub.sponsor}</div>}
          </div>
          <div style="text-align:right;">
            <div style="font-family:var(--font-mono);font-size:13px;color:var(--text-muted);margin-bottom:16px;">{pub.year}</div>
            {pub.status === '已發布' && (
              <div style="display:flex;flex-direction:column;gap:6px;align-items:flex-end;">
                {pub.url ? <a href={pub.url} target="_blank" rel="noopener noreferrer" class="btn btn-secondary" style="font-size:12px;padding:7px 14px;">查看文章 &rarr;</a> : <a href="#" class="btn btn-secondary" style="font-size:12px;padding:7px 14px;">PDF</a>}
                <a href="#" class="btn-ghost btn" style="font-size:12.5px;padding:0;">引用 →</a>
              </div>
            )}
          </div>
        </div>
      ))}
    </div>
  </section>

  <script>
    const filterButtons = document.querySelectorAll<HTMLButtonElement>('.pub-filter [data-cat]');
    const items = document.querySelectorAll<HTMLElement>('.publication-item[data-type]');

    filterButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const cat = btn.dataset.cat;
        filterButtons.forEach((b) => b.classList.remove('tag-active'));
        btn.classList.add('tag-active');
        items.forEach((item) => {
          const show = cat === '全部' || item.dataset.type === cat;
          item.style.display = show ? '' : 'none';
        });
      });
    });
  </script>

  <!-- Citation Format -->
  <section class="section-compact" style="background:var(--bg-white);border-top:1px solid var(--border-light);">
    <div class="container">
      <div style="max-width:760px;">
        <div class="section-label">建議引用格式</div>
        <h2 style="font-family:var(--font-serif);font-size:24px;color:var(--text-main);margin-bottom:20px;font-weight:400;">如何引用本院出版成果</h2>
        <div style="background:var(--bg-soft);border:1px solid var(--border-light);padding:24px 28px;margin-bottom:20px;font-family:var(--font-mono);font-size:13.5px;line-height:1.7;color:var(--text-secondary);">
          全景研究院（2026）。 <em>報告標題</em>。全景學術集團。
        </div>
        <div style="margin-top:24px;">
          <a href="/zh-tw/publications/citation" class="btn btn-secondary">完整引用指南</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Publication Guidelines -->
  <section class="section-compact" style="background:var(--bg-main);border-top:1px solid var(--border-light);">
    <div class="container">
      <div style="display:flex;align-items:center;justify-content:space-between;gap:24px;flex-wrap:wrap;">
        <div>
          <h2 style="font-family:var(--font-serif);font-size:22px;color:var(--text-main);margin-bottom:8px;">出版指南</h2>
          <p style="font-size:14.5px;color:var(--text-secondary);">以研究院名義發布出版成果的標準與程序。</p>
        </div>
        <div style="display:flex;gap:10px;flex-wrap:wrap;">
          <a href="/zh-tw/publications/guidelines" class="btn btn-primary">查看指南</a>
          <a href="/zh-tw/collaboration/research-project-proposal" class="btn btn-secondary">提交提案</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
