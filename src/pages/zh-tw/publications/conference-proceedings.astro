---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/PageHero.astro';
import PublicationsEmpty from '../../../components/PublicationsEmpty.astro';
---
<BaseLayout title="會議論文集" description="全景研究院組織或聯合組織的學術活動的記錄與論文集。">
  <PageHero
    title="會議論文集"
    description="全景研究院組織或聯合組織的會議、研討會和工作坊的記錄與論文集，適用時予以出版。"
    breadcrumbs={[{ label: "出版成果", href: "/zh-tw/publications" }, { label: "會議論文集" }]}
  />

  <section class="section" style="background:var(--bg-white);">
    <div class="container">
      <div style="display:grid;grid-template-columns:1fr 2fr;gap:64px;align-items:start;" class="stack-mobile">
        <div>
          <div class="section-label">系列信息</div>
          <div style="display:flex;flex-direction:column;gap:16px;margin-top:8px;">
            {[
              { label: "形式", value: "論文集或活動記錄" },
              { label: "來源", value: "研究院組織或聯合組織的活動" },
              { label: "評審", value: "依各活動徵稿啟事所定" },
              { label: "獲取方式", value: "開放獲取，但受保護期約束的除外" },
              { label: "DOI", value: "已註冊（Crossref）" },
              { label: "編制", value: "學術活動事務部" },
            ].map((item) => (
              <div>
                <div style="font-size:11px;font-family:var(--font-mono);text-transform:uppercase;letter-spacing:0.1em;color:var(--text-muted);margin-bottom:4px;">{item.label}</div>
                <div style="font-size:14.5px;color:var(--text-main);">{item.value}</div>
              </div>
            ))}
          </div>
          <div style="margin-top:32px;display:flex;flex-direction:column;gap:8px;">
            <a href="/zh-tw/events" class="btn btn-primary" style="width:100%;justify-content:center;">學術活動</a>
            <a href="/zh-tw/publications" class="btn btn-secondary" style="width:100%;justify-content:center;">全部出版成果</a>
          </div>
        </div>
        <div>
          <h2 style="font-family:var(--font-serif);font-size:24px;color:var(--text-main);margin-bottom:16px;font-weight:400;">關於會議論文集</h2>
          <p style="font-size:16px;line-height:1.85;color:var(--text-secondary);margin-bottom:20px;">
            會議論文集彙集研究院組織或聯合組織的學術活動（包括會議、研討會和工作坊）的論文、摘要和記錄，適用時由學術活動事務部編制，該部門負責活動記錄和論文集的編制。
          </p>
          <p style="font-size:16px;line-height:1.85;color:var(--text-secondary);margin-bottom:32px;">
            論文集依研究院的開放獲取規則發布並獲得 DOI。依章程第 17 條已書面約定保護期的，論文集在保護期屆滿後公開。
          </p>
          <PublicationsEmpty lang="zh-tw" />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
