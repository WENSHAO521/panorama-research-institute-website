---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/PageHero.astro';
import JournalArticleList from '../../../components/JournalArticleList.astro';
---
<BaseLayout title="期刊論文" description="作者含研究院成員、並獲研究院資助的期刊論文。">
  <PageHero
    title="期刊論文"
    description="作者含研究院成員、並獲研究院資助的期刊論文。作者主要來自研究院以外的資助成果，列於“資助”。"
    breadcrumbs={[{ label: "出版成果", href: "/zh-tw/publications" }, { label: "期刊論文" }]}
  />

  <section class="section" style="background:var(--bg-main);">
    <div class="container">
      <JournalArticleList lang="zh-tw" membersOnly />
    </div>
  </section>
</BaseLayout>
