---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/PageHero.astro';
import JournalArticleList from '../../../components/JournalArticleList.astro';
---
<BaseLayout title="期刊論文" description="獲全景研究院資助的期刊論文，以及研究院成員的學術成果。">
  <PageHero
    title="期刊論文"
    description="匯集獲全景研究院資助的期刊論文，以及研究院成員的學術成果。"
    breadcrumbs={[{ label: "出版成果", href: "/zh-tw/publications" }, { label: "期刊論文" }]}
  />

  <section class="section" style="background:var(--bg-main);">
    <div class="container">
      <JournalArticleList lang="zh-tw" grouped />
    </div>
  </section>
</BaseLayout>
