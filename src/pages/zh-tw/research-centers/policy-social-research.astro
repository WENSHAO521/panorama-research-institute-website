---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/PageHero.astro';
---
<BaseLayout title="政策與社會研究中心" description="專注於高等教育政策、科學政策、青年數位治理以及學術傳播社會維度的研究中心。">
  <PageHero
    title="政策與社會研究中心"
    description="研究高等教育政策、科學與創新政策、青少年數位治理，以及學術傳播和學術出版的社會維度。"
    breadcrumbs={[{ label: "研究", href: "/zh-tw/research-areas" }, { label: "研究中心", href: "/zh-tw/research-centers" }, { label: "政策與社會研究" }]}
    tag="運行中的研究中心"
  >
  </PageHero>

  <section class="section" style="background:var(--bg-white);">
    <div class="container">
      <div style="display:grid;grid-template-columns:1fr 2fr;gap:64px;align-items:start;">
        <div>
          <div class="section-label">概覽</div>
          <div style="display:flex;flex-direction:column;gap:20px;margin-top:8px;">
            {[
              { label: "中心狀態",   value: "進行中" },
              { label: "已設立",     value: "2026" },
              { label: "研究領域",   value: "政策與社會研究" },
              { label: "進行中的項目", value: "2" },
              { label: "出版成果",    value: "1 份研究報告，1 份政策簡報" },
              { label: "聯絡",         value: "research@panorama-sg.com" },
            ].map((item) => (
              <div>
                <div style="font-size:11px;font-family:var(--font-mono);text-transform:uppercase;letter-spacing:0.1em;color:var(--text-muted);margin-bottom:4px;">{item.label}</div>
                <div style="font-size:14.5px;color:var(--text-main);">{item.value}</div>
              </div>
            ))}
          </div>
          <div style="margin-top:32px;display:flex;flex-direction:column;gap:8px;">
            <a href="/zh-tw/collaboration/research-project-proposal"  class="btn btn-primary" style="justify-content:center;">提交提案</a>
            <a href="/zh-tw/collaboration/visiting-scholar-application" class="btn btn-secondary" style="justify-content:center;">訪問學者</a>
          </div>
        </div>
        <div>
          <h2 style="font-family:var(--font-serif);font-size:28px;color:var(--text-main);margin-bottom:20px;font-weight:400;">關於中心</h2>
          <p style="font-size:16px;line-height:1.85;color:var(--text-secondary);margin-bottom:20px;">
            政策與社會研究中心關注學術知識生產與公共政策之間的交界，特別重視高等教育政策、科學與創新治理，以及數位轉型在學術和公民生活中的社會影響。
          </p>
          <p style="font-size:16px;line-height:1.85;color:var(--text-secondary);margin-bottom:20px;">
            該中心牽頭研究院關於中國第十五個五年規劃的研究，考察國家規劃框架如何塑造科學研究優先事項、大學治理和高等教育發展。中心同時牽頭青少年數位治理項目，研究青年在數位環境中的經驗、挑戰和需求。
          </p>
          <p style="font-size:16px;line-height:1.85;color:var(--text-secondary);">
            該中心的工作具有內在跨學科性，借鑑政治學、社會學、教育研究、科學技術研究和傳播研究。中心通過研究報告和政策簡報參與政策討論，並與研究院內相關領域研究人員保持密切合作。
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section" style="background:var(--bg-main);border-top:1px solid var(--border-light);">
    <div class="container">
      <div class="section-label">研究重點</div>
      <h2 class="section-title">核心研究領域</h2>
      <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:var(--border-light);border:1px solid var(--border-light);margin-top:8px;">
        {[
          { title: "高等教育政策",    desc: "研究大學治理、高等教育監管、認證體系、學術自由和機構政策框架。" },
          { title: "科學與創新政策", desc: "研究國家研究議程、科學資助、創新體系、研究優先事項設定和科學治理。" },
          { title: "五年規劃研究",     desc: "研究中國國家五年規劃框架，並分析其對研究、高等教育、技術和社會政策的影響。" },
          { title: "青少年數位治理",   desc: "研究面向青年的數位環境治理，包括平台監管、數位權利、網路安全和公民參與。" },
          { title: "開放科學政策",        desc: "研究開放科學、開放取用、研究資料管理和 FAIR 資料原則相關的國家與機構政策。" },
          { title: "學術出版政策", desc: "研究與學術出版相關的政府和機構政策，包括期刊白名單、評價框架和研究人員評價政策。" },
        ].map((item) => (
          <div class="card" style="border:none;border-radius:0;">
            <h3 style="font-family:var(--font-sans);font-size:15px;font-weight:600;color:var(--text-main);margin-bottom:10px;">{item.title}</h3>
            <p style="font-size:14px;line-height:1.7;color:var(--text-secondary);">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section" style="background:var(--bg-white);border-top:1px solid var(--border-light);">
    <div class="container">
      <div class="section-label">研究項目</div>
      <h2 class="section-title">當前項目</h2>
      <div style="margin-top:8px;">
        {[
          { status: "進行中", title: "第十五個五年規劃研究", desc: "一項系統研究中國第十五個五年規劃（2026–2030）的項目，考察其對研究優先事項、高等教育發展、科學治理和社會政策的影響。", href: "/zh-tw/projects/fifteenth-five-year-plan-studies" },
          { status: "進行中", title: "青少年數位治理研究", desc: "考察當代網路環境中青年所面臨的數位治理挑戰，包括平台監管、演算法影響、數位素養和權利框架。", href: "/zh-tw/projects/youth-digital-governance" },
        ].map((p) => (
          <div class="project-card" style="margin-bottom:1px;border-radius:0;border-bottom:1px solid var(--border-light);">
            <span class="tag tag-active" style="margin-bottom:12px;display:inline-flex;">{p.status}</span>
            <h3 class="project-title">{p.title}</h3>
            <p class="project-desc">{p.desc}</p>
            <a href={p.href} style="display:inline-flex;margin-top:16px;font-size:13.5px;color:var(--accent-steel);">查看項目 →</a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section" style="background:var(--bg-main);border-top:1px solid var(--border-light);">
    <div class="container">
      <div class="section-label">出版成果</div>
      <h2 class="section-title">中心出版成果</h2>
      <div style="margin-top:8px;">
        {[
          { type: "研究報告", title: "中國第十四個五年規劃背景下的高等教育政策趨勢：對第十五個五年規劃的啟示", year: "2026" },
          { type: "政策簡報",    title: "青年網路安全與平台問責：比較政策分析", year: "2026" },
        ].map((pub) => (
          <div class="publication-item">
            <div class="pub-type">{pub.type}</div>
            <div class="pub-title">{pub.title}</div>
            <div style="text-align:right;">
              <div style="font-family:var(--font-mono);font-size:13px;color:var(--text-muted);margin-bottom:10px;">{pub.year}</div>
              <a href="/zh-tw/publications" class="btn-ghost btn" style="font-size:13px;padding:0;">查看詳情 →</a>
            </div>
          </div>
        ))}
      </div>
      <div style="margin-top:32px;">
        <a href="/zh-tw/publications" class="btn btn-secondary">全部出版成果</a>
      </div>
    </div>
  </section>
</BaseLayout>
<style>
@media (max-width: 900px) {
  div[style*="grid-template-columns:1fr 2fr"] { display: block !important; }
  div[style*="grid-template-columns:repeat(3,1fr)"] { grid-template-columns: repeat(2,1fr) !important; }
}
@media (max-width: 600px) {
  div[style*="grid-template-columns:repeat(3,1fr)"],
  div[style*="grid-template-columns:repeat(2,1fr)"] { display: block !important; }
}
</style>
